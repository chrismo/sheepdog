#!/usr/bin/env bash5
#
# sd state - where a branch's PR stands.
#
# Usage: sd state [--json | --long] [<branch>]
#
# Reports, for <branch> (default: the current one):
#   pr        the branch's PR (an open one wins over closed/merged)
#   parent    sd-parent config, else the PR base, else the default branch;
#             whether it exists here and on the remote (a parent only here
#             has to ship first);
#             a merged parent retargets sync to the default branch
#   sync      ahead of / behind the parent? would `rebase --onto` conflict?
#   push      local vs remote branch; whether the remote SHA is ours (reflog),
#             and for a remote ahead of a reset: whether those commits were
#             made here and whether the worktree has uncommitted changes;
#             held: an agent step's unpushed change to CI config (sd act's
#             hold), {sha, paths}, else null
#   ci        checks on the PR head commit. A check that didn't start or
#             wants approval (STARTUP_FAILURE, ACTION_REQUIRED) is blocked,
#             chrismo's, not red. For a draft, also the base branch's
#             required checks (rulesets and classic protection; matched by
#             name, not app): one with no context on the head is missing,
#             and keeps the verdict pending, so undraft waits for it (#123).
#             One that never runs on a draft (a workflow skipping drafts, or
#             filtered to other branches, for a stacked draft) waits forever:
#             no timeout, since nothing here says how long it has been
#             missing; the wait step says to undraft by hand instead.
#             A non-draft doesn't need them: GitHub's merge state counts them
#   review    coverage of HEAD by refs/sheepdog/<branch>/{local,bot,accepted};
#             a pin's <kind>-base ref is the base it was taken against, so a
#             restack doesn't make a reviewed change look changed
#             review.findings: sd act review's open findings
#             (refs/sheepdog/<b>/findings), counting those that block, and
#             whether they're about HEAD (the same commit, or the same change
#             rebased)
#             review.bot also has triggered (when sd act trigger posted, by
#             GitHub's clock), replied (a bot has posted since; null with no
#             trigger time or when gh fails) and waited (seconds since)
#   flags     for chrismo, never a gate (#125): in the net diff old_base..HEAD
#             (the whole branch, whoever wrote it), added lines matching
#             settings.flags.suppressions, added skips (settings.flags.skips)
#             in test files, and each hunk of changed or deleted lines in a
#             test file the base had, or a test file renamed out of the test
#             files (test-edit); with the commit that added
#             the line (blame), or for a test-edit the commits that touched
#             the file. Test files: settings.flags.testFiles, globs on the
#             file's name, a whole path when one has a /, or a directory
#             anywhere when it ends in /. null without a base, or when the
#             check fails or can't run (an invalid pattern, an unreadable
#             diff, a tree base that isn't HEAD's ancestor); then
#             flags_error says why, kept out of errors so NEXT ignores it
#   threads   what's owed, marked ! (blocks: unresolved threads, reviews
#             requesting changes) or i (to read: bot review bodies and PR
#             comments not yet marked handled)
#   bot       the review bot's trigger comment (settings.botCommand), if any,
#             and timeout (settings.botTimeout)
#   session   pipeline enrollment, harness, session id, takeover lock
#   spend     usd: what the branch's agent steps have cost in this repo, by
#             the usage record (usage.sup, harness_usage); budget:
#             settings.branchBudget (USD, 25; 0 is none). Past it, NEXT hands
#             the agent's steps to chrismo (#121)
#   fresh     false when GitHub's PR / parent-PR head differs from the local
#             remote-tracking ref, i.e. sync and push answers need a fetch
#   stored    what sheepdog keeps for the branch: handled ids, refs/sheepdog/<b>/*
#   rate_limit  GitHub's GraphQL quota: cost (this run's calls, summed),
#             remaining and reset_at (the last call's; null when none
#             answered), limited (a call was refused for the rate limit)
#   next      what to do, in order: {key, who, say, cmd} (lib/next.sh)
#
# Output:
#   default   the one-liner (led by the PR's url, not the branch), then NEXT:
#             the first step and how many follow
#   --long    the one-liner, every step, then a line per owed item
#             (mark, type, author, excerpt, url), per open review finding
#             (r, severity, file:line, body) and per flag (⚑, kind,
#             file:line, the line, commits)
#   --json    everything
#
# Never fetches, and writes only the PR numbers it finds (branch.<b>.sd-pr,
# the parent's too), when they change. That makes it a .git/config writer:
# while it holds config.lock, another git config write fails. Remote refs
# are as fresh as the last fetch. One gh GraphQL call per PR (the branch's,
# and a non-default parent's), by its stored number; a discovery by branch
# comes first for a PR not yet known, and is the only call for a branch with
# none. A stored PR that merged stays the branch's PR, even once a newer one
# is open from the same branch: the branch is done (#122). Only a local
# branch stores a number, so a parent that isn't one, or a fresh clone, gets
# discovery's pick (an open PR first); git config --unset branch.<b>.sd-pr
# makes sd state look again. A draft adds two REST calls, for its base
# branch's required checks. A gh failure is
# recorded in .errors and the git facts are still reported.
#
# Config: read with lib/config.sh (branch file over global file over
# built-in defaults), under settings: remote (origin), botLogin (bots that
# post as users, counted as bots; a [bot] suffix is optional), botIgnore (bots
# whose posts are never owed, e.g. github-actions preview links), botIgnoreBody
# (regexes: bot reviews and PR comments whose body matches are never owed).
# Either also keeps a bot's post from counting as the review bot's reply
# after sd act trigger: any other bot's post does, so a CI or preview bot
# that comments after a push belongs in one of them. So a botIgnoreBody
# pattern must not match the review bot's own verdict (a clean "No issues
# found" included), or that verdict never ends the wait. A reply is a new
# review or comment: a bot that edits one sticky comment in place isn't seen,
# and runs into bot-silent. Nor is the commit checked: a slow reply to an earlier
# trigger that lands after a later one counts as the later one's reply.
# botTimeout (seconds, 3600): how long to wait on that reply before
# bot-silent. flags: {suppressions, skips} (RE2 regexes over a line's text)
# and testFiles (globs); a list set in a file replaces that list's default,
# and [] turns it off.
# State: branch.<name>.pr-{parent,tend,harness,session,lock}, branch.<name>.sd-pr
# (the PR's number, written here), branch.<name>.sd-handled
# (multi-valued: node ids of bot reviews/comments already dealt with),
# branch.<name>.sd-bot-triggered (when sd act trigger posted its comment).

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/config.sh"
source "$(dirname "$(realpath "$0")")/../lib/next.sh"
source "$(dirname "$(realpath "$0")")/../lib/sheepdog.sh"

# By number: GitHub multiplies each connection's cost by its parents' page
# sizes, so under pullRequests(first: 10) this cost 21 points, not 2 (#122).
read -r -d '' QUERY <<'EOF' || true
query($owner: String!, $repo: String!, $number: Int!, $commits: Boolean!) {
  viewer { login }
  rateLimit { cost remaining resetAt }
  repository(owner: $owner, name: $repo) {
    defaultBranchRef { name }
    pullRequest(number: $number) {
      number url state isDraft isCrossRepository headRepositoryOwner { login } headRefName baseRefName headRefOid mergeable mergedAt
      mergeStateStatus reviewDecision
      reviewRequests(first: 20) { nodes { requestedReviewer {
        ... on User { login } ... on Bot { login } ... on Mannequin { login } ... on Team { slug } } } }
      # GitHub takes up to 250 on a PR's commits, not the usual 100.
      allCommits: commits(last: 250) @include(if: $commits) { nodes { commit { oid } } }
      commits(last: 1) { nodes { commit { oid statusCheckRollup { state contexts(first: 100) { nodes {
        __typename
        ... on CheckRun { name status conclusion }
        ... on StatusContext { context state }
      } } } } } }
      reviewThreads(first: 100) { nodes {
        id isResolved isOutdated path line
        first: comments(first: 1) { nodes { author { __typename login } url body } }
        last: comments(last: 1) { nodes { author { __typename login } } }
      } }
      reviews(last: 50) { nodes { id url state body createdAt submittedAt author { __typename login } } }
      comments(last: 50) { nodes { id url body createdAt author { __typename login } } }
    }
  }
}
EOF

# A branch's PRs, with only what PICK_PR needs: ten, since a common branch
# name also matches strangers' fork PRs.
read -r -d '' DISCOVER <<'EOF' || true
query($owner: String!, $repo: String!, $branch: String!) {
  viewer { login }
  rateLimit { cost remaining resetAt }
  repository(owner: $owner, name: $repo) {
    defaultBranchRef { name }
    pullRequests(headRefName: $branch, first: 10, orderBy: {field: CREATED_AT, direction: DESC}) {
      nodes { number state isCrossRepository headRepositoryOwner { login } }
    }
  }
}
EOF

die() { echo "sd state: $*" >&2; exit 1; }

json=false long=false
branch=""
while (( $# )); do
  case $1 in
    --json) json=true ;;
    --long) long=true ;;
    -h|--help) sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) branch=$1 ;;
  esac
  shift
done

! $json || ! $long || die "--json and --long don't combine"
prc_super_init || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
[[ -n $branch ]] || branch=$(git branch --show-current)
[[ -n $branch ]] || die "detached HEAD; name a branch"
head=$(git rev-parse -q --verify "refs/heads/$branch^{commit}") || die "no such branch: $branch"
remote=$(prc_get settings.remote "$branch" false) || die "sd config failed"

errors=()
cfg() { git config --get "branch.$branch.$1" || true; }
ref() { git rev-parse -q --verify "$1^{commit}" || true; }
is_ancestor() { git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }
count() { git rev-list --count "$@"; }
# -U0: an upstream edit next to our lines must not read as a changed patch.
patch_id() { git diff -U0 "$1" "$2" | git patch-id --stable | cut -d' ' -f1; }
jstr() { prc_json_string "$1"; }
jnull() { if [[ -n $1 ]]; then jstr "$1"; else echo null; fi; }
jlist() { { git config --get-all "$1" || true; } | prc_strings; }
bots=$(prc_get settings.botLogin "$branch" false json) || die "sd config failed"
ignore=$(prc_get settings.botIgnore "$branch" false json) || die "sd config failed"
ignore_body=$(prc_get settings.botIgnoreBody "$branch" false json) || die "sd config failed"
bot_command=$(prc_get settings.botCommand "$branch" false) || die "sd config failed"
bot_timeout=$(prc_get settings.botTimeout "$branch" false) || die "sd config failed"
bot_triggered=$(cfg sd-bot-triggered)   # when trigger posted its comment, by GitHub's clock (#63)
review_rounds=$(prc_get settings.reviewRounds "$branch" false) || die "sd config failed"
branch_budget=$(prc_get settings.branchBudget "$branch" false json) || die "sd config failed"
spend=$(branch_spend "$branch" 2> >(sed 's/^/sd state: /' >&2)) || { spend=null; errors+=("usage: can't read $(usage_file)"); }
[[ $(prc_val "$ignore_body" 'len(coalesce([unnest this | where is_error(regexp(this, ""))], [])) == 0' 2>/dev/null) == true ]] \
  || die "botIgnoreBody has an invalid regex: $ignore_body"

# gh_call <label> <field>...: one GraphQL call into RESP, its rateLimit added
# to rl_*. A failure is recorded in errors, unless it's a number GitHub can't
# resolve (returns 2: the caller re-discovers), and a rate-limit refusal sets
# rl_limited.
RESP=""
GH_ERR=$(mktemp)
trap 'rm -f "$GH_ERR"' EXIT
rl_cost=null rl_remaining=null rl_reset="" rl_limited=false
gh_call() {
  local label=$1 cost remaining reset; shift
  if ! RESP=$(gh api graphql -F owner='{owner}' -F repo='{repo}' "$@" 2>"$GH_ERR"); then
    RESP=""
    grep -q 'Could not resolve to a PullRequest' "$GH_ERR" && return 2
    grep -Eqi 'rate.?limit' "$GH_ERR" && rl_limited=true
    errors+=("gh ($label): $(tr '\n' ' ' <"$GH_ERR")")
    return 1
  fi
  read -r cost remaining reset < <(prc_line 'values f"{coalesce(data.rateLimit.cost, 0)} {coalesce(data.rateLimit.remaining, "null")} {coalesce(data.rateLimit.resetAt, "")}"' "$RESP")
  rl_cost=$(( ${rl_cost/null/0} + cost )) rl_remaining=$remaining rl_reset=$reset
}
# headRefName also matches strangers' fork PRs from a same-named branch; keep
# same-repo PRs and PRs from the viewer's own fork.
read -r -d '' PICK_PR <<'EOF' || true
values {me: data.viewer.login, nodes: coalesce(data.repository.pullRequests.nodes, [])}
| values coalesce([unnest {me, x: nodes} | where not on(x.isCrossRepository) or on(x.headRepositoryOwner.login == me) | values x], [])
| values coalesce(coalesce([unnest this | where on(state == "OPEN")], [])[0], this[0], null)
EOF

# lookup_pr <branch> [true]: the branch's PR into PR (null for none), RESP
# holding the last answer; true also fetches its commits. By the number in
# branch.<b>.sd-pr, unless GitHub has no such PR, its head is another branch,
# or it was closed unmerged (a new one may have been opened since; a merged
# one stays, as the branch is done): then discovery picks one and stores its
# number (unset for none), for a local branch only: git branch -d removes the
# config of only those. Returns 1 when gh failed.
# -f, not -F, for the branch: -F would send "1234" or "true" as a non-string.
lookup_pr() {
  local b=$1 commits=${2:-false} n fetched="" pick rc=0 head st is_local=false
  n=$(git config --get "branch.$b.sd-pr" || true)
  git show-ref -q --verify "refs/heads/$b" && is_local=true
  PR=null
  if [[ -n $n ]]; then
    gh_call "$b" -F number="$n" -F commits="$commits" -f query="$QUERY" || rc=$?
    (( rc != 1 )) || return 1
    if (( rc == 0 )); then
      PR=$(prc_json 'values coalesce(data.repository.pullRequest, null)' "$RESP") || die "couldn't read gh's answer"
      read -r head st < <(prc_line 'values f"{coalesce(headRefName, "")} {coalesce(state, "")}"' "$PR")
      [[ $head == "$b" && $st != CLOSED ]] && return 0
      [[ $head == "$b" ]] && fetched=$n
    fi
  fi
  gh_call "$b" -f branch="$b" -f query="$DISCOVER" || return 1
  pick=$(prc_line "$PICK_PR"$'\n| values coalesce(number, "")' "$RESP") || die "couldn't read gh's answer"
  if [[ -z $pick ]]; then
    PR=null
    [[ -z $n ]] || ! $is_local || git config --unset "branch.$b.sd-pr" 2>/dev/null || true
    return 0
  fi
  # A lost race with another writer only costs a discovery next time.
  [[ $pick == "$n" ]] || ! $is_local || git config "branch.$b.sd-pr" "$pick" 2>/dev/null || true
  [[ $pick != "$fetched" ]] || return 0
  rc=0
  gh_call "$b" -F number="$pick" -F commits="$commits" -f query="$QUERY" || rc=$?
  (( rc == 0 )) || { (( rc == 1 )) || errors+=("gh ($b): GitHub has no PR #$pick, which it just listed"); return 1; }
  PR=$(prc_json 'values coalesce(data.repository.pullRequest, null)' "$RESP") || die "couldn't read gh's answer"
}

# ── O1 PR, O2 parent ─────────────────────────────────────────────────────────

pr=null viewer="" default_branch="" gh_ok=false
if lookup_pr "$branch"; then
  gh_ok=true
  pr=$PR
  { read -r viewer; read -r default_branch; } \
    < <(prc_line 'values coalesce(data.viewer.login, ""), coalesce(data.repository.defaultBranchRef.name, "")' "$RESP")
fi
if [[ -z $default_branch ]]; then
  default_branch=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)
  default_branch=${default_branch#"$remote"/}
  [[ -n $default_branch ]] || default_branch=main
fi

parent=$(cfg sd-parent) parent_source=config
if [[ -z $parent ]]; then
  if [[ $pr != null ]]; then
    parent=$(prc_val "$pr" baseRefName) parent_source=pr
  else
    parent=$default_branch parent_source=default
    # A plain git branch from another's tip records no parent (#94): flag it,
    # unless gh failed and a PR we couldn't see may name the parent.
    rc=1
    if $gh_ok; then rc=0 stacked=$(stacked_on "$branch" "$remote" "$default_branch") || rc=$?; fi
    case $rc in
      0) errors+=("stacked on ${stacked%% *} without sheepdog knowing: sd act enroll records it") ;;
      2) errors+=("stacked on ${stacked// / or } without sheepdog knowing: record one with git config branch.$branch.sd-parent <name>") ;;
      3) errors+=("$(stacked_unclear "$branch" "$stacked" "$default_branch")") ;;
    esac
  fi
fi

# parent_ok: whether the parent and its merged state are actually known.
parent_pr=null parent_ok=$gh_ok
[[ $parent_source == config ]] && parent_ok=true
if [[ $parent != "$default_branch" ]]; then
  if lookup_pr "$parent" true; then parent_pr=$PR; else parent_ok=false; fi
fi
parent_merged=null
if $parent_ok; then
  parent_merged=$(prc_val "$parent_pr" 'this is null ? false : on(state == "MERGED")')
fi
target=$parent
[[ $parent_merged == true ]] && target=$default_branch

# ── O3a restack undone (#47) ─────────────────────────────────────────────────

# After a restack, a plain git push is rejected and git's advice (pull --rebase)
# rebases the branch onto its old remote head and replays the target's commits
# as copies, orphaning the base pin. Evidence, all three: the pin isn't an
# ancestor; the remote head is (the pull put it there; a hand rewrite of the
# branch wouldn't); and commits above the remote head repeat a target commit's
# author date and subject (only those: a stacked child also carries its
# parent's commits, which aren't copies). Not seen: a squash-merged parent
# whose squash was the target's only new commit, since the pull drops the
# replayed squash as empty and leaves no copy; that case keeps the pin error.
undone=0
if u_pin=$(ref "refs/sheepdog/$branch/base") && [[ -n $u_pin ]] \
   && u_tr=$(ref "refs/remotes/$remote/$target") && [[ -n $u_tr ]] \
   && u_rs=$(ref "refs/remotes/$remote/$branch") && [[ -n $u_rs ]] && is_ancestor "$u_rs" "$head" \
   && ! is_ancestor "$u_pin" "$head" && u_mb=$(git merge-base "$u_tr" "$head" 2>/dev/null); then
  undone=$(comm -12 <(git log --format='%at %s' "$u_rs..$head" | sort -u) \
                    <(git log --format='%at %s' "$u_mb..$u_tr" | sort -u) | wc -l | tr -d ' ')
fi

# ── O3 sync vs parent ────────────────────────────────────────────────────────

# holds_parent_commits <range>: a commit in the range is one of the parent PR's.
holds_parent_commits() {
  local commits; commits=$(prc_line 'unnest coalesce(allCommits.nodes, []) | values commit.oid' "$parent_pr")
  [[ -n $commits ]] && grep -qxFf <(printf '%s\n' "$commits") <<<"$(git rev-list "$1")"
}
# parent_in_head: HEAD holds the merged parent's whole change. Merging the
# parent's net change (from where it left the target to its merged head) into
# HEAD again must change nothing; a missing part, or the branch's own edit to
# the parent's lines, changes or conflicts. Squash merges only: a head already
# in the target would make the merge a no-op whatever HEAD holds. And HEAD
# must leave the target where the parent did: from an older point, the tree
# merge from the merged head would revert what the parent picked up from the
# target; from a newer one, the change it checks would hold target commits.
parent_in_head() {
  local base tree
  [[ -n $merged_head ]] && git cat-file -e "$merged_head^{commit}" 2>/dev/null || return 1
  ! is_ancestor "$merged_head" "$target_ref" || return 1
  base=$(git merge-base "$merged_head" "$target_ref") || return 1
  [[ $(git merge-base "$head" "$target_ref") == "$base" ]] || return 1
  tree=$(git merge-tree --write-tree --merge-base="$base" "$head" "$merged_head" 2>/dev/null) || return 1
  [[ $tree == "$(git rev-parse "$head^{tree}")" ]]
}

# A stacked branch's parent can exist only here (started with --parent before
# the parent shipped). Then there's nothing to sync against yet, and NEXT's
# step is to ship the parent, not an error (#105). parent.unpushed is that
# test, the one every consumer reads: only a parent known to have no PR
# counts, since a merged or closed one whose remote branch was deleted looks
# the same here, an open one is on GitHub but not fetched, a failed gh
# lookup leaves both unknown, and one already on the default branch landed
# without a PR.
parent_local=null parent_remote=null parent_unpushed=false parent_landed=false
if [[ $parent != "$default_branch" ]]; then
  if git show-ref -q --verify "refs/heads/$parent"; then parent_local=true; else parent_local=false; fi
  if [[ -n $(ref "refs/remotes/$remote/$parent") ]]; then parent_remote=true; else parent_remote=false; fi
  if [[ $parent_local == true && $parent_remote == false && $parent_merged == false \
        && $(prc_val "$parent_pr" 'this is null') == true ]]; then
    if is_ancestor "refs/heads/$parent" "refs/remotes/$remote/$default_branch"; then parent_landed=true
    else parent_unpushed=true; fi
  fi
fi

target_ref=$(ref "refs/remotes/$remote/$target")
sync_ahead=null behind=null up_to_date=null old_base="" conflict=null by_tree=false
if [[ -z $target_ref ]]; then
  if [[ $target == "$parent" && $parent_landed == true ]]; then
    errors+=("$parent has no commits beyond $remote/$default_branch and isn't on $remote: if it landed, point sd-parent at $default_branch; else commit to it and ship it first")
  elif [[ $target != "$parent" || $parent_unpushed != true ]]; then
    errors+=("no $remote/$target ref (not fetched?)")
  fi
else
  sync_ahead=$(count "$target_ref..$head")
  behind=$(count "$head..$target_ref")
  base_pin=$(ref "refs/sheepdog/$branch/base")
  merged_head=$(prc_val "$parent_pr" 'coalesce(headRefOid, "")')
  if [[ -n $base_pin ]] && ! is_ancestor "$base_pin" "$head" && (( undone == 0 )); then
    errors+=("base pin ${base_pin:0:7} is no longer in $branch's history (rewritten outside sheepdog?)")
  fi
  if [[ -n $base_pin ]] && is_ancestor "$base_pin" "$head"; then
    old_base=$base_pin
    # A rebase or fast-forward outside sheepdog leaves the pin below the
    # default branch's commits HEAD now holds (#120).
    if [[ $target == "$default_branch" ]] && is_ancestor "$base_pin" "$target_ref"; then
      old_base=$(git merge-base "$target_ref" "$head")
    fi
  elif [[ $parent_merged == true && -n $merged_head ]] && is_ancestor "$merged_head" "$head"; then
    old_base=$merged_head
  elif [[ -n $(ref "refs/remotes/$remote/$parent") ]] \
       && old_base=$(git merge-base --fork-point "refs/remotes/$remote/$parent" "$head" 2>/dev/null); then
    :
  # No rebase --onto without an ancestor, but a tree merge from the merged
  # head (not the pin: the head is what HEAD was just shown to hold).
  elif [[ -n $base_pin && $parent_merged == true ]] && parent_in_head; then
    old_base=$merged_head by_tree=true
  # Not with the default branch once a stacked parent merged: that replays the
  # parent's commits. Nor with an open stacked parent: once it's rewritten, the
  # merge-base lies below its old commits, which a restack would replay (#97).
  elif [[ $target == "$parent" && $parent == "$default_branch" ]]; then
    old_base=$(git merge-base "$target_ref" "$head" || true)
  fi

  if is_ancestor "$target_ref" "$head"; then
    up_to_date=true conflict=false
    # A tree base is for a restack, and there's none to do.
    if [[ $by_tree == true ]]; then old_base="" by_tree=false; fi
    # Past the target, the branch's own commits, unless a merge (not a
    # rebase) kept the merged parent's.
    if [[ -z $old_base ]]; then
      if holds_parent_commits "$target_ref..$head"; then
        errors+=("no base for $branch on $parent: $branch is on $remote/$target but still has the merged parent's commits")
      else
        old_base=$target_ref
      fi
    fi
  elif [[ -z $old_base ]]; then
    up_to_date=false
    if [[ $parent != "$default_branch" && $target == "$parent" ]]; then
      # A parent closed without merging needs a new target, not a pin.
      if [[ $(prc_val "$parent_pr" 'on(state == "CLOSED")') == true ]]; then
        errors+=("no base for $branch on $parent: $parent's PR #$(prc_val "$parent_pr" number) was closed without merging; decide what $branch targets")
      elif [[ -z $base_pin ]]; then
        errors+=("no base for $branch on $parent: no base pin, and no fork-point in $remote/$parent's reflog; if $parent wasn't rewritten, pin where $branch left it: git update-ref refs/sheepdog/$branch/base \$(git merge-base $remote/$parent $branch)")
      fi
    elif [[ $target == "$parent" ]]; then
      errors+=("no merge base with $remote/$target")
    elif [[ -z $base_pin ]]; then
      errors+=("no base for $branch on $parent: no base pin, and neither the merged parent's head nor its fork-point is in $branch's history")
    fi
  else
    up_to_date=false
    rc=0
    mt_err=$(git merge-tree --write-tree --merge-base="$old_base" "$target_ref" "$head" 2>&1 >/dev/null) || rc=$?
    case $rc in
      0) conflict=false ;;
      1) conflict=true ;;
      *) errors+=("merge-tree failed ($rc): ${mt_err%%$'\n'*}") ;;
    esac
  fi
fi

# ── O4 local vs remote ───────────────────────────────────────────────────────

remote_sha=$(ref "refs/remotes/$remote/$branch")
remote_ours=null diverged=false push_behind=0 theirs=null
if [[ -z $remote_sha ]]; then
  ahead=$(count "$head" --not --remotes="$remote")
else
  ahead=$(count "$remote_sha..$head")
  push_behind=$(count "$head..$remote_sha")
  (( ahead > 0 && push_behind > 0 )) && diverged=true
  reflog=$(git reflog show --format=%H "refs/heads/$branch" 2>/dev/null) || reflog=
  if grep -qx "$remote_sha" <<<"$reflog"; then
    remote_ours=true
  else
    remote_ours=false
    theirs=$(commits_not_ours "$reflog" "$remote_sha")
  fi
fi
# The remote ahead of a branch that once had its commits: made here and reset
# away (a drop, once the worktree is clean), or taken from someone and reset
# away (to take back). remote_made and dirty are only computed for that state
# (null otherwise; dirty is null too when the branch is checked out nowhere
# or git status fails) (#86).
remote_made=null dirty=null
if [[ $remote_ours == true && $ahead -eq 0 && $push_behind -gt 0 ]]; then
  if made_here "$head..$remote_sha"; then remote_made=true; else remote_made=false; fi
  wt=$(worktree_for "$branch")
  if [[ -n $wt ]] && st=$(git -C "$wt" --no-optional-locks status --porcelain 2>/dev/null); then
    if [[ -n $st ]]; then dirty=true; else dirty=false; fi
  fi
fi
# An agent step's commit that changed CI config (sd act's branch.<b>.sd-held:
# the commit, then the paths): held until chrismo runs sd act push, or until
# the commit is on the remote some other way (#124).
held=null
held_v=$(cfg sd-held)
if [[ -n $held_v ]] && ! { [[ -n $remote_sha ]] && is_ancestor "${held_v%%$'\n'*}" "$remote_sha"; }; then
  held=$(printf '{"sha": %s, "paths": %s}' "$(jstr "${held_v%%$'\n'*}")" "$(sed 1d <<<"$held_v" | prc_strings)")
fi

# ── freshness ────────────────────────────────────────────────────────────────

stale=()
stale_check() { # stale_check <pr-json> <name>
  local gh_sha; gh_sha=$(prc_line 'where on(state == "OPEN") | values headRefOid' "$1")
  if [[ -n $gh_sha && $gh_sha != "$(ref "refs/remotes/$remote/$2")" ]]; then
    stale+=("$remote/$2 is not at GitHub's ${gh_sha:0:7}")
  fi
}
[[ $pr != null ]] && stale_check "$pr" "$branch"
[[ $parent_pr != null ]] && stale_check "$parent_pr" "$parent"
stale_json='[]'
(( ${#stale[@]} )) && stale_json=$(printf '%s\n' "${stale[@]}" | prc_strings)

# ── O6 review pins ───────────────────────────────────────────────────────────

pin_status() {
  local pin; pin=$(ref "refs/sheepdog/$branch/$1")
  if [[ -z $pin ]]; then
    echo '{"sha": null, "status": "none"}'
  elif [[ $pin == "$head" ]]; then
    printf '{"sha": "%s", "status": "covered"}\n' "$pin"
  elif is_ancestor "$pin" "$head"; then
    printf '{"sha": "%s", "status": "uncovered", "uncovered": %s}\n' "$pin" "$(count "$pin..$head")"
  else
    local against=${target_ref:-$head} status=unknown pin_base head_base
    pin_base=$(ref "refs/sheepdog/$branch/$1-base") head_base=$old_base
    # The merge-base only when not stacked, as in O3: with a stacked parent,
    # open or merged, it can lie below the parent's commits (#97).
    if [[ $target == "$parent" && $parent == "$default_branch" ]]; then
      [[ -n $pin_base ]] || pin_base=$(git merge-base "$pin" "$against" || true)
      [[ -n $head_base ]] || head_base=$(git merge-base "$head" "$against" || true)
    fi
    if [[ -n $pin_base && -n $head_base ]]; then
      status=rewritten-changed
      [[ $(patch_id "$pin_base" "$pin") == "$(patch_id "$head_base" "$head")" ]] && status=rewritten-same
    fi
    printf '{"sha": "%s", "status": "%s"}\n' "$pin" "$status"
  fi
}

# sd act review's record of findings that blocked (refs/sheepdog/<b>/findings).
r_findings=$(git cat-file blob "refs/sheepdog/$branch/findings" 2>/dev/null \
               | prc_json 'where kind(this) == "record" and is(head, <string>) and is(round, <int64>)
                   and kind(findings) == "array"' 2>/dev/null) || true
if git rev-parse -q --verify "refs/sheepdog/$branch/findings" >/dev/null && [[ -z $r_findings ]]; then
  errors+=("review findings: refs/sheepdog/$branch/findings isn't a findings record")
fi
[[ -n $r_findings ]] || r_findings=null
# Whether the record is about HEAD: the same commit, or the same change rebased
# (base..head's patch-id unchanged, as the pins compare it).
r_findings_at_head=false
if [[ $r_findings != null ]]; then
  f_head=$(prc_val "$r_findings" head) f_base=$(prc_val "$r_findings" 'coalesce(base, "")')
  if [[ $f_head == "$head" ]]; then
    r_findings_at_head=true
  elif [[ -n $f_base && -n ${old_base:-} ]] && git cat-file -e "$f_head^{commit}" 2>/dev/null \
       && git cat-file -e "$f_base^{commit}" 2>/dev/null; then
    f_patch=$(patch_id "$f_base" "$f_head" || true)
    [[ -n $f_patch && $f_patch == "$(patch_id "$old_base" "$head" || true)" ]] && r_findings_at_head=true
  fi
fi

declare -A review
for p in local bot accepted; do
  review[$p]=$(pin_status "$p" || true)
  if [[ -z ${review[$p]} ]]; then
    review[$p]=null
    errors+=("review pin $p: could not evaluate")
  fi
done

# ── O5 required checks (#123) ────────────────────────────────────────────────

# A draft's base branch's required checks, sorted: rulesets, plus classic
# protection as the branch shows it (branches/<b>/protection itself wants
# admin rights). Anything else answered, such as no rules, counts as none, and
# so does a 404 or 403 (a GHES without rulesets, a token that can't see them),
# unless it's a rate limit. Any other failure leaves required null, which
# keeps a draft from undrafting.
read -r -d '' REQUIRED <<'EOF' || true
values {rules: kind(rules) == "array" ? rules : [], branch}
| values [
    ...coalesce([unnest rules | where on(type == "required_status_checks")
                 | unnest coalesce(parameters.required_status_checks, []) | values context], []),
    ...coalesce(branch.protection.required_status_checks.contexts, []),
    ...coalesce([unnest coalesce(branch.protection.required_status_checks.checks, []) | values context], [])]
| values coalesce([unnest this | sort this | uniq], [])
EOF
rest_rules() { # rest_rules <path>: gh api's answer, null for a 404 or 403
  local out
  if out=$(gh api "$1" 2>"$GH_ERR"); then
    printf '%s\n' "$out"
  elif grep -q 'HTTP 40[34]' "$GH_ERR" && ! grep -Eqi 'rate.?limit' "$GH_ERR"; then
    echo null
  else
    return 1
  fi
}
required=null
if [[ $pr != null && $(prc_val "$pr" 'on(state == "OPEN") and on(isDraft)') == true ]]; then
  r_base=$(prc_val "$pr" baseRefName)
  if r_rules=$(rest_rules "repos/{owner}/{repo}/rules/branches/$r_base?per_page=100") \
     && r_branch=$(rest_rules "repos/{owner}/{repo}/branches/$r_base"); then
    required=$(prc_json "$REQUIRED" "{\"rules\": $r_rules, \"branch\": $r_branch}" 2>"$GH_ERR") && [[ -n $required ]] \
      || required=null
  fi
  [[ $required != null ]] || errors+=("gh (required checks on $r_base): $(tr '\n' ' ' <"$GH_ERR")")
fi

# ── flags: what chrismo should see in base..HEAD (#125) ──────────────────────

# Lines of the net diff (from git_diff_lines below), tab-separated:
# +, line, 1, test (1|0), file, file, text: an added line;
# -, first line, lines removed, 1, old file, new file, first removed line: a
# hunk of a test file. Out: the same with the kind (suppression, skip,
# test-edit) first. A skip counts only in a test file.
read -r -d '' FLAGS <<'EOF' || true
fn hit(t, res): len(coalesce([unnest {t, re: res} | where len(regexp(re, t)) > 0], [])) > 0
unnest {p: flags, f: coalesce([unnest l | values split(this, "\t")], [])}
| values {f, t: sj(f[6:], "\t"),
          k: f[0] == "-" ? "test-edit"
             : f[3] == "1" and hit(sj(f[6:], "\t"), p.skips) ? "skip"
             : hit(sj(f[6:], "\t"), p.suppressions) ? "suppression" : ""}
| where k != ""
| values f"{k}\t{f[1]}\t{f[2]}\t{f[4]}\t{f[5]}\t{t}"
EOF

# is_test <path> <globs...>: a glob ending in / is a directory anywhere in the
# path; one with a / matches the whole path; any other the file's name.
is_test() {
  local p=$1 g; shift
  for g; do
    if [[ $g == */ ]]; then [[ /$p == *"/$g"* ]] && return 0
    elif [[ $g == */* ]]; then [[ $p == $g ]] && return 0
    else [[ ${p##*/} == $g ]] && return 0
    fi
  done
  return 1
}

# git_diff_lines <base> <head> <tests>: FLAGS's input. -U0, so a hunk is only
# changed lines; a removed line is always one the base had.
git_diff_lines() {
  git -c core.quotePath=false diff -M -U0 --no-color --no-ext-diff --no-textconv \
      --src-prefix=a/ --dst-prefix=b/ "$1" "$2" \
    | SD_TESTS=$3 awk '
      BEGIN { n = split(ENVIRON["SD_TESTS"], a, "\n"); for (i = 1; i <= n; i++) t[a[i]] = 1 }
      ro > 0 || rn > 0 {
        c = substr($0, 1, 1)
        if (c == "-" && ro > 0) {
          if (first && (old in t)) print "-\t" ol "\t" cnt "\t1\t" old "\t" new "\t" substr($0, 2)
          first = 0; ro--
        } else if (c == "+" && rn > 0) {
          print "+\t" nl "\t1\t" ((new in t) ? 1 : 0) "\t" new "\t" new "\t" substr($0, 2); nl++; rn--
        }
        next
      }
      /^diff --git / { old = ""; new = ""; next }
      /^--- / { old = substr($0, 5); sub(/^a\//, "", old); sub(/\t$/, "", old); next }
      /^\+\+\+ / { new = substr($0, 5); sub(/^b\//, "", new); sub(/\t$/, "", new); next }
      /^@@ / {
        k = split(substr($2, 2), o, ","); ol = o[1] + 0; ro = k > 1 ? o[2] + 0 : 1
        k = split(substr($3, 2), w, ","); nl = w[1] + 0; rn = k > 1 ? w[2] + 0 : 1
        cnt = ro; first = 1
      }'
}

# json_shas: the SHAs on stdin as a JSON list (hex needs no escaping, so no
# super call).
json_shas() { local s out=""; while read -r s; do [[ -n $s ]] && out+=${out:+,}\"$s\"; done; echo "[$out]"; }

# flags_json <base> <head> <flags-config>: a JSON list of {kind, file, line,
# n, text, commits}: commits is the one that added the line (blame), or for a
# test-edit every commit in base..head that touched the file. 1 with a message
# on an invalid pattern or a failed step. sd state runs it on every call (sd
# watch's too), so git runs once per file with hits, not once per hit.
flags_json() {
  local base=$1 hd=$2 cfg=$3 tests="" st a b p g changed moved lines hits kind line n file new text cj out="" f ln sha
  local -a globs paths
  local -A touched ranges blamed
  [[ $(prc_val "$cfg" 'len(coalesce([unnest [...suppressions, ...skips] | where is_error(regexp(this, ""))], [])) == 0' 2>/dev/null) == true ]] \
    || { echo "settings.flags has an invalid regex: $cfg"; return 1; }
  # Captured first: a failure inside < <( ) would go unseen.
  g=$(prc_line 'unnest testFiles' "$cfg") || { echo "couldn't read settings.flags.testFiles"; return 1; }
  [[ -z $g ]] || mapfile -t globs <<<"$g"
  changed=$(git -c core.quotePath=false diff -M --name-status "$base" "$hd") \
    || { echo "couldn't list the files ${base:0:7}..${hd:0:7} changes"; return 1; }
  # A test file renamed to a path that isn't one stops running, and with no
  # change (100% similar) the diff has no hunk to show it: one test-edit
  # record for the whole file, as git_diff_lines writes them.
  moved=""
  while IFS=$'\t' read -r st a b; do
    [[ -n $a ]] || continue
    for p in "$a" ${b:+"$b"}; do is_test "$p" "${globs[@]}" && tests+=$p$'\n'; done
    if [[ $st == R* ]] && is_test "$a" "${globs[@]}" && ! is_test "$b" "${globs[@]}"; then
      n=$(git cat-file blob "$base:$a" | wc -l | tr -d ' ') || n=0
      moved+="-"$'\t'1$'\t'$n$'\t'1$'\t'$a$'\t'$b$'\t'"moved to $b, out of the test files"$'\n'
    fi
  done <<<"$changed"
  lines=$({ git_diff_lines "$base" "$hd" "$tests" && printf '%s' "$moved"; } | prc_strings) \
    || { echo "couldn't read the diff"; return 1; }
  hits=$(prc_line "$FLAGS" "{\"flags\": $cfg, \"l\": $lines}") || { echo "couldn't match the diff"; return 1; }
  # One blame per file, every hit's line at once; its porcelain headers are
  # "<sha> <orig-line> <final-line> [<count>]".
  while IFS=$'\t' read -r kind line n file new text; do
    [[ -n $kind && $kind != test-edit ]] && ranges[$file]+="$line"$'\n'
  done <<<"$hits"
  for f in "${!ranges[@]}"; do
    paths=()
    while read -r ln; do [[ -n $ln ]] && paths+=(-L "$ln,$ln"); done <<<"${ranges[$f]}"
    while read -r ln sha; do blamed[$f$'\t'$ln]=$sha; done \
      < <(git blame --porcelain "${paths[@]}" "$hd" -- "$f" 2>/dev/null \
            | awk 'length($1) == 40 && $1 ~ /^[0-9a-f]+$/ && $3 ~ /^[0-9]+$/ { print $3, $1 }')
  done
  while IFS=$'\t' read -r kind line n file new text; do
    [[ -n $kind ]] || continue
    if [[ $kind == test-edit ]]; then
      if [[ -z ${touched[$file]+x} ]]; then
        paths=("$file")
        [[ $new == /dev/null || $new == "$file" ]] || paths+=("$new")
        touched[$file]=$(git log --format=%H "$base..$hd" -- "${paths[@]}") \
          || { echo "couldn't list the commits that touched $file"; return 1; }
        touched[$file]=$(json_shas <<<"${touched[$file]}")
      fi
      cj=${touched[$file]}
    else
      cj=$(json_shas <<<"${blamed[$file$'\t'$line]:-}")
    fi
    text=${text//$'\t'/ } text=${text//[[:cntrl:]]/}
    out+=${out:+,}$(printf '{"kind": "%s", "file": %s, "line": %s, "n": %s, "text": %s, "commits": %s}' \
      "$kind" "$(jstr "$file")" "$line" "$n" "$(jstr "${text:0:200}")" "$cj")
  done <<<"$hits"
  echo "[$out]"
}

# A failed check is flags_error, not an error: errors steer NEXT, and flags
# are never a gate.
flags=null flags_error=""
if [[ -n ${old_base:-} ]]; then
  flag_cfg=$(prc_get settings.flags "$branch" false json) || die "sd config failed"
  # A tree base (sync.by_tree) isn't HEAD's ancestor: diffing against it
  # would show the parent's later lines as the branch's.
  if ! is_ancestor "$old_base" "$head"; then
    flags_error="the base ${old_base:0:7} isn't in $branch's history (a tree restack is due); no check until the restack"
  else
    flags=$(flags_json "$old_base" "$head" "$flag_cfg") || { flags_error=${flags:-the check failed} flags=null; }
  fi
fi

# ── assemble ─────────────────────────────────────────────────────────────────

# Over the facts gathered above, as one record (see `args` below).
read -r -d '' ASSEMBLE <<'EOF' || true
fn unbot(s): regexp_replace(s, "\\[bot\\]$", "")
fn nn(s): s == "" ? null : s
fn login(a): unbot(coalesce(a.login, ""))
fn is_bot(a, bots): on(a.__typename == "Bot") or (login(a) != "" and login(a) in bots)
fn ignored(a, ign): login(a) in ign
-- First line with text, HTML comments, tags and heading / quote markers removed.
fn excerpt(b): coalesce(coalesce([
    unnest split(regexp_replace(coalesce(b, ""), "(?s)<!--.*?-->", ""), "\n")
    | values regexp_replace(regexp_replace(regexp_replace(this, "<[^>]*>", ""), "^[#>\\s]+", ""), "\\s+$", "")
    | where this != ""
  ], [])[0], "")[0:100]
fn detail(x): {author: coalesce(x.author.login, null), url: coalesce(x.url, null), excerpt: excerpt(coalesce(x.body, null))}
fn ci_k(v): v in ["pending", "PENDING", "EXPECTED"] ? "pending"
            : v in ["SUCCESS", "NEUTRAL", "SKIPPED"] ? "ok"
            : v in ["CANCELLED", "STALE"] ? "cancelled"
            : v in ["STARTUP_FAILURE", "ACTION_REQUIRED"] ? "blocked" : "fail"
fn ci_class(x): ci_k(coalesce(x.__typename == "CheckRun" ? (x.status != "COMPLETED" ? "pending" : x.conclusion) : x.state, ""))
fn cnt(a, t): len(coalesce([unnest {t, x: a} | where x.type == t], []))
fn matches(b, res): len(coalesce([unnest {b, re: res} | where len(regexp(re, b)) > 0], [])) > 0
-- The bot pin, plus whether the bot has said anything since trigger posted
-- its comment (br: the ids of its reviews and comments posted after that,
-- by GitHub's clock on both sides: a review's submittedAt, as its createdAt
-- is when it was started; minus botIgnoreBody placeholders; a blank body
-- counts, as a review of only inline comments has one) and how long that has
-- been, up to s.now (passed in: now() would make the output differ between
-- runs). null when there is no pin or no trigger time (a pin from before
-- #63, or by hand), or gh failed. Any bot not ignored counts (see Config in
-- the header).
fn bot_pin(s, br): nul(s.r_bot) ? null : {...s.r_bot,
    triggered: s.bot_triggered,
    replied: on(s.r_bot.status == "none") or s.bot_triggered is null or not s.gh_ok ? null : len(br) > 0,
    waited: on(s.r_bot.status == "none") or s.bot_triggered is null or not s.gh_ok ? null
            : cast(s.now::time - s.bot_triggered::time, <int64>) / 1000000000}
values {a: this, c: coalesce(pr.commits.nodes[0].commit, null),
        g: {viewer, bots: coalesce([unnest bots | values unbot(this)], []),
            ign: coalesce([unnest ignore | values unbot(this)], []), ignore_body, handled}}
| values {a, c, g,
    br: coalesce([
      unnest {g: {...g, t: coalesce(a.bot_triggered, "~")},
              x: [...coalesce(a.pr.reviews.nodes, []), ...coalesce(a.pr.comments.nodes, [])]}
      -- posted strictly after the trigger, which keeps out the trigger comment
      -- itself when the viewer is a Bot account
      | where is_bot(coalesce(x.author, {}), g.bots) and not ignored(coalesce(x.author, {}), g.ign)
            and coalesce(x.submittedAt, x.createdAt, "") > g.t and not matches(coalesce(x.body, ""), g.ignore_body)
      | values x.id
    ], []),
    ctx: coalesce([
      unnest coalesce(c.statusCheckRollup.contexts.nodes, [])
      | values {name: coalesce(name, context, null), k: ci_class(this)}
    ], []),
    hv: coalesce([
      unnest {g, r: coalesce(a.pr.reviews.nodes, [])}
      | where not (is_bot(coalesce(r.author, {}), g.bots) or ignored(coalesce(r.author, {}), g.ign))
            and coalesce(r.state, "") in ["APPROVED", "CHANGES_REQUESTED", "DISMISSED"]
      | values r
      | count {r: this, j}
    ], [])}
| values {a, c, ctx, br,
    -- required checks with no context on the head
    mi: coalesce([unnest {ctx, x: coalesce(a.required, [])} | where not (x in coalesce([unnest ctx | values name], [])) | values x], []),
    owed: [
    ...coalesce([
      unnest {g, t: coalesce(a.pr.reviewThreads.nodes, [])}
      | where not on(t.isResolved) and coalesce(t.last.nodes[0].author.login, "") != g.viewer
            and not ignored(coalesce(t.first.nodes[0].author, {}), g.ign)
      | values {id: t.id, type: "thread", path: t.path, line: t.line, outdated: t.isOutdated,
                kind: is_bot(coalesce(t.first.nodes[0].author, {}), g.bots) ? "bot" : "human",
                last: coalesce(t.last.nodes[0].author.login, null), mark: "!",
                ...detail(coalesce(t.first.nodes[0], {}))}
    ], []),
    ...coalesce([
      unnest {g, x: [...coalesce([unnest coalesce(a.pr.reviews.nodes, []) | values {n: this, type: "review"}], []),
                     ...coalesce([unnest coalesce(a.pr.comments.nodes, []) | values {n: this, type: "comment"}], [])]}
      | where is_bot(coalesce(x.n.author, {}), g.bots) and not ignored(coalesce(x.n.author, {}), g.ign)
            and grep("\\S", coalesce(x.n.body, "")) and not matches(coalesce(x.n.body, ""), g.ignore_body)
            and not (x.n.id in g.handled)
      | values {id: x.n.id, type: x.type, path: null, line: null, outdated: null, kind: "bot",
                last: coalesce(x.n.author.login, null), mark: on(x.n.state == "CHANGES_REQUESTED") ? "!" : "i",
                ...detail(x.n)}
    ], []),
    -- A reviewer verdict is their latest approving, requesting or dismissed review.
    ...coalesce([
      unnest {all: hv, e: hv}
      | where on(e.r.state == "CHANGES_REQUESTED")
            and len(coalesce([unnest {e, x: all} | where x.j > e.j and coalesce(x.r.author.login, "") == coalesce(e.r.author.login, "")], [])) == 0
      | sort coalesce(e.r.author.login, "")
      | values {id: e.r.id, type: "review", path: null, line: null, outdated: null, kind: "human",
                last: coalesce(e.r.author.login, null), mark: "!", ...detail(e.r)}
    ], [])]}
| values {s: a, c, ctx, br, mi, owed, ob: coalesce([unnest owed | where kind == "bot"], [])}
| values {
    branch: s.branch, head: s.head,
    pr: nul(s.pr) ? null : {number: s.pr.number, url: s.pr.url, state: s.pr.state, draft: s.pr.isDraft,
                            base: s.pr.baseRefName, head_sha: s.pr.headRefOid, mergeable: s.pr.mergeable,
                            merge_state: s.pr.mergeStateStatus, review_decision: s.pr.reviewDecision,
                            review_requests: coalesce([
                              unnest coalesce(s.pr.reviewRequests.nodes, [])
                              | values coalesce(requestedReviewer.login, requestedReviewer.slug, null)
                              | where this is not null
                            ], [])},
    parent: {name: s.parent, source: s.parent_source, merged: s.parent_merged, local: s.parent_local, on_remote: s.parent_remote, unpushed: s.parent_unpushed,
             pr: nul(s.parent_pr) ? null : {number: s.parent_pr.number, state: s.parent_pr.state, head_sha: s.parent_pr.headRefOid,
                                       commits: coalesce([unnest coalesce(s.parent_pr.allCommits.nodes, []) | values commit.oid], [])}},
    sync: {target: s.target, default: s.default_branch, ahead: s.sync_ahead, behind: s.behind, up_to_date: s.up_to_date,
           old_base: s.old_base, by_tree: s.by_tree, conflict: s.conflict, undone: s.undone},
    push: {remote_sha: s.remote_sha, ahead: s.ahead, behind: s.push_behind, diverged: s.diverged, remote_ours: s.remote_ours, theirs: s.theirs,
           remote_made: s.remote_made, dirty: s.dirty, held: s.held},
    fresh: s.gh_ok and s.parent_ok ? len(s.stale) == 0 : null, stale: s.stale,
    ci: {sha: coalesce(c.oid, null), for_head: nul(c) ? null : c.oid == s.head,
         verdict: len(ctx) == 0 and len(mi) == 0 ? "none"
                  : len(coalesce([unnest ctx | where k == "fail"], [])) > 0 ? "red"
                  : len(coalesce([unnest ctx | where k == "blocked"], [])) > 0 ? "blocked"
                  : len(coalesce([unnest ctx | where k == "pending"], [])) > 0 or len(mi) > 0 ? "pending"
                  : len(coalesce([unnest ctx | where k == "cancelled"], [])) > 0 ? "inconclusive" : "green",
         failing: coalesce([unnest ctx | where k == "fail" | values name], []),
         blocked: coalesce([unnest ctx | where k == "blocked" | values name], []),
         pending: coalesce([unnest ctx | where k == "pending" | values name], []),
         required: s.required, missing: mi},
    review: {local: s.r_local, bot: bot_pin(s, br), accepted: s.r_accepted,
             findings: nul(s.r_findings) ? null
               : {sha: s.r_findings.head, round: s.r_findings.round,
                  n: len(coalesce([unnest s.r_findings.findings | where coalesce(severity, "") != "nit"], [])),
                  at_head: s.r_findings_at_head,
                  declined: len(coalesce([unnest s.r_findings.findings | where coalesce(severity, "") != "nit"], [])) > 0
                            and len(coalesce([unnest s.r_findings.findings
                                              | where coalesce(severity, "") != "nit" and coalesce(action, "") != "declined"], [])) == 0,
                  cap: s.review_rounds, items: s.r_findings.findings}},
    flags: s.flags, flags_error: nn(s.flags_error),
    threads: {owed_bot: s.gh_ok ? len(ob) : null,
              owed_human: s.gh_ok ? len(coalesce([unnest owed | where kind == "human"], [])) : null,
              outdated: s.gh_ok ? len(coalesce([unnest owed | where on(outdated)], [])) : null,
              by_type: s.gh_ok ? {thread: cnt(ob, "thread"), review: cnt(ob, "review"), comment: cnt(ob, "comment")} : null,
              blocking: s.gh_ok ? len(coalesce([unnest owed | where mark == "!"], [])) : null,
              info: s.gh_ok ? len(coalesce([unnest owed | where mark == "i"], [])) : null,
              items: owed},
    bot: {command: nn(s.bot_command), timeout: s.bot_timeout},
    session: {enrolled: s.enrolled == "true", harness: nn(s.harness), id: nn(s.session), locked: s.lock != ""},
    spend: {usd: s.spend, budget: s.branch_budget},
    stored: {handled: s.handled,
             refs: unflatten(coalesce([
               unnest {p: f"refs/sheepdog/{s.branch}/", r: s.refs}
               | values {key: [split(r, " ")[0][len(p):]], value: split(r, " ")[1]}
             ], []))},
    rate_limit: {cost: s.rl_cost, remaining: s.rl_remaining, reset_at: s.rl_reset, limited: s.rl_limited},
    errors: s.errors
  }
EOF

errors_json='[]'
(( ${#errors[@]} == 0 )) || errors_json=$(printf '%s\n' "${errors[@]}" | prc_strings)
refs_json=$(git for-each-ref --format='%(refname) %(objectname)' "refs/sheepdog/$branch/" | prc_strings)
args=$(printf '{"branch": %s, "head": %s, "pr": %s, "parent": %s, "parent_source": %s, "parent_pr": %s, "parent_merged": %s, "parent_local": %s, "parent_remote": %s, "parent_unpushed": %s,
  "target": %s, "default_branch": %s, "sync_ahead": %s, "behind": %s, "up_to_date": %s, "old_base": %s, "by_tree": %s, "conflict": %s, "undone": %s,
  "remote_sha": %s, "ahead": %s, "push_behind": %s, "diverged": %s, "remote_ours": %s, "theirs": %s, "remote_made": %s, "dirty": %s, "held": %s, "stale": %s,
  "r_local": %s, "r_bot": %s, "r_accepted": %s, "r_findings": %s, "r_findings_at_head": %s, "review_rounds": %s, "flags": %s, "flags_error": %s, "gh_ok": %s, "parent_ok": %s, "viewer": %s, "bots": %s, "bot_command": %s, "bot_triggered": %s, "bot_timeout": %s, "now": %s,
  "required": %s, "ignore": %s, "ignore_body": %s, "handled": %s, "refs": %s, "enrolled": %s, "harness": %s, "session": %s, "lock": %s,
  "rl_cost": %s, "rl_remaining": %s, "rl_reset": %s, "rl_limited": %s, "spend": %s, "branch_budget": %s, "errors": %s}\n' \
  "$(jstr "$branch")" "$(jstr "$head")" "$pr" "$(jstr "$parent")" "$(jstr "$parent_source")" "$parent_pr" "$parent_merged" "$parent_local" "$parent_remote" "$parent_unpushed" \
  "$(jstr "$target")" "$(jstr "$default_branch")" "$sync_ahead" "$behind" "$up_to_date" "$(jnull "$old_base")" "$by_tree" "$conflict" "$undone" \
  "$(jnull "$remote_sha")" "$ahead" "$push_behind" "$diverged" "$remote_ours" "$theirs" "$remote_made" "$dirty" "$held" "$stale_json" \
  "${review[local]}" "${review[bot]}" "${review[accepted]}" "$r_findings" "$r_findings_at_head" "$review_rounds" "$flags" "$(jstr "$flags_error")" "$gh_ok" "$parent_ok" "$(jstr "$viewer")" "$bots" "$(jstr "$bot_command")" "$(jnull "$bot_triggered")" "$bot_timeout" "$(jstr "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" \
  "$required" "$ignore" "$ignore_body" "$(jlist "branch.$branch.sd-handled")" "$refs_json" \
  "$(jstr "$(cfg sheepdog)")" "$(jstr "$(cfg sd-harness)")" "$(jstr "$(cfg sd-session)")" "$(jstr "$(cfg sd-lock)")" \
  "$rl_cost" "$rl_remaining" "$(jnull "$rl_reset")" "$rl_limited" "$spend" "$branch_budget" "$errors_json")
state=$(prc_json "$ASSEMBLE" "$args") || die "couldn't assemble the state"
next=$(printf '%s\n' "$state" | prn_next "$remote") || die "lib/next.sh failed"
state=$(prc_json 'values {...s, next}' "{\"s\": $state, \"next\": $next}") || die "lib/next.sh failed"

if $json; then
  echo "$state"
  exit 0
fi

read -r -d '' LINE <<'EOF' || true
fn pin(k, p): nul(p) or on(p.status == "none") ? null
              : f"{k} {p.status in ["covered", "rewritten-same"] ? (on(p.replied == false) ? "⏳" : "✓") : p.status == "uncovered" ? f"+{p.uncovered}"
                      : p.status == "rewritten-changed" ? "✗" : "?"}"
values [
  nul(pr) ? "no PR" : f"{pr.url} {on(pr.draft) ? "draft" : lower(pr.state)}",
  on(parent.merged) ? f"parent merged → {sync.target}" : null,
  on(sync.up_to_date == false) ? f"↓{sync.behind} {sync.target}{on(sync.conflict) ? " (conflict)" : ""}" : null,
  nul(push.remote_sha) ? (n(push.ahead) > 0 ? f"{push.ahead} unpushed" : "not pushed")
  : on(push.diverged) ? f"diverged from remote{on(push.remote_ours) ? "" : " (not ours)"}"
  : n(push.ahead) > 0 ? f"{push.ahead} unpushed" : null,
  not nul(push.remote_sha) and not on(push.diverged) and n(push.behind) > 0
    ? f"remote +{push.behind}{on(push.remote_ours) ? " (reset away here)" : ""}" : null,
  nul(pr) ? null : f"CI {ci.verdict}{len(ci.failing) > 0 ? f" ({sj(ci.failing, ", ")})" : ""}{on(ci.for_head == false) ? " on old head" : ""}",
  nul(pr) or nul(threads.blocking) ? null : f"!:{threads.blocking} i:{threads.info}",
  pin("local", review.local), pin("bot", review.bot), pin("accepted", review.accepted),
  nul(review.findings) ? null
    : f"review: {review.findings.n} finding{review.findings.n == 1 ? "" : "s"} (round {review.findings.round}/{review.findings.cap}{on(review.findings.declined) ? ", declined" : ""}){review.findings.at_head ? "" : " on old head"}",
  len(coalesce(flags, [])) > 0 ? f"⚑ {len(flags)} flagged" : nul(flags_error) ? null : "⚑ check failed",
  on(session.locked) ? "locked" : null,
  on(fresh == false) ? "⚠ stale: fetch" : null,
  len(errors) > 0 ? f"⚠ {len(errors)} error(s)" : null
]
| values sj(coalesce([unnest this | where this is not null], []), " · ")
EOF

read -r -d '' LONG <<'EOF' || true
fn sp(k): k <= 0 ? "" : "                                                                                                                                                                                                        "[0:k]
fn pad(s, w): s || sp(w - len(s))
values {it: coalesce([
    unnest threads.items
    | values {mark, type: this.type, author: coalesce(author, last, ""),
              text: sj(coalesce([unnest [nul(path) ? "" : f"{path}:{line}", coalesce(excerpt, "")] | where this != ""], []), "  "),
              url: coalesce(url, "")}
  ], [])}
| values {it, tw: coalesce([unnest it | values len(this.type) | sort -this][0], 0),
              aw: coalesce([unnest it | values len(author) | sort -this][0], 0),
              xw: coalesce([unnest it | values len(text) | sort -this][0], 0)}
| unnest {w: {tw, aw, xw}, x: it}
| values regexp_replace(f"  {x.mark}  {pad(x.type, w.tw)}  {pad(x.author, w.aw)}  {pad(x.text, w.xw)}  {x.url}", "\\s+$", "")
EOF


prc_line "$LINE" "$state"
printf '%s\n' "$next" | prn_lines "$($long && echo all || echo one)"

$long || exit 0
prc_line "$LONG" "$state"
# The local review's open findings, if any (sd act review's record), each
# with the agent's answer once it gave one.
prc_line 'where not nul(review.findings) | unnest review.findings.items
  | values f"  r  {coalesce(severity, "?")}  {coalesce(file, "?")}:{coalesce(line, "?")}  {coalesce(body, "")}",
           coalesce(action, null) is null ? null : f"       {action}: {coalesce(reply, "")}"
  | where this is not null' "$state"
flag_lines "$state"
prc_line 'where not nul(flags_error) | values f"  ⚑  check failed: {flags_error}"' "$state"
