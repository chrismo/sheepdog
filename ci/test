#!/usr/bin/env bash5
# Captain reads a test's file only from a file= attribute, which bats doesn't
# write; without it, same-named tests in different files collide.
set -uo pipefail

cd "$(dirname "$0")/.."
out=${SHEEPDOG_TEST_RESULTS:-test-results}
mkdir -p "$out"
shopt -s nullglob  # a glob with no suites left drops out, not a missing file to bats
(( $# )) || set -- bin/*.bats ci/*.bats *.bats

bats --jobs "$(getconf _NPROCESSORS_ONLN)" --report-formatter junit --output "$out" "$@"
status=$?

report="$out/report.xml"
if [[ -f $report ]]; then
  sed 's/<testsuite name="\([^"]*\)"/<testsuite name="\1" file="\1"/' "$report" > "$report.tmp" \
    && mv "$report.tmp" "$report"
fi
exit "$status"
