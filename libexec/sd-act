#!/usr/bin/env bash5
#
# sd act - verbs that change a branch's PR.
#
# Usage:
#   sd act start    [--parent <branch>] [--harness <h>] [--no-implement] <name> [<task>]
#   sd act implement [--harness <h>] [<branch>]
#   sd act enroll   [<branch>]
#   sd act unenroll [<branch>]
#   sd act forget   [--remove] [<branch>]
#   sd act unregister [--force] [<path>]
#   sd act address  [--force] [--no-publish] [--harness <h>] [<branch>]
#   sd act ack      [--id <id>]... [--question] [<branch>]
#   sd act answer   [--force] <text> [<branch>]
#   sd act restack  [--force] [--resolve] [<branch>]
#   sd act retarget [<branch>]
#   sd act push     [--force] [<branch>]
#   sd act verify   [<branch>]
#   sd act autofix  [<branch>]
#   sd act ci-fix   [--force] [--no-publish] [--harness <h>] [<branch>]
#   sd act review   [--accept] [<branch>]
#   sd act describe [<branch>]
#   sd act ship     [--force] [<branch>]
#   sd act trigger  [--force] [<branch>]
#   sd act attach   [--force] [--harness <h>] [<branch>]
#
# Examples:
#   cd "$(sd act start fix-login "Fix the login redirect")"   worktree, then the agent builds it
#   sd act start --no-implement --parent fix-login fix-login-tests
#   sd act enroll                      sd watch starts tracking this branch
#   sd act address --no-publish        the agent fixes locally; nothing pushed or posted
#   sd act address --harness pi
#   sd act ack                         after reading sd state --long: the i items are done
#   sd act ack --question              after answering the agent's question in its session
#   sd act answer "revert the test"    answer it headless; the step that asked goes on
#   sd act restack && sd act push      catch up with the parent, then publish
#   sd act restack --resolve           the same, with the agent resolving conflicts
#   sd act review                      verify, then the local reviewer; clean pins local
#   sd act ship                        describe, push, open a draft PR, enroll
#   sd act attach                      open the branch's session yourself; agent steps wait
#
# Verbs:
#   start     a worktree beside the main one, named after <name> with
#             slashes as dashes, on the branch <name> (an existing local
#             branch; else <remote>/<name>, tracked; else new, off the fetched
#             default branch or --parent). Runs the repo's setup hook
#             there, as wt-new does: $GIT_COMMON_DIR/worktree-setup, else git
#             config wt.setup. Records the task and parent, pins base at a new
#             branch's start point, enrolls; then implement unless
#             --no-implement. stdout is only the worktree's path. Spends
#             tokens unless --no-implement
#   implement the agent works the recorded task (J0) in the branch's session;
#             the pipeline commits its edits, then runs verify. Claude may run
#             only read-only git, the verify command when it's plain words (no
#             globs, pipes or quotes), and settings.implementAllow's rules; pi
#             runs nothing. "needs-input" prints the agent's question and
#             leaves the edits uncommitted, for chrismo to answer in the
#             session (sd act attach). Review findings recorded on HEAD (sd
#             act review) go into the prompt, each answered on its own (see
#             review). Spends tokens
#   enroll    mark the branch for sd watch, and register this repo; for a
#             stacked PR, store its parent and base before a merge erases them
#             (or warn that git can't find the base, and how to pin it);
#             with no PR and no sd-parent, store the branch it was made from by
#             a plain git branch (#94), or say why git can't pick one (a tie,
#             or a parent that moved on) and store nothing
#   unenroll  clear the mark
#   forget    the branch is done (merged, abandoned): unenroll it and delete
#             its refs/sheepdog/<branch>/* pins, which outlive a branch -D,
#             and its stored description. --remove, once its PR merged: also
#             remove its worktree and delete the branch, which ends sd state's
#             merged step (#153). Refuses, changing nothing, unless the PR
#             merged with the branch's tip in it, and when the worktree has
#             uncommitted or untracked changes or is attached. The main
#             worktree is never removed: it is switched to the default branch.
#             Ignored files (.env, build output) go with a removed worktree;
#             it names them
#   unregister  take this repo (or <path>, e.g. one that's gone) off the
#             watcher's list; refuses while any branch is still enrolled
#   address   hand owed bot feedback to an agent, then commit, verify, push,
#             reply and resolve; items the agent marks "ask" are left for
#             chrismo. Replies are posted with /commands and @mentions
#             defanged. The agent may run what implement's may. Spends tokens
#   ack       mark owed bot review bodies and comments read, with no reply:
#             every i item, or only the --id ones (ids from sd state --json).
#             --question instead drops only the agent's standing question
#             (below): chrismo has answered it, so NEXT offers the step that
#             asked again
#   answer    chrismo's answer to the agent's standing question (below), with
#             no TUI: the step that asked (implement or its review-fix round,
#             address, ci-fix) resumes the branch's session with <text> as its
#             prompt, goes on from the edits it left, and finishes as that
#             step does (commit, verify, push, replies), under the running
#             marker. The question is dropped once the agent has run; a new
#             needs-input records a new one. Refuses with no question, one
#             that no longer stands, or an address question with no bot item
#             left for the agent. Spends tokens
#   restack   rebase --onto the parent (the default branch once the parent
#             merged), check the branch's own change came through unchanged,
#             else roll back; never pushes. When the old base isn't an
#             ancestor but HEAD fully holds the merged parent (sync.by_tree),
#             it goes by tree merge instead: one commit, committed by
#             whoever runs it. Once the branch lands on the
#             default branch, sd-parent is rewritten to it, unless the PR
#             still targets the parent (retarget does that) or can't be
#             read. A conflict is
#             refused, or with --resolve handed to the agent (J1): it edits
#             the conflicting files in the branch's session, the pipeline
#             adds and continues, up to 3 stops, printing the agent's summary
#             of each; an agent that finds the replayed commit already on the
#             target rolls it back as a wrong base. A resolved rebase skips the
#             unchanged-change check (a resolution changes the diff), so its
#             result is unreviewed: verify runs, and sd state's NEXT says
#             when to review it
#   retarget  after the parent merged: point the PR at the default branch
#             (gh pr edit --base; GitHub usually did it already when the
#             parent's branch was deleted) and rewrite sd-parent to it
#   push      publish: a plain push for new commits; rewritten history, or a
#             pushed commit reset away, is force-pushed with a lease, only
#             over a remote head of our own.
#             Never over commits this copy has never had, --force or not.
#             A reset-away drop is refused when a dropped commit wasn't
#             authored and committed here (take it back with merge
#             --ff-only), or when the worktree has uncommitted or untracked
#             changes (a soft or mixed reset: commit or remove them first).
#             Releases a CI config hold: chrismo pushing is the approval.
#             Refuses the default branch (#159)
#   verify   run settings.verify in the branch's worktree, zero tokens. Pass:
#             one line. Fail: nonzero, the output trimmed to its last 40 lines
#             for the fix step. A command that changes the tree fails too.
#             Gates local review and everything after it
#   autofix   run settings.autofix (formatters, lint --fix) in the branch's
#             worktree, zero tokens, and commit what it changed ("autofix:
#             <command>"). Nothing to commit: says so. A failing command is
#             nonzero with its output's tail, its changes left uncommitted.
#             implement and address run it when verify fails, then verify
#             again (A11), and ci-fix runs it first
#   ci-fix    CI is red on HEAD: verify and autofix first (zero tokens; a
#             fix there is pushed as is), else hand the agent the failing
#             checks, their logs (commit statuses and check runs over REST;
#             rwx results/logs for RWX, gh run view --log-failed for GitHub
#             Actions) and the local verify output, in the branch's session
#             (J2). The pipeline commits its fix, verifies, pushes. "flaky"
#             (the agent blames CI's environment) commits nothing and is
#             recorded against the red SHA, so the same red isn't handed
#             over again: rerun CI instead. Refuses on an old head or with
#             unpushed commits (push first) and on cancelled CI (rerun it).
#             Spends tokens
#   review    verify, then the local reviewer (settings.localReview, default
#             libexec/sd-review-local) over the branch's own change, base..HEAD.
#             Clean, or only nits: pin local at HEAD. Errors or warnings:
#             printed as JSON and recorded (refs/sheepdog/<b>/findings: head,
#             base, round, findings; implement adds each finding's id, action
#             and reply), nothing pinned; each such review of a changed HEAD
#             is the next round, until a pin clears the record. A failed
#             reviewer is never clean. sd state shows the record and NEXT
#             follows it: findings about HEAD (the same change, even rebased)
#             go to the agent (review-fix: sd act implement, its prompt
#             carrying the ones it hasn't declined) below
#             settings.reviewRounds. The agent answers each: fixed, declined
#             (with why) or ask. Any ask goes to chrismo as needs-input does,
#             nothing committed; otherwise its fixes are committed and the
#             next round is due, or with every finding declined, chrismo
#             decides (review-decide), as at the cap; findings on an older
#             head get a new review. sd state's flags (suppressions, skips,
#             edited tests) are printed on stderr for chrismo, whatever the
#             verdict; never a gate. Not stored with the record or the pin:
#             sd state recomputes them from base..HEAD on every call, so they
#             outlive stderr and never go stale. Spends tokens.
#             --accept: pin accepted at HEAD instead, reviewing nothing (HEAD
#             is reviewed enough), record the bot trigger it followed
#             (branch.<b>.sd-accepted-after), and drop the findings. It
#             stands in for the local review, not the bot's: the bot is still
#             triggered on HEAD, and only an accept made after that trigger
#             ends a silent bot's wait (#181)
#   describe  the agent writes the PR title and body (J6) from the task, the
#             commits and the diff, read-only, in the branch's session; stored
#             for HEAD and the PR's target. Spends tokens
#   ship      describe unless one for HEAD and the target is stored, check
#             HEAD didn't move, push, then open a draft PR on the parent
#             (sd-parent, else the PR's base, else with no PR the branch it
#             was made from, stored as enroll does, else the default branch)
#             and enroll; with a PR already open, fix up its title, body and
#             base instead. Warns when the local review doesn't cover HEAD;
#             the draft stays a draft until it does. Refuses the default
#             branch (#159), when git can't
#             pick the branch it was made from, and while the parent isn't on
#             the remote, has merged (restack first), was closed, or can't be
#             looked up; a merged parent with the branch already on the
#             default branch ships onto it and rewrites sd-parent. Spends
#             tokens unless a description for HEAD and the target is stored
#   trigger   post settings.botCommand on the PR so the review bot runs, and
#             pin bot at HEAD, recording when (sd state then waits on the
#             bot's reply); nothing when already pinned there. HEAD must
#             be on the remote (the bot reviews what GitHub has); neither
#             the local review nor an accept covering HEAD is a soft refusal
#   attach    takeover (A9): hold branch.<b>.sd-lock, open the branch's
#             session interactively in its worktree (claude --resume, or pi
#             --session-id; a new session when none is stored, kept once the
#             harness wrote its transcript), with the harness block's model,
#             effort, provider and args, and for claude without
#             ANTHROPIC_API_KEY unless useApiKey; release the lock when the session
#             exits, Ctrl-C included. While the lock is held, agent steps
#             (implement, address, restack --resolve, review, describe) and
#             the verbs that publish refuse to run; verify and the rest of
#             sd state's mechanics go on. A lock whose process is gone from
#             this host is stale, and every sd act verb clears it first
#
# CI config hold (#124): when the commit of an agent step that edits
# (implement and its review-fix rounds, address, ci-fix, restack --resolve)
# touches a protected path, the branch is held: address, ci-fix and ship
# don't push it, --force or not, and sd state's NEXT is chrismo's: review,
# then sd act push, which releases it. A later agent commit there holds it
# again. Protected paths: settings.protectedPaths; else
# .sheepdog/protected-paths in the base commit (one per line, # comments);
# else .github/workflows/ .github/actions/ .rwx/ .captain/ .circleci/
# .gitlab-ci.yml .buildkite/; unless the setting is set,
# .sheepdog/protected-paths itself too. Each covers itself and what's under it.
#
# Questions (#167): when implement, a review-fix round, address or ci-fix
# needs chrismo (outcome needs-input, or an item marked ask), the question is
# recorded on HEAD, with a hash of the worktree's uncommitted state
# (refs/sheepdog/<b>/question). While both are unchanged it stands: sd state's
# NEXT shows it as chrismo's question step in place of the step that asked,
# and that step refuses to run again. sd act answer carries chrismo's answer
# to it (#178); a commit, an edit, or sd act ack --question ends it too, the
# override the refusal names, as --force also lifts the step's other gates.
# An edit that ends it is chrismo's to commit: NEXT says so (dirty) in place
# of the agent steps that refuse a dirty worktree.
#
# --force:
#   address         run even if the branch is unpushed, diverged or taken over
#   restack, push, ship   run even if taken over
#   implement, review, describe   the same
#   attach          take over a lock another attach still holds
#   ci-fix          run again on a red the agent already called flaky
#   implement, address, ci-fix   run though the agent's question stands
#   trigger         even when neither the local review nor an accept covers
#                   HEAD, or the bot is already pinned at HEAD (trigger it
#                   again)
#   unregister      even with branches still enrolled (the watcher drops them)
#
# start options:
#   --parent <b>    start from <b> (local, else <remote>/<b>) and stack on it
#   --no-implement  stop after the setup; the task is then optional
#
# restack options:
#   --resolve       on a conflict, run the agent instead of refusing. Spends tokens
#
# address options:
#   --no-publish    stop after the local commit (the agent still runs: tokens);
#                   also ci-fix
#   --harness <h>   claude (default) or pi; remembered for the branch (also
#                   start, implement)
#
# Config (sd config show):
#   settings  remote, verify, autofix, stepTimeout, stepBudget, forkLimit (a
#             session with more context starts over), replyPrefix, botLogin, implementAllow,
#             protectedPaths,
#             <step>Prompt for implement, reviewFix, review, describe, address,
#             resolve, ciFix (a file; else .sheepdog/<step>.md in the base
#             commit, kebab-cased, else the shipped lib/prompts/<step>.md)
#   harness   model, effort, provider (pi), args
#
# State (git config): branch.<b>.sheepdog, .sd-task, .sd-parent, .sd-session,
# .sd-harness, .sd-handled, .sd-lock ("<pid>@<host> <time>" while attached),
# .sd-ci-fix ("<sha> fixed|flaky|autofix", the last red ci-fix handled),
# .sd-bot-triggered (when trigger's comment was posted, by GitHub's clock),
# .sd-accepted-after (the .sd-bot-triggered that review --accept followed),
# .sd-held (the CI config hold: the commit, then the paths, one per line);
# sheepdog.repo (global) lists the enrolled repos.
#
# <branch> defaults to the current one. A verb prints what it did, not what to
# run next: sd state's NEXT is the one place the order lives.

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/sheepdog.sh"
source "$(dirname "$(realpath "$0")")/../lib/config.sh"
SD_LIB=$(dirname "$(realpath "$0")")/../lib

die() { echo "sd act: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

(( $# )) || usage
verb=$1; shift
if [[ $verb == -h || $verb == --help ]]; then help; exit 0; fi
# The verbs ported to Rust (#202) get the arguments as given, after the
# checks below.
act_args=("$@")
act_rs() { exec "$SD_LIB/../target/release/sd" act "$verb" "${act_args[@]}"; }

force=false accept=false remove=false no_publish=false resolve=false no_implement=false question=false harness_opt="" parent_opt="" branch="" answer_text=""
ids=() positionals=()
while (( $# )); do
  case $1 in
    --force) force=true ;;
    --accept) accept=true ;;
    --remove) remove=true ;;
    --no-publish) no_publish=true ;;
    --resolve) resolve=true ;;
    --no-implement) no_implement=true ;;
    --question) question=true ;;
    --parent) (( $# > 1 )) || die "--parent needs a value"; parent_opt=$2; shift ;;
    --harness) (( $# > 1 )) || die "--harness needs a value"; harness_opt=$2; shift ;;
    --id) (( $# > 1 )) || die "--id needs a value"; ids+=("$2"); shift ;;
    -*) die "unknown option: $1" ;;
    *) branch=$1; positionals+=("$1") ;;
  esac
  shift
done

prc_super_init || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
remote=$(repo_remote) || die "sd config failed"
gh_repo "$remote"
if [[ $verb == start ]]; then
  (( ${#positionals[@]} >= 1 && ${#positionals[@]} <= 2 )) \
    || die "usage: sd act start [--parent <branch>] [--harness <h>] [--no-implement] <name> [<task>]"
  branch=${positionals[0]}
fi
if [[ $verb == answer ]]; then
  (( ${#positionals[@]} >= 1 && ${#positionals[@]} <= 2 )) && [[ ${positionals[0]} =~ [^[:space:]] ]] \
    || die "usage: sd act answer [--force] <text> [<branch>]"
  answer_text=${positionals[0]} branch=${positionals[1]:-}
fi
if $accept && [[ $verb != review ]]; then die "--accept is for sd act review only"; fi
if $remove && [[ $verb != forget ]]; then die "--remove is for sd act forget only"; fi
if $question && [[ $verb != ack ]]; then die "--question is for sd act ack only"; fi
positional=$branch
branch=${branch:-$(git branch --show-current)}
[[ -n $branch ]] || die "detached HEAD; name a branch"

# ── gates ────────────────────────────────────────────────────────────────────

# A gate is a list of {hard}, {soft}, {warn} and {done} records (restack
# --resolve's RESTACK_GATE). gate_get <gate> <key> prints that key's lines,
# in order.
gate_get() {
  local q="unnest (kind(this) == \"array\" ? this : [this]) | where coalesce($2, null) is not null | values $2"
  prc_line "$q" "$1"
}

# soft_gate <gate-json> <doing>: unless --force, list the soft refusals and exit.
soft_gate() {
  local soft
  soft=$(gate_get "$1" soft)
  if $force || [[ -z $soft ]]; then return 0; fi
  { echo "sd act: not $2:"
    sed 's/^/  - /' <<<"$soft"
    echo "(--force to run anyway)"; } >&2
  exit 1
}

# ── verify ───────────────────────────────────────────────────────────────────

VERIFY_TAIL=40
VERIFY_CMD="" AUTOFIX_COMMIT=""

# verify_run <worktree> <branch>: settings.verify there, under
# settings.stepTimeout, output captured. 0: passed, or nothing configured
# (VERIFY_CMD is then empty). Otherwise the command's status, with its output
# trimmed to the last $VERIFY_TAIL lines on stdout for the fix step that
# follows. A command that exits 0 but changes the tree (a formatter) fails too.
verify_run() {
  local wt=$1 b=$2 timeout out rc=0 n before
  VERIFY_CMD=$(cd "$wt" && prc_get settings.verify "$b" false) || die "sd config failed"
  [[ $VERIFY_CMD != *$'\n'* ]] || die "verify must be a single command, not a list"
  [[ -n $VERIFY_CMD ]] || return 0
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  out=$(mktemp)
  before=$(git -C "$wt" status --porcelain)
  (cd "$wt" && with_timeout "$timeout" sh -c "$VERIFY_CMD" </dev/null >"$out" 2>&1) || rc=$?
  if (( rc == 0 )) && [[ $(git -C "$wt" status --porcelain) != "$before" ]]; then
    echo "verify changed files in $wt (a formatter?); commit them and rerun"
    rc=1
  elif (( rc != 0 )); then
    n=$(wc -l < "$out" | tr -d " ")
    (( n <= VERIFY_TAIL )) || echo "… (last $VERIFY_TAIL of $n lines)"
    tail -n "$VERIFY_TAIL" "$out"
  fi
  rm -f "$out"
  return $rc
}

# ── autofix: A11 ─────────────────────────────────────────────────────────────

# autofix_run <worktree> <branch> [revert]: settings.autofix in the worktree
# under settings.stepTimeout, from a clean tree, and a commit of what it
# changed: AUTOFIX_COMMIT is its short sha, else empty. A failing command
# prints its output's tail, as verify_run does, and its changes are left
# uncommitted to look at, or with revert (the hook) put back, so the next
# step starts from the commit it knows.
autofix_run() {
  local wt=$1 b=$2 revert=${3:-} timeout out rc=0 n changed
  AUTOFIX_COMMIT=""
  AUTOFIX_CMD=$(cd "$wt" && prc_get settings.autofix "$b" false) || die "sd config failed"
  [[ $AUTOFIX_CMD != *$'\n'* ]] || die "autofix must be a single command, not a list"
  [[ -n $AUTOFIX_CMD ]] || return 0
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes; autofix needs a clean tree to commit from"
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  out=$(mktemp)
  (cd "$wt" && with_timeout "$timeout" sh -c "$AUTOFIX_CMD" </dev/null >"$out" 2>&1) || rc=$?
  changed=$(git -C "$wt" status --porcelain | wc -l | tr -d " ")
  if (( rc != 0 )); then
    n=$(wc -l < "$out" | tr -d " ")
    (( n <= VERIFY_TAIL )) || echo "… (last $VERIFY_TAIL of $n lines)"
    tail -n "$VERIFY_TAIL" "$out"
    if (( changed > 0 )) && [[ $revert == revert ]]; then
      git -C "$wt" reset -q --hard && git -C "$wt" clean -qfd
      echo "autofix changed $(plural "$changed" file) before failing; reverted"
    elif (( changed > 0 )); then
      echo "autofix changed $(plural "$changed" file) in $wt before failing; left uncommitted"
    fi
  elif (( changed > 0 )); then
    git -C "$wt" add -A && git -C "$wt" commit -q -m "autofix: $AUTOFIX_CMD" || die "commit failed; autofix's changes are left in $wt"
    AUTOFIX_COMMIT=$(git -C "$wt" rev-parse --short HEAD)
    echo "autofix committed $AUTOFIX_COMMIT: $(plural "$changed" file) ($AUTOFIX_CMD)"
  else
    echo "autofix changed nothing ($AUTOFIX_CMD)"
  fi
  rm -f "$out"
  return $rc
}

# verify_autofix <worktree> <branch>: verify; when it fails, autofix, and when
# that committed something, verify again. The zero-token pass before a fix
# step. A verify that dirtied the tree is verify's own failure: no autofix.
verify_autofix() {
  AUTOFIX_COMMIT=""
  verify_run "$1" "$2" && return 0
  [[ -z $(git -C "$1" status --porcelain) ]] || return 1
  autofix_run "$1" "$2" revert || return 1
  [[ -n $AUTOFIX_COMMIT ]] || return 1
  verify_run "$1" "$2" || return 1
  echo "verify passed after autofix ($VERIFY_CMD)"
}

# ── agent sessions ───────────────────────────────────────────────────────────

# This section, the questions and guidance_base, agent_rules and the CI
# config hold below are the bash agent step's (restack --resolve).
# src/act/step.rs and src/act/hold.rs do the same for implement, address,
# ci-fix, describe and ship: change both.

# step_session <branch> <step>: the harness and session a step runs in: the
# branch's session (branch.<b>.sd-session) resumed, else a new one. Sets
# STEP_CFG, STEP_H, STEP_SID, STEP_MODE, STEP_TIMEOUT. Refuses while the
# branch is attached: the session is open in a TUI, and a resume beside it
# forks the transcript (#14).
step_session() {
  local b=$1 step=$2 stored_h
  attached_check "$b" "running the $step step on $b"
  export HARNESS_STEP=$step HARNESS_BRANCH=$b
  stored_h=$(git config --get "branch.$b.sd-harness" || true)
  STEP_CFG=$(prc_step "$step" "$b" "${harness_opt:-$stored_h}") || die "sd config failed"
  STEP_H=$(prc_val "$STEP_CFG" harness)
  STEP_SID=$(git config --get "branch.$b.sd-session" || true)
  # An answer goes to the session that asked, however big it is.
  [[ -z $answer_text || -n $STEP_SID ]] || die "no session on $b to answer in (branch.$b.sd-session)"
  if [[ -n $STEP_SID ]]; then
    [[ $STEP_H == "${stored_h:-claude}" ]] \
      || die "branch.$b.sd-session belongs to ${stored_h:-claude}; unset it to start a $STEP_H session"
    STEP_MODE=resume
    if [[ -z $answer_text ]] && past_fork_limit "$b" "$STEP_H" "$STEP_SID"; then STEP_SID=; fi
  fi
  if [[ -z $STEP_SID ]]; then
    STEP_SID=$(uuidgen | tr 'A-F' 'a-f') STEP_MODE=new
  fi
  STEP_TIMEOUT=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $STEP_TIMEOUT =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $STEP_TIMEOUT"
}

# past_fork_limit <branch> <harness> <session-id>: the session's context (its
# last turn's tokens, harness_tally) is past settings.forkLimit, so a step
# starts a new session instead of inheriting it (#121). Every step's prompt is
# self-contained (task, contract, findings or logs), so the history is only an
# optimization, and past the limit it stops paying for itself. 0 is no limit;
# no transcript, or none that says, is resumed.
past_fork_limit() {
  local limit ctx
  limit=$(prc_get settings.forkLimit "$1" false) || die "sd config failed"
  (( limit > 0 )) || return 1
  ctx=$(prc_val "$(harness_tally "$2" "$3")" 'coalesce(context, "")') || return 1
  [[ -n $ctx ]] && (( ctx > limit )) || return 1
  echo "sd act: session $3 is $ctx tokens, past settings.forkLimit ($limit): starting a new one" >&2
}

# step_store <branch>: after a step ran, remember its session and harness.
step_store() {
  git config "branch.$1.sd-session" "$STEP_SID"
  git config "branch.$1.sd-harness" "$STEP_H"
}

# ── an agent step's question (#167) ──────────────────────────────────────────

# question_ask <branch> <worktree> <step> <text>: record a step's needs-input
# on HEAD and the worktree as the step left them (lib/sheepdog.sh's
# question_state); a failure only warns, as the question is printed anyway.
question_ask() {
  local b=$1 head mark text rec
  text=$(tr -d '\000-\010\013\014\016-\037\177' <<<"$4")
  head=$(git rev-parse "refs/heads/$b") && mark=$(worktree_mark "$2") \
    && rec=$(printf '{"head": "%s", "step": "%s", "mark": "%s", "text": %s}' "$head" "$3" "$mark" "$(prc_json_string "$text")") \
    && git update-ref -m "sd act $3: needs input" "refs/sheepdog/$b/question" "$(git hash-object -w --stdin <<<"$rec")" \
    || echo "sd act: warning: couldn't record the question on $b, so NEXT won't show it" >&2
}

question_say() { echo "NEXT shows the question until $1's HEAD or worktree changes, or sd act ack --question"; }
answer_cmd() { echo "sd act answer \"<your answer>\" $1"; }

# question_gate <branch> <step>: refuse, at zero tokens, to rerun the step
# whose question stands; --force runs it anyway, and sd act answer goes on
# from it.
question_gate() {
  local q
  [[ -z $answer_text ]] || return 0
  q=$(question_state "$1" "$(git rev-parse "refs/heads/$1")") && [[ -n $q ]] || return 0
  [[ $(prc_val "$q" "at_head and step == \"$2\"") == true ]] || return 0
  if $force; then
    echo "sd act: warning: the $2 agent's question on $1 stands; running anyway" >&2
    return 0
  fi
  die "not running $2 on $1: its agent asked, and nothing has changed since:"$'\n'"$(prc_val "$q" text)"$'\n'"Answer with $(answer_cmd "$1"); or answer in its session (sd act attach $1), then sd act ack --question"
}

# ── answer: an agent step's question, answered (#178) ────────────────────────

# answer: resume the asking step (the question's step) in the branch's
# session, with chrismo's answer as its whole prompt: the session holds the
# step's own prompt, and its edits are still in the worktree, which the step
# would otherwise refuse. The rest of the step (commit, verify, push, replies)
# runs as usual, under the running marker. Only a question that still stands.
answer() {
  local b=$branch q step flags=()
  q=$(question_state "$b" "$(git rev-parse "refs/heads/$b")") || die "refs/sheepdog/$b/question isn't a question record"
  [[ -n $q ]] || die "no question to answer on $b"
  step=$(prc_val "$q" step)
  [[ $(prc_val "$q" at_head) == true ]] \
    || die "the $step agent's question on $b no longer stands: HEAD or the worktree changed since it asked (sd act ack --question drops it)"
  if $force; then flags+=(--force); fi
  if $no_publish; then flags+=(--no-publish); fi
  if [[ -n $harness_opt ]]; then flags+=(--harness "$harness_opt"); fi
  case $step in
    # implement, address and ci-fix are Rust (src/act/): --answer hands them the answer.
    implement|review-fix|address|ci-fix)
      case $step in address|ci-fix) ;; *) step=implement ;; esac
      exec "$SD_LIB/../target/release/sd" act "$step" --answer "$answer_text" "${flags[@]}" "$b" ;;
    *) die "can't answer a $step question" ;;
  esac
}

# answer_prompt [<items>]: the prompt for a step resumed with chrismo's
# answer, then the items owed now (address: bot items can come in while the
# question stands, and an item left unanswered is asked again).
answer_prompt() {
  printf '%s\n\n%s\n\n%s' "chrismo answers the question you asked:" "$answer_text" \
    "Go on with the step you were on, from the worktree as you left it, and end with that step's JSON result, as before (every item again, for a step that answers items)."
  [[ -z ${1:-} ]] || printf '\n\n%s\n%s' "The items to answer now, any that came in since you asked among them:" "$1"
}

# question_answered <branch>: once the answer reached the agent, its question
# is done; a new one it asks is recorded anew.
question_answered() { [[ -z $answer_text ]] || git update-ref -d "refs/sheepdog/$1/question"; }

# ── attach's lock (A9) ───────────────────────────────────────────────────────
# attach itself is src/act/attach.rs; the bash agent steps still check its lock.

# branch.<b>.sd-lock is "<pid>@<host> <time>": the attach holding the branch's
# session open. Stale once that pid is gone from this host; a lock from
# another host can't be checked, so it never is.
lock_stale() {
  local pid=${1%%@*} host=${1#*@}
  host=${host%% *}
  [[ $pid =~ ^[0-9]+$ && $host == "$(hostname)" ]] || return 1
  ! kill -0 "$pid" 2>/dev/null
}

# lock_sweep <branch>: clear a stale lock, so every verb's gate sees only live ones.
lock_sweep() {
  local lock
  lock=$(git config --get "branch.$1.sd-lock" 2>/dev/null || true)
  [[ -n $lock ]] && lock_stale "$lock" || return 0
  echo "sd act: clearing a stale lock on $1 ($lock)" >&2
  git config --unset "branch.$1.sd-lock"
}

# attached_check <branch> <doing>: an agent step on an attached branch is
# refused; --force runs it anyway. src/act/mod.rs's attached_check does the
# same for review: change both.
attached_check() {
  local lock
  lock=$(git config --get "branch.$1.sd-lock" || true)
  [[ -n $lock ]] || return 0
  if $force; then
    echo "sd act: warning: $1 is attached ($lock); running anyway" >&2
  else
    die "not $2: attached ($lock). Exit that session, or --force"
  fi
}

# ── guidance base ────────────────────────────────────────────────────────────

# start_default <remote>: the default branch as fetched, for guidance_base.
# src/act/start.rs's start_default does the same for start and implement:
# change both.
start_default() {
  local head br
  head=$(git symbolic-ref -q --short "refs/remotes/$1/HEAD" 2>/dev/null) && { echo "${head#"$1"/}"; return; }
  for br in main master; do
    if git show-ref -q --verify "refs/remotes/$1/$br" || git show-ref -q --verify "refs/heads/$br"; then
      echo "$br"; return
    fi
  done
  return 1
}

# guidance_base <branch>: the commit a step reads repo guidance (.sheepdog/,
# relative prompt paths) from, which the branch's agent can't rewrite: the
# base pin, else where the branch forked from the default branch, the remote's
# or else the local one, unless the branch is the default branch: sheepdog
# pushes it, so neither ref is clear of its commits. Nothing when none
# qualifies: the branch's own commits are never trusted for its guidance.
guidance_base() {
  local remote def ref
  git rev-parse -q --verify "refs/sheepdog/$1/base" && return
  remote=$(repo_remote) || return 1
  if def=$(start_default "$remote") && [[ $def != "$1" ]]; then
    for ref in "refs/remotes/$remote/$def" "refs/heads/$def"; do
      git show-ref -q --verify "$ref" && git merge-base "refs/heads/$1" "$ref" && return
    done
  fi
  return 0
}

# agent_rules <worktree> <branch>: what the agent may run beyond reading and
# read-only git: settings.verify when it is plain words, and settings.implementAllow.
agent_rules() {
  local verify extra rule
  verify=$(cd "$1" && prc_get settings.verify "$2" false) || die "sd config failed"
  extra=$(cd "$1" && prc_get settings.implementAllow "$2" false) || die "sd config failed"
  if [[ $verify =~ ^[A-Za-z0-9_./:=@+-]+( [A-Za-z0-9_./:=@+-]+)*$ ]]; then echo "Bash($verify)"; fi
  while IFS= read -r rule; do [[ -z $rule ]] || echo "$rule"; done <<<"$extra"
}

# ── CI config hold (#124) ────────────────────────────────────────────────────

hold_say() { echo "the agent changed CI config (${1//$'\n'/, }): review, then sd act push"; }

# hold_paths <branch> <remote>: the paths an active hold names, one per line.
# Status 1: none; 2: the hold can't be read. It runs in $( ), so it never
# dies (that would only end the subshell, and read as no hold): callers turn 2
# into a refusal. A hold whose commit is on the remote was published some
# other way, so it is cleared (reconcile, not enforce).
hold_paths() {
  local b=$1 v rsha rc=0
  v=$(git config --get "branch.$b.sd-held") || rc=$?
  (( rc == 0 )) || { (( rc == 1 )) && return 1; return 2; }
  rsha=$(git rev-parse -q --verify "refs/remotes/$2/$b^{commit}" || true)
  if [[ -n $rsha ]] && git merge-base --is-ancestor "${v%%$'\n'*}" "$rsha" 2>/dev/null; then
    git config --unset "branch.$b.sd-held" || return 2
    return 1
  fi
  printf '%s\n' "${v#*$'\n'}"
}

# hold_read <branch> <doing>: hold_paths, with the remote read here
# (outside $( ), where die exits) and an unreadable hold refused.
hold_read() {
  local remote rc=0
  remote=$(repo_remote) || die "sd config failed"
  HOLD_PATHS=$(hold_paths "$1" "$remote") || rc=$?
  (( rc != 2 )) || die "not $2: can't read branch.$1.sd-held, the CI config hold"
  return "$rc"
}

# hold_after <branch> <base> <files>: after an agent step's edits are
# committed, the files they changed (one per line) against protected_paths
# (read from <base>). On a match, hold the branch: branch.<b>.sd-held is HEAD,
# then the paths, an active hold's included, one per line. The automated
# pushes (address, ci-fix, ship) refuse while it holds; chrismo running sd act
# push is the approval, and clears it. A HEAD already on the remote-tracking
# ref was pushed during the step, by the agent (the deny on git push is no
# guarantee either): a hold would only be cleared as published, unseen, so
# that fails loudly instead.
hold_after() {
  local b=$1 paths hits prev="" remote rsha
  paths=$(protected_paths "$b" "$2") || die "sd config failed"
  hits=$(protected_hits "$paths" "$3")
  [[ -n $hits ]] || return 0
  remote=$(repo_remote) || die "sd config failed"
  rsha=$(git rev-parse -q --verify "refs/remotes/$remote/$b^{commit}" || true)
  if [[ -n $rsha ]] && git merge-base --is-ancestor "refs/heads/$b" "$rsha"; then
    die "the agent pushed CI config itself (${hits//$'\n'/, }): it is on $remote/$b unreviewed; review it now (git log -p $remote/$b -- ${hits//$'\n'/ })"
  fi
  if hold_read "$b" "holding $b"; then prev=$HOLD_PATHS; fi
  hits=$(printf '%s\n' "$prev" "$hits" | sed '/^$/d' | sort -u)
  git config "branch.$b.sd-held" "$(git rev-parse "refs/heads/$b")"$'\n'"$hits"
  echo "held: $(hold_say "$hits")"
}

# hold_since <branch> <base> <since>: hold_after over <since>..the branch, if
# it moved. Each agent step runs it right after the harness returns, failed
# or not, before any outcome can die (the agent may commit itself: the deny is no
# guarantee), and again from there over the pipeline's own commit.
hold_since() {
  [[ $(git rev-parse "refs/heads/$1") != "$3" ]] || return 0
  hold_after "$1" "$2" "$(git diff -z --name-only --no-renames "$3" "refs/heads/$1" | tr '\0' '\n')"
}

# hold_gate <branch> <doing> [<then>]: refuse <doing> while a hold is active;
# <then> follows the message.
hold_gate() {
  hold_read "$1" "$2" || return 0
  die "not $2: $(hold_say "$HOLD_PATHS")${3:+. $3}"
}

# ── push ─────────────────────────────────────────────────────────────────────

plural() { if (( $1 == 1 )); then echo "1 $2"; else echo "$1 $2s"; fi; }

# push_branch <branch> <remote>: publish <branch> as fetched just now. Rewritten
# history, or a pushed commit reset away, is force-pushed with a lease on that
# remote head, and only when the head is in the branch's reflog (we put it there).
# sd act push is src/act/push.rs, which has its own copies of these: change both.
push_branch() {
  local b=$1 remote=$2 rsha ahead behind reflog theirs
  git fetch --quiet --prune "$remote" || { echo "sd act: fetch from $remote failed" >&2; return 1; }
  rsha=$(git rev-parse -q --verify "refs/remotes/$remote/$b^{commit}" || true)
  if [[ -z $rsha ]]; then
    push_ref "$b" "$remote" "" || return
    echo "pushed $b to $remote (new branch)"
    track "$b" "$remote"
    return
  fi
  ahead=$(git rev-list --count "$rsha..refs/heads/$b")
  behind=$(git rev-list --count "refs/heads/$b..$rsha")
  if (( ahead == 0 && behind == 0 )); then
    echo "nothing to push on $b"
  elif (( behind == 0 )); then
    push_ref "$b" "$remote" "$rsha" || return
    echo "pushed $b to $remote ($(plural "$ahead" commit))"
  else
    # The remote has commits this branch doesn't. Ours (in the branch's
    # reflog: an amend, or a pushed commit reset away, #86) are replaced with
    # a lease; anyone else's are never pushed over.
    # Not piped into grep -q: under pipefail, git dying of SIGPIPE would read as "not ours".
    reflog=$(git reflog show --format=%H "refs/heads/$b")
    if ! grep -qx "$rsha" <<<"$reflog"; then
      if (( ahead == 0 )); then
        echo "sd act: $remote/$b has $(plural "$behind" commit) you don't; take them with: git merge --ff-only $remote/$b" >&2
      else
        theirs=$(commits_not_ours "$reflog" "$rsha")
        echo "sd act: $remote/$b has $(plural "$theirs" commit) this copy has never had; not pushing over it." \
             "Look: git log $b..$remote/$b, then rebase onto or merge $remote/$b and push again" >&2
      fi
      return 1
    fi
    if (( ahead == 0 )); then
      # Dropping needs more than "the branch once pointed there": a commit
      # taken with merge --ff-only (or a pull, or a rebase onto the remote)
      # and reset away is in the reflog too, and it was someone else's work.
      # Every commit being dropped must have been made here (made_here).
      if ! made_here "refs/heads/$b..$rsha"; then
        echo "sd act: $remote/$b has $(plural "$behind" commit) you don't; this branch had them but didn't make them all, so take them back (git merge --ff-only $remote/$b), or drop them by hand" >&2
        return 1
      fi
      # A soft or mixed reset looks the same as a deliberate drop, except the
      # changes are still in the worktree: don't throw the remote commit away
      # under them.
      local wt st=""; wt=$(worktree_for "$b")
      if [[ -n $wt ]] && ! st=$(git -C "$wt" status --porcelain); then
        echo "sd act: can't read $wt's status; not dropping the remote commit" >&2
        return 1
      fi
      if [[ -n $st ]]; then
        echo "sd act: $remote/$b has $(plural "$behind" commit) this branch was reset off, and $wt has uncommitted or untracked changes:" \
             "commit them (then push replaces the remote commit), or drop them (git reset --hard; git clean -n shows the untracked ones)" >&2
        return 1
      fi
    fi
    push_ref "$b" "$remote" "$rsha" --force-with-lease="refs/heads/$b:$rsha" || return
    if (( ahead == 0 )); then
      echo "force-pushed $b to $remote (dropped $(plural "$behind" commit); the remote head ${rsha:0:7} was ours)"
    else
      echo "force-pushed $b to $remote (rewritten; the remote head ${rsha:0:7} was ours)"
    fi
  fi
  track "$b" "$remote"
}

track() {
  git config "branch.$1.remote" "$2" && git config "branch.$1.merge" "refs/heads/$1" \
    || echo "sd act: warning: $1 is pushed, but its upstream isn't $2/$1: git branch --set-upstream-to=$2/$1 $1" >&2
}

# push_ref <branch> <remote> <expected-remote-sha> [push options...]
push_ref() {
  local b=$1 remote=$2 expected=$3 err now
  shift 3
  if ! err=$(git push --quiet "$@" "$remote" "refs/heads/$b:refs/heads/$b" 2>&1); then
    now=$(git ls-remote "$remote" "refs/heads/$b" 2>/dev/null | cut -f1)
    if [[ $now != "$expected" ]]; then
      echo "sd act: $remote/$b moved while pushing; nothing pushed. Run it again to see what changed" >&2
    else
      echo "sd act: push to $remote failed: ${err//$'\n'/ }" >&2
    fi
    return 1
  fi
}

# ── restack ──────────────────────────────────────────────────────────────────

# -U0: an upstream edit next to the branch's lines must not read as a change.
patch_id() { git diff -U0 "$1" "$2" | git patch-id --stable | cut -d' ' -f1; }

# Plain restack is src/act/restack.rs (#202). This one, restack --resolve,
# keeps its own RESTACK_GATE, KEEP_PARENT, restack_by_tree and
# parent_to_default until #203 ports it: change both.

# Over {remote, replay: old_base..HEAD, newest first, s: the sd state JSON}.
read -r -d '' RESTACK_GATE <<'EOF' || true
values {remote, s, onto: f"{remote}/{s.sync.target}",
        why: len(coalesce(s.errors, [])) > 0 ? sj(s.errors, "; ")
             : on(s.parent.unpushed) ? f"parent {s.parent.name} isn't on {remote} yet: ship it first (sd act ship {s.parent.name})" : "",
        from_parent: coalesce([unnest {p: coalesce(s.parent.pr.commits, []), r: replay} | where r in p | values r], [])}
| values [
    on(s.parent.pr.state == "CLOSED") and on(s.parent.name != s.sync.default)
      ? {hard: f"{s.parent.name}'s PR #{s.parent.pr.number} was closed without merging; decide what {s.branch} targets"}
    : nul(s.parent.merged) and on(s.parent.name != s.sync.default)
      ? {hard: f"can't tell whether {s.parent.name} merged: {why}"}
    : null,
    nul(s.sync.up_to_date) or (on(s.sync.up_to_date == false) and nul(s.sync.old_base))
      ? {hard: f"can't restack {s.branch}: {why}"}
    : on(s.sync.up_to_date) ? {done: f"{s.branch} is already on {onto}"}
    : on(s.parent.merged) and not on(s.sync.by_tree) and len(from_parent) > 0
      ? {hard: f"wrong base: this would replay {len(from_parent)} of #{s.parent.pr.number}'s commits onto {onto}; if the stack is linear, rebase past them by hand: git rebase --onto {onto} {from_parent[0][0:12]} {s.branch} && git update-ref refs/sheepdog/{s.branch}/base {onto}"}
    : nul(s.sync.conflict) ? {hard: f"can't tell whether restacking {s.branch} would conflict: {why}"}
    : on(s.sync.by_tree) and on(s.sync.conflict)
      ? {hard: f"restacking {s.branch} onto {onto} by tree would conflict; --resolve can't resolve a tree restack. By hand: git switch {s.branch} && git reset --hard {onto} && git diff --binary {s.sync.old_base[0:12]} {s.head[0:12]} | git apply -3, resolve and commit, then git update-ref refs/sheepdog/{s.branch}/base {onto} (the old head stays at {s.head[0:12]})"}
    : null,
    on(s.session.locked) ? {soft: f"taken over (branch.{s.branch}.sd-lock is set)"} : null
  ]
| values coalesce([unnest this | where this is not null], [])
EOF

# Over the sd state JSON: why sd-parent stays on a merged parent, else nothing.
# Until the PR targets the default branch, sd-parent is what keeps retarget
# owed: deleting the merged parent's branch would close a PR still on it.
read -r -d '' KEEP_PARENT <<'EOF' || true
where on(parent.merged)
| values {s: this, gh: f"gh ({branch}):"}
| values nul(s.pr)
    ? (len(coalesce([unnest {gh, e: coalesce(s.errors, [])} | where e[0:len(gh)] == gh], [])) > 0
       ? f"sd-parent of {s.branch} stays {s.parent.name}: can't read its PR" : null)
  : on(s.pr.state == "OPEN") and on(s.pr.base != s.sync.default)
    ? f"PR #{s.pr.number} still targets {s.pr.base}: sd act retarget" : null
| where this is not null
EOF

restack() {
  local b=$branch wt remote state gate line target new_base old_base old_head new_head before replay
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(repo_remote) || die "sd config failed"
  git -C "$wt" fetch --quiet --prune "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  old_base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  replay='[]'
  if [[ -n $old_base && $(prc_val "$state" 'on(parent.merged) and on(sync.up_to_date == false)') == true ]]; then
    replay=$(git rev-list --topo-order "$old_base..refs/heads/$b" | prc_strings) || die "can't list $old_base..$b"
  fi

  gate=$(prc_json "$RESTACK_GATE" "{\"remote\": $(prc_json_string "$remote"), \"replay\": $replay, \"s\": $state}") \
    || die "can't parse sd state's answer"
  line=$(gate_get "$gate" hard | head -1)
  [[ -z $line ]] || die "$line"
  line=$(gate_get "$gate" done)
  if [[ -n $line ]]; then echo "$line"; return; fi
  soft_gate "$gate" "restacking $b"

  target=$(prc_val "$state" sync.target)
  new_base=$(git rev-parse "refs/remotes/$remote/$target^{commit}")
  old_head=$(git rev-parse "refs/heads/$b")
  before=$(patch_id "$old_base" "$old_head")
  local resolved=false by_tree via=""
  by_tree=$(prc_val "$state" sync.by_tree)
  if [[ $by_tree == true ]]; then
    restack_by_tree "$wt" "$b" "$old_base" "$old_head" "$new_base" "$remote/$target"
    via=" by tree"
  elif ! git -C "$wt" rebase --quiet --onto "$new_base" "$old_base" "$b" >/dev/null 2>&1; then
    # Marked running across every stop and continue, not only each agent run (#170).
    running_during "$b" resolve resolve_conflicts "$b" "$wt" "$old_base" "$old_head" "$remote/$target" || exit 1
    resolved=true
    # Before anything below can die: the resolution is on the branch now.
    hold_after "$b" "$old_base" "$RESOLVE_TOUCHED"
  fi
  new_head=$(git rev-parse "refs/heads/$b")
  # A resolution changes the branch's diff by definition, so the check only
  # applies to a clean rebase; a resolved one goes through verify and review.
  if ! $resolved && [[ $(patch_id "$new_base" "$new_head") != "$before" ]]; then
    git -C "$wt" reset --quiet --hard "$old_head"
    die "$b's change came out different on $remote/$target (part of it may be there already); rolled back to ${old_head:0:7}." \
        "Compare: git range-diff ${old_base:0:12}..${old_head:0:12} ${new_base:0:12}..${new_head:0:12}"
  fi
  git update-ref -m "sd act restack" "refs/sheepdog/$b/base" "$new_base"
  local how="sd act push"
  # A plain push is rejected once the remote head is no longer an ancestor.
  if git show-ref -q --verify "refs/remotes/$remote/$b" && ! git merge-base --is-ancestor "refs/remotes/$remote/$b" "$new_head"; then
    how="a plain git push is rejected now, and git's pull advice would undo the restack; use sd act push"
  fi
  echo "restacked $b onto $remote/$target$via ($(plural "$(git rev-list --count "$new_base..$new_head")" commit)); not pushed: $how"
  [[ -z $via ]] || echo "$b's commits are now one, committed by you; the old ones are at ${old_head:0:7}"
  line=$(prc_line "$KEEP_PARENT" "$state") \
    || die "restacked $b, but couldn't tell whether its PR still targets the parent; sd-parent left as is$($resolved && echo ". The agent resolved conflicts, so $b's change is unverified and unreviewed")"
  if [[ -n $line ]]; then echo "$line"; else parent_to_default "$b" "$state"; fi
  if $resolved; then
    echo "conflicts resolved by the agent, so $b's change is unreviewed"
    verify_run "$wt" "$b" || die "verify failed ($VERIFY_CMD) on the resolved branch; it is kept at ${new_head:0:7}, unpushed. Fix, then sd act verify"
  fi
}

# restack_by_tree <worktree> <branch> <old-base> <old-head> <new-base> <onto>:
# <old-base>..<old-head>'s change as one commit on <new-base>, by a tree merge,
# for an old base that isn't an ancestor (sd state's sync.by_tree). The message
# leaves out exact copies of the parent's commits: their change is on the target.
restack_by_tree() {
  local tree new
  tree=$(git merge-tree --write-tree --merge-base="$3" "$5" "$4") \
    || die "restacking $2 onto $6 by tree hit a conflict; nothing moved"
  new=$(printf '%s (restacked by tree onto %s)\n\nReplaces:\n%s\n' "$2" "$6" "$(git log --reverse --format=%s --right-only --cherry-pick "$3...$4")" \
          | git commit-tree "$tree" -p "$5") || die "git commit-tree failed; nothing moved"
  # Not "reset: moving to" in the reflog: stacked_on counts this commit as the branch's own.
  GIT_REFLOG_ACTION="sd act restack by tree" git -C "$1" reset --quiet --hard "$new"
}

restack_rollback() { # <worktree> <branch> <old-head>
  git -C "$1" rebase --abort 2>/dev/null || true
  [[ $(git rev-parse "refs/heads/$2") == "$3" ]] || git -C "$1" reset --quiet --hard "$3"
}

# ── --resolve: J1 ────────────────────────────────────────────────────────────

RESOLVE_CAP=3

# The resolve step's prompt: guidance (settings.resolvePrompt, else
# .sheepdog/resolve.md in the base commit, else lib/prompts/resolve.md), then
# this contract, which the restack's rollback and refusals rely on.
read -r -d '' RESOLVE_CONTRACT <<'EOF' || true
Do not run git add, git rebase --continue, or commit: the pipeline does that
after you, and it will stop again if another commit conflicts. If no sensible
resolution exists, answer with outcome "gave-up" and say why; nothing you
changed will be kept.

Before resolving, judge whether the commit being replayed (named below, among
all the commits this rebase replays) is this branch's work, from its subject,
the files it changes and the task. If it isn't, and its change is already on the target
(e.g. a merged parent's commit, which the target holds as a squash), the replay
itself is wrong: don't resolve it, answer with outcome "already-on-target" and
say why. The pipeline rolls back and refuses; it never drops a commit on your
word.
EOF

read -r -d '' RESOLVE_SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "summary"],
 "properties": {"outcome": {"enum": ["done", "gave-up", "already-on-target"]}, "summary": {"type": "string"}}}
EOF

# worktree_tree <worktree>: the tree of everything in it, tracked or not
# (ignored files aside), staged or not, through a scratch index; the real
# index, mid-rebase, is left alone.
worktree_tree() {
  local dir tree rc=0
  dir=$(mktemp -d) || return 1
  tree=$(export GIT_INDEX_FILE=$dir/index
         git -C "$1" read-tree HEAD && git -C "$1" add -A && git -C "$1" write-tree) || rc=1
  rm -rf "$dir"
  (( rc == 0 )) && echo "$tree"
}

# resolve_conflicts <branch> <worktree> <old-base> <old-head> <onto>: a rebase
# has stopped; the agent resolves each stop in the branch's session, the
# pipeline adds and continues. Any failure rolls the branch back and returns 1.
# RESOLVE_TOUCHED is the files the agent changed, one per line: the worktree
# before and after each stop compared whole, so staging or committing them
# itself hides nothing.
resolve_conflicts() {
  local b=$1 wt=$2 old_base=$3 old_head=$4 onto=$5 stops=0 files hunks task result outcome replayed replaying replaying_stat guidance snap after verify s runs="" allow=$HARNESS_CLAUDE_ALLOW
  local -a rules
  RESOLVE_TOUCHED=""
  task=$(git config --get "branch.$b.sd-task" || true)
  replayed=$(git log --reverse --no-merges --topo-order --format='%h %s' "$old_base..$old_head")
  # implement's settings and session, logged in usage.sup as its own step.
  step_session "$b" implement
  HARNESS_STEP=resolve
  if ! guidance=$(cd "$wt" && step_guidance resolvePrompt "$b" "$old_base" "$SD_LIB/prompts/resolve.md"); then
    restack_rollback "$wt" "$b" "$old_head"
    die "can't read the resolve guidance; rolled back to ${old_head:0:7}"
  fi
  if ! verify=$(cd "$wt" && prc_get settings.verify "$b" false) || ! s=$(agent_rules "$wt" "$b"); then
    restack_rollback "$wt" "$b" "$old_head"
    die "sd config failed; rolled back to ${old_head:0:7}"
  fi
  rules=(); [[ -z $s ]] || mapfile -t rules <<<"$s"
  [[ -z $verify ]] || runs+=$'\n\nThe repo\'s checks, which the pipeline runs after you: '"$verify"
  if [[ $STEP_H == claude ]] && (( ${#rules[@]} )); then
    allow+=$(printf ',%s' "${rules[@]}")
    runs+=$'\n\nBeyond reading files and read-only git, you may run only these (Claude Code permission rules); anything else is refused:\n'"$(printf '%s\n' "${rules[@]}")"
  else
    runs+=$'\n\nYou can\'t run commands here beyond read-only git.'
  fi
  while :; do
    if (( ++stops > RESOLVE_CAP )); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the rebase onto $onto stopped $stops times (cap $RESOLVE_CAP); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    files=$(git -C "$wt" diff --name-only --diff-filter=U)
    if [[ -z $files ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the rebase stopped without conflicting files; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    hunks=$(git -C "$wt" diff)
    replaying=$(git -C "$wt" log -1 --format='%h %s' REBASE_HEAD)
    replaying_stat=$(git -C "$wt" show --stat --format= REBASE_HEAD)
    if ! snap=$(worktree_tree "$wt"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: can't snapshot $wt before the agent runs; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    echo "sd act: $STEP_H ($STEP_MODE session $STEP_SID) is resolving conflicts in: ${files//$'\n'/, } (stop $stops)…" >&2
    if ! result=$(cd "$wt" && HARNESS_CLAUDE_ALLOW=$allow && harness_run "$STEP_H" "$STEP_SID" "$STEP_MODE" "$STEP_TIMEOUT" \
                    "$guidance"$'\n\n'"$RESOLVE_CONTRACT"$'\n\nBranch: '"$b"$', rebasing onto '"$onto"$'\nTask: '"${task:-(none recorded)}"$'\nReplaying: '"$replaying"$'\n'"$replaying_stat"$'\n\n'"Commits being replayed, oldest first:"$'\n'"$replayed"$'\n\nConflicting files:\n'"$files"$'\n\nConflict hunks:\n'"$hunks$runs" \
                    "$RESOLVE_SCHEMA" "$STEP_CFG"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the $STEP_H step failed or returned no usable result (session $STEP_SID); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    step_store "$b"
    STEP_MODE=resume
    outcome=$(prc_val "$result" 'coalesce(outcome, "")')
    if [[ $outcome == already-on-target ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: wrong base: the agent says $replaying is already on $onto ($(prc_val "$result" 'coalesce(summary, "")')); rolled back to ${old_head:0:7}." \
           "If it's a merged parent's and the stack is linear, rebase past it by hand: git rebase --onto $onto ${replaying%% *} $b," \
           "then git update-ref refs/sheepdog/$b/base \$(git merge-base $onto $b)" >&2
      return 1
    fi
    if [[ $outcome != done ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the agent gave up: $(prc_val "$result" 'coalesce(summary, "")'); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    echo "$b (stop $stops): $(prc_val "$result" 'coalesce(summary, "")')"
    if ! after=$(worktree_tree "$wt"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: can't read what the agent changed in $wt; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    RESOLVE_TOUCHED+=$(git diff-tree -z -r --name-only --no-renames "$snap" "$after" | tr '\0' '\n')$'\n'
    if (cd "$wt" && grep -lE '^(<<<<<<< |>>>>>>> )' $files 2>/dev/null | grep -q .); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: conflict markers left in: $(cd "$wt" && grep -lE '^(<<<<<<< |>>>>>>> )' $files | tr '\n' ' '); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    git -C "$wt" add -A
    if GIT_EDITOR=true git -C "$wt" rebase --continue >/dev/null 2>&1; then return 0; fi
    if [[ ! -e $(git -C "$wt" rev-parse --git-path rebase-merge) && ! -e $(git -C "$wt" rev-parse --git-path rebase-apply) ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: git rebase --continue failed; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
  done
}

# parent_to_default <branch> <state>: once the branch is on the default branch,
# a sd-parent naming the merged parent only makes every later pass look up a
# dead PR. Rewrite it when the target is the default branch.
parent_to_default() {
  local b=$1 default target
  { read -r default; read -r target; } < <(prc_line 'values sync.default, sync.target' "$2")
  [[ $target == "$default" ]] || return 0
  [[ -n $(git config --get "branch.$b.sd-parent" || true) ]] || return 0
  git config "branch.$b.sd-parent" "$default"
  echo "sd-parent of $b is now $default"
}

lock_sweep "$branch"
case $verb in
  enroll) act_rs ;;
  unenroll) act_rs ;;
  forget) act_rs ;;
  unregister) act_rs ;;
  start) act_rs ;;
  implement) act_rs ;;
  address) act_rs ;;
  ack) act_rs ;;
  answer) answer ;;
  restack) if $resolve; then restack; else act_rs; fi ;;
  retarget) act_rs ;;
  push) act_rs ;;
  verify) act_rs ;;
  autofix) act_rs ;;
  ci-fix) act_rs ;;
  review) act_rs ;;
  describe) act_rs ;;
  ship) act_rs ;;
  trigger) act_rs ;;
  attach) act_rs ;;
  *) die "unknown verb: $verb" ;;
esac
