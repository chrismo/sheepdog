#!/usr/bin/env bash5
#
# sd watch - observe-only pass over every enrolled branch.
#
# Usage: sd watch [refresh [<branch>] | glyph [<path>] | vacuum [--dry-run] | status | install | uninstall]
#
#   (none)     for each repo in global git config sheepdog.repo: fetch, then
#              sd state every branch with branch.<name>.sheepdog=true. Writes a
#              glyph for the branch's worktree (shown by tab-status; none
#              when two same-named worktrees are on one branch), notifies
#              per the policy below, and records the pass. Also deletes
#              refs/sheepdog/<b>/* whose branch no longer exists (pins outlive
#              a branch -D), and the cached state of branches no longer
#              enrolled. For one that is gone too (gh pr merge --delete-branch
#              takes its enrollment), its PR's merge is notified if it wasn't.
#   refresh    the same check for one branch (default: the current one), now:
#              fetch its repo, glyph, notify, cache its state. Not a pass: other
#              branches and glyphs are left alone and status still shows the
#              last pass. Exits non-zero when the branch couldn't be checked.
#   glyph      [<path>] the glyph for the worktree holding <path> (default .),
#              if it's still on the branch the last check saw; for a shell
#              prompt or tab title (fast: no super, no GitHub)
#   vacuum     a pass that unenrolls every stale branch now, without waiting
#              for vacuumAfter, even when it is 0, so an open PR's branch that
#              no worktree holds goes too: prints each one unenrolled and its
#              reason, and each one sd state is unsure of, skipped, and why.
#              It doesn't notify its own unenrolls.
#              --dry-run: what vacuum would do, judged from each branch's last
#              saved check (one where sd state failed isn't saved; nothing is
#              fetched or changed), and when a pass would unenroll it
#   status     print the last pass
#   install    launchd job: a pass every settings.interval seconds (default 300)
#   uninstall  remove the job
#
# Glyphs: ❌ needs chrismo   ⚠️ state unknown   🔧 work for later   ⏳ waiting (CI, review)
#         ✅ ready to merge  🏁 merged          🚫 closed
#
# Notified, once per lib/next.sh step entered (again only after it clears):
#   ci-red ci-blocked conflict human foreign parent-closed restack-undone: ❌ the
#     PR is stuck or wrong
#     until chrismo, or an agent chrismo starts, deals with it
#   bot-silent: ❌ the review bot hasn't answered within settings.botTimeout
#   merged ready: chrismo acts (clean up, merge)
#   review-decide: ❌ the local review still blocks after
#     settings.reviewRounds rounds, or the agent declined its findings:
#     chrismo fixes them or accepts HEAD
#   budget: ❌ the branch's steps have spent past settings.branchBudget, so
#     no agent step runs on it until chrismo raises it or takes over
#   ci-config: ❌ an agent step's commit changed CI config, held unpushed
#     until chrismo reviews it and runs sd act push (#124)
# Not notified:
#   closed: chrismo closed it
#   errors stale: ⚠️ sd state can't be sure, so what was notified carries over
#   read: info-only bot items; nothing waits on them
#   reset-dirty take: chrismo is mid-change on the branch; the 🔧 glyph shows it
#   blocked: GitHub's branch rules, often routine; the 🔧 glyph shows it
#   attached: chrismo is in the branch's session; like merge-wait, keeps ready
#   bot: routine agent work, picked up when the branch is next worked on
#   review review-fix: the same
#   behind push open-pr ship-parent draft bot-trigger ci-rerun retarget: mechanical
#     (behind with no old base is chrismo's, but its errors step shows ⚠️ first)
#   ci-wait bot-wait review-wait parent-wait merge-wait: waiting; merge-wait (GitHub
#     recomputing after the base moved) keeps ready notified
# A notification that fails is tried once more, on the next pass that still
# shows its step, then given up on.
#
# Stale enrollments: a pass unenrolls a branch (git config only; never the
# branch, its pins, a worktree or a PR) with no local branch at once, and one
# merged, closed or checked out nowhere once it has been so for
# settings.vacuumAfter seconds (default 7 days; 0 turns off these three). A
# pass whose sd state reported errors or stale data neither starts, resets nor
# acts on that clock, and a new reason restarts it. Each timed unenroll
# notifies, once; one for no local branch is only a pass line. sd watch vacuum
# doesn't wait for the clock, vacuumAfter 0 included, but counts only these
# reasons and skips a branch sd state is unsure of, as a pass does.
#
# GitHub's rate limit: a pass checks no more branches after one whose sd
# state found less than settings.rateLimitFloor GraphQL points left (default
# 250), or had a call refused for the rate limit. Status says so with the
# reset time, and lists each branch not checked; those keep their glyphs and
# cached state. The housekeeping that asks GitHub's GraphQL nothing still
# runs. refresh checks its one branch either way.
#
# Env:    SHEEPDOG_STATE_DIR (~/.local/state/sheepdog), STATUS_DIR (~/.claude/tab-status)
#         LOCAL_BIN (~/.local/bin): where install finds the sd link the job runs
#         SHEEPDOG_WATCH_TIMEOUT (120): seconds a fetch or sd state may take
# Config: read with lib/config.sh, no branch file (global file over
#         built-in defaults): settings.notify, .interval, .remote, .vacuumAfter,
#         .rateLimitFloor.
#         notify — shell command, run with <title> <message> appended
#         (default: a macOS notification)

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/sheepdog.sh"
source "$(dirname "$(realpath "$0")")/../lib/config.sh"

STATE_DIR=${SHEEPDOG_STATE_DIR:-$HOME/.local/state/sheepdog}
STATUS_DIR=${STATUS_DIR:-$HOME/.claude/tab-status}
LABEL=com.sheepdog.watch
# Earlier labels: a machine still running one would run two watchers.
OLD_LABELS=(com.agent-rig.pr-watch com.pr-tend.pr-watch)
LAUNCH_AGENTS=${SHEEPDOG_WATCH_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}
TIMEOUT=${SHEEPDOG_WATCH_TIMEOUT:-120}
VACUUM_LOG=

read -r -d '' CLASSIFY <<'EOF' || true
values {next: kind(next) == "array" ? next : []}
| values {next, k: coalesce([unnest next | values key], []),
          red: coalesce([unnest next | where key in ["ci-red", "ci-blocked", "conflict", "human", "foreign", "parent-closed", "review-decide", "restack-undone", "bot-silent", "budget", "ci-config"] | values {key, msg: say}], []),
          waiting: len(coalesce([unnest next | where who != "wait"], [])) == 0}
| values {carry: len(next) == 0 or "errors" in k or "stale" in k,
          keep: k == ["merge-wait"] or k == ["attached"] ? ["ready"] : [], ...(case
    when len(next) == 0 then {glyph: "⚠️", reasons: [], note: "sd state gave no next steps"}
    when k == ["merged"] then {glyph: "🏁", reasons: [{key: "merged", msg: next[0].say}]}
    when k == ["closed"] then {glyph: "🚫", reasons: []}
    when len(red) > 0 then {glyph: "❌", reasons: red}
    when "errors" in k or "stale" in k then {glyph: "⚠️", reasons: []}
    when k == ["ready"] then {glyph: "✅", reasons: [{key: "ready", msg: next[0].say}]}
    when waiting then {glyph: "⏳", reasons: []}
    else {glyph: "🔧", reasons: []} end)}
EOF

# Notifier stdout would land in the pass record (check runs inside $(...)).
notify() {
  local cmd
  cmd=$(prc_get settings.notify "" true) || echo "sd watch: sd config failed; using the default notifier" >&2
  if [[ -n $cmd ]]; then
    sh -c "$cmd"' "$@"' _ "$1" "$2" </dev/null >&2 || { echo "sd watch: notify failed: $cmd" >&2; return 1; }
  else
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' "$1" "$2" </dev/null >/dev/null || { echo "sd watch: notify failed: osascript" >&2; return 1; }
  fi
}

write_glyph() { # write_glyph <worktree-or-empty> <branch> <glyph>
  [[ -n $1 ]] || return 0
  local f; f="$STATUS_DIR/$(basename "$1").pr"
  printf '%s\t%s\n' "$2" "$3" > "$f"
  echo "$f" >> "$WRITTEN"
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$GLYPHS"
}

# drop_ambiguous <index>: remove the <worktree>.pr file of a name two indexed
# worktrees share while on the same branch, when the file holds that branch:
# tab-status reads the file by name, and its branch check can't tell them
# apart (sd watch glyph can).
drop_ambiguous() {
  local base branch f
  while IFS=$'\t' read -r base branch; do
    f="$STATUS_DIR/$base.pr"
    [[ $(cut -f1 "$f" 2>/dev/null) != "$branch" ]] || rm -f "$f"
  done < <(awk -F'\t' '!seen[$1]++ { n = $1; sub(/.*\//, "", n); if (++c[n "\t" $2] == 2) print n "\t" $2 }' "$1" 2>/dev/null)
}

# glyph_of [<path>]: the glyph the last check left for the worktree holding
# <path> (default .), while it's still on the branch checked. No super, so a
# shell prompt can run it.
glyph_of() {
  local dir=${1:-.} top branch
  [[ -d $dir ]] || dir=$(dirname "$dir")
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 0
  branch=$(git -C "$top" symbolic-ref -q HEAD) || branch=$(rebase_head "$top") || return 0
  branch=${branch#refs/heads/}
  awk -F'\t' -v p="$top" -v b="$branch" '$1 == p && $2 == b { print $3; exit }' "$STATE_DIR/glyphs" 2>/dev/null || true
}

# check <repo> <name> <branch> <worktree-or-empty>. Runs inside $(...), where -e
# is off: every failure is handled explicitly.
check() {
  local repo=$1 name=$2 b=$3 wt=$4 json cls glyph state_file prev prev_failed key msg errf
  local carry reason since prev_since prev_reason now stale=null unenrolled= rl_limited rl_left rl_reset
  local -a sent=() failed=()
  errf=$(mktemp)
  if ! json=$(cd "$repo" && with_timeout "$TIMEOUT" sd-state --json "$b" 2>"$errf" </dev/null); then
    write_glyph "$wt" "$b" ⚠️
    printf '%s\t%s\t⚠️\tsd state failed: %s\n' "$name" "$b" "$(head -1 "$errf")"
    vacuum_log "$name" "$b" "skipped, sd state is unsure: sd state failed: $(head -1 "$errf")"
    rm -f "$errf"
    return 1
  fi
  rm -f "$errf"
  if ! cls=$(prc_json "$CLASSIFY" "$json" 2>/dev/null) || [[ -z $cls ]]; then
    write_glyph "$wt" "$b" ⚠️
    printf '%s\t%s\t⚠️\tunparseable sd state output\n' "$name" "$b"
    vacuum_log "$name" "$b" "skipped, sd state is unsure: unparseable sd state output"
    return 1
  fi
  glyph=$(prc_line 'values glyph' "$cls")
  read -r rl_limited rl_left rl_reset < <(prc_line 'values f"{on(rate_limit.limited)} {coalesce(rate_limit.remaining, "-")} {coalesce(rate_limit.reset_at, "-")}"' "$json")

  state_file="$(state_dir "$repo")/$b.json"
  mkdir -p "$(dirname "$state_file")"
  # An unreadable previous state re-notifies rather than silently dropping reasons.
  # notified is the keys already sent; files before it have only reasons.
  prev=$(prc_json 'values coalesce(notified, [unnest reasons | values key], [])' "$(cat "$state_file" 2>/dev/null)" 2>/dev/null) || prev='[]'
  [[ -n $prev ]] || prev='[]'
  prev_failed=$(prc_json 'values coalesce(failed, [])' "$(cat "$state_file" 2>/dev/null)" 2>/dev/null) || prev_failed='[]'
  [[ -n $prev_failed ]] || prev_failed='[]'
  while read -r key msg; do
    [[ -n $key ]] || continue
    if notify "$name $b" "$msg"; then
      sent+=("\"$key\"")
    elif [[ $prev_failed == *"\"$key\""* ]]; then
      echo "sd watch: giving up on: $msg" >&2
      sent+=("\"$key\"")
    else
      failed+=("\"$key\"")
    fi
  done < <(prc_line 'unnest {prev, r: c.reasons} | where not (r.key in prev) | values f"{r.key} {r.msg}"' "{\"prev\": $prev, \"c\": $cls}")
  carry=$(prc_line 'values carry' "$cls")
  read -r prev_since prev_reason < <(prc_line 'values coalesce(f"{stale.since} {stale.reason}", "")' "$(cat "$state_file" 2>/dev/null)" 2>/dev/null) || true
  now=$(date +%s)
  case $glyph in 🏁) reason=merged ;; 🚫) reason=closed ;; *) reason= ;; esac
  [[ -n $reason || -n $wt ]] || reason="checked out nowhere"
  if [[ $carry == true ]]; then
    since=$prev_since reason=$prev_reason
  elif [[ -n $reason && $reason == "$prev_reason" && -n $prev_since ]]; then
    since=$prev_since
  else
    since=${reason:+$now}
  fi
  if [[ -n $since ]]; then
    stale="{\"reason\": \"$reason\", \"since\": $since}"
    if [[ $carry != true ]] && { [[ -n ${VACUUM_LOG:-} ]] || (( ${VACUUM_AFTER:-0} > 0 && now - since >= VACUUM_AFTER )); }; then
      if git -C "$repo" config --unset "branch.$b.sheepdog"; then
        unenrolled="unenrolled: $reason for $(dur $(( now - since ))) (sd act enroll $b to watch it again)" stale=null
      else
        vacuum_log "$name" "$b" "couldn't unenroll: $reason for $(dur $(( now - since )))"
      fi
    fi
  fi
  if [[ $carry == true && -n ${VACUUM_LOG:-} ]]; then
    vacuum_log "$name" "$b" "skipped, sd state is unsure: $(prc_line 'values coalesce(c.note,
      sj([...coalesce(s.errors, []), ...coalesce(s.stale, [])], "; "), "its reasons couldn'"'"'t be read")' \
      "{\"c\": $cls, \"s\": $json}" 2>/dev/null)"
  fi

  # A refresh can overlap a pass: unlocked, so both may notify a new reason
  # and the slower may write the older state. Only the temp file is per-process.
  prc_json 'values {...c, state: s, stale: st,
                    failed: c.carry ? [...prev_failed, ...failed]
                      : [...failed, ...coalesce([unnest {k: c.keep, p: prev_failed} | where p in k | values p], [])],
                    notified: c.carry ? [...prev, ...sent]
                      : [...coalesce([unnest {k: c.keep, p: prev} | where p in k | values p], []),
                         ...coalesce([unnest {k: [...prev, ...sent], r: c.reasons} | where r.key in k | values r.key], [])]}' \
    "{\"c\": $cls, \"s\": $json, \"prev\": $prev, \"prev_failed\": $prev_failed, \"st\": $stale, \"sent\": [$(IFS=,; echo "${sent[*]}")], \"failed\": [$(IFS=,; echo "${failed[*]}")]}" > "$state_file.$$.tmp" \
    && mv "$state_file.$$.tmp" "$state_file" \
    || { rm -f "$state_file.$$.tmp"; echo "sd watch: couldn't save $state_file: its reasons will notify again" >&2; }

  write_glyph "$wt" "$b" "$glyph"
  printf '%s\t%s\t%s\t%s\n' "$name" "$b" "$glyph" \
    "$(prc_line 'values sj(coalesce([unnest [...reasons, {msg: coalesce(note, null)}] | where msg is not null | values msg], []), "; ")' "$cls")"
  if [[ -n $unenrolled ]]; then
    [[ -n ${VACUUM_LOG:-} ]] || notify "$name $b" "$unenrolled"
    printf '%s\t%s\t-\t%s\n' "$name" "$b" "$unenrolled"
    vacuum_log "$name" "$b" "$unenrolled"
  fi
  [[ -z ${RATE_STOP:-} ]] || rate_stop "$rl_limited" "$rl_left" "$rl_reset" > "$RATE_STOP"
}

# rate_stop <limited> <remaining> <reset_at, or ->: why the pass stops for
# GitHub's GraphQL quota, if it must. A refusal carries no reset time;
# GitHub's rate_limit endpoint, which costs nothing, has it.
rate_stop() {
  local why reset=$3
  if [[ $1 == true ]]; then why="GitHub refused a call for the rate limit"
  elif [[ $2 =~ ^[0-9]+$ ]] && (( $2 < RATE_FLOOR )); then why="GitHub rate limit: $2 points left, under settings.rateLimitFloor ($RATE_FLOOR)"
  else return 0; fi
  if [[ $reset == - ]]; then
    reset=$(with_timeout "$TIMEOUT" gh api rate_limit --jq '.resources.graphql.reset | todate' 2>/dev/null </dev/null) || reset=
  fi
  echo "$why: the branches below weren't checked${reset:+ (the quota resets at $reset)}"
}

# vacuum_log <name> <branch> <msg>: a line for sd watch vacuum, when one runs.
vacuum_log() { [[ -z ${VACUUM_LOG:-} ]] || printf '%s\t%s\t%s\n' "$@" >> "$VACUUM_LOG"; }

state_dir() { echo "$STATE_DIR/branches/$(basename "$1")-$(printf '%s' "$1" | shasum | cut -c1-8)"; }

# report_gone <repo> <name>: drop the state of each branch no longer enrolled.
# One that is gone too (gh pr merge --delete-branch takes the branch's config,
# enrollment and all) has its PR asked about once, and a merge not yet
# notified is. GitHub not answering, or a failed notification's one retry,
# keeps the state for the next pass.
report_gone() {
  local repo=$1 name=$2 dir f d b cached pr url api pull msg pr_state err
  dir=$(state_dir "$repo")
  [[ -d $dir ]] || return 0
  while IFS= read -r f; do
    b=${f#"$dir/"}; b=${b%.json}; err=
    [[ $(git -C "$repo" config "branch.$b.sheepdog") == true ]] && continue
    cached=$(cat "$f")
    pr=$(prc_line 'values coalesce(state.pr.number, "")' "$cached" 2>/dev/null) || pr=
    if [[ -n $pr ]] && ! git -C "$repo" rev-parse -q --verify "refs/heads/$b" >/dev/null \
       && [[ $(prc_line 'values "merged" in coalesce(notified, [unnest reasons | values key], [])' "$cached" 2>/dev/null) != true ]]; then
      # By URL, not {owner}/{repo}: gh's default repo may be a fork.
      url=$(prc_line 'values coalesce(state.pr.url, "")' "$cached" 2>/dev/null) || url=
      api="repos/{owner}/{repo}/pulls/$pr"
      [[ $url =~ ^https://[^/]+/([^/]+/[^/]+)/pull/([0-9]+)$ ]] && api="repos/${BASH_REMATCH[1]}/pulls/${BASH_REMATCH[2]}"
      err=$(mktemp)
      if ! pull=$(cd "$repo" && with_timeout "$TIMEOUT" gh api "$api" 2>"$err" </dev/null); then
        if ! grep -q 'HTTP 404' "$err"; then
          printf '%s\t%s\t⚠️\tbranch is gone; GitHub didn'"'"'t say what became of #%s\n' "$name" "$b" "$pr"
          rm -f "$err"
          continue
        fi
        printf '%s\t%s\t⚠️\tbranch is gone; GitHub has no #%s\n' "$name" "$b" "$pr"
      elif [[ $(prc_line 'values on(merged)' "$pull" 2>/dev/null) == true ]]; then
        msg="merged (#$pr); the local branch is already gone"
        printf '%s\t%s\t🏁\t%s\n' "$name" "$b" "$msg"
        if ! notify "$name $b" "$msg"; then
          if [[ $(prc_line 'values "merged" in coalesce(failed, [])' "$cached" 2>/dev/null) == true ]]; then
            echo "sd watch: giving up on: $msg" >&2
          else
            prc_json 'values {...this, failed: [...coalesce(failed, []), "merged"]}' "$cached" > "$f.$$.tmp" \
              && mv "$f.$$.tmp" "$f" \
              || { rm -f "$f.$$.tmp"; echo "sd watch: couldn't save $f: its merge will notify again" >&2; }
            rm -f "$err"
            continue
          fi
        fi
      else
        pr_state=$(prc_line 'values coalesce(state, "unknown")' "$pull" 2>/dev/null)
        printf '%s\t%s\t%s\tbranch is gone; #%s is %s, not merged\n' "$name" "$b" \
          "$([[ $pr_state == closed ]] && echo 🚫 || echo ⚠️)" "$pr" "$pr_state"
      fi
    fi
    rm -f "$f" ${err:+"$err"}
    d=$(dirname "$f")
    while [[ $d != "$dir" ]] && rmdir "$d" 2>/dev/null; do d=$(dirname "$d"); done
  done < <(find "$dir" -name '*.json' -type f)
  return 0
}

# sweep_pins <repo>: delete refs/sheepdog/<b>/* whose branch no longer exists.
# Refs outlive `git branch -D` (config doesn't); the pin's last path component
# is its kind (base, local, bot, accepted), the rest is the branch name.
sweep_pins() {
  local ref b
  while read -r ref; do
    b=${ref#refs/sheepdog/}; b=${b%/*}
    git -C "$1" rev-parse -q --verify "refs/heads/$b" >/dev/null 2>&1 || echo "delete $ref"
  done < <(git -C "$1" for-each-ref --format='%(refname)' refs/sheepdog/) \
    | git -C "$1" update-ref --stdin
}

# fetch <repo> <name>: fetch settings.remote, printing a pass line for a
# failure. Returns 1 when the remote can't be read, so nothing should be checked.
fetch() {
  local remote err
  if ! remote=$(cd "$1" && prc_get settings.remote "" true); then
    printf '%s\t-\t⚠️\tsd config failed\n' "$2"
    return 1
  fi
  if ! err=$(with_timeout "$TIMEOUT" git -C "$1" fetch --prune --quiet "$remote" 2>&1 </dev/null); then
    printf '%s\t-\t⚠️\tfetch from %s failed: %s\n' "$2" "$remote" "${err%%$'\n'*}"
  fi
}

# rebase_head <worktree>: the branch a rebase paused there is rebasing.
rebase_head() {
  local gd head
  gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  head=$(cat "$gd/rebase-merge/head-name" 2>/dev/null || cat "$gd/rebase-apply/head-name" 2>/dev/null) || return 1
  [[ $head == refs/heads/* ]] || return 1
  echo "${head#refs/heads/}"
}

# load_worktrees <repo>: worktree_of[<branch>] is the worktree it's checked out
# in, counting one paused mid-rebase of it (listed as detached), and not one
# whose directory is gone (rm -rf leaves git listing it).
load_worktrees() {
  local key val wt_path head
  declare -gA worktree_of=()
  while read -r key val; do
    case $key in
      worktree) wt_path=$val ;;
      branch) if [[ -d $wt_path ]]; then worktree_of[${val#refs/heads/}]=$wt_path; fi ;;
      detached) if head=$(rebase_head "$wt_path"); then worktree_of[$head]=$wt_path; fi ;;
    esac
  done < <(git -C "$1" worktree list --porcelain)
}

# dur <seconds>: whole days, else hours, minutes or seconds; a negative
# span (a clock running behind) reads 0s.
dur() {
  local s=$(( $1 < 0 ? 0 : $1 ))
  if (( s >= 86400 )); then echo "$(( s / 86400 ))d"
  elif (( s >= 3600 )); then echo "$(( s / 3600 ))h"
  elif (( s >= 60 )); then echo "$(( s / 60 ))m"
  else echo "${s}s"; fi
}

enrolled_branches() {
  git -C "$1" config --get-regexp '^branch\..*\.sheepdog$' 2>/dev/null \
    | awk '$2 == "true" { sub(/^branch\./, "", $1); sub(/\.sheepdog$/, "", $1); print $1 }'
}

run_pass() {
  mkdir -p "$STATE_DIR" "$STATUS_DIR"
  # The index's temp file sits beside it, so the mv is a rename a prompt never
  # sees half done.
  WRITTEN=$(mktemp) GLYPHS=$(mktemp "$STATE_DIR/glyphs.XXXXXX") RATE_STOP=$(mktemp) SKIPPED=$(mktemp)
  trap 'rm -f "$WRITTEN" "$GLYPHS" "$RATE_STOP" "$SKIPPED" ${VACUUM_LOG:+"$VACUUM_LOG"}' EXIT
  local -a repos branches
  local repo name b lines="" out stopped="" stop_line="" wt row
  mapfile -t repos < <(git config --global --get-all sheepdog.repo || true)
  # A config failure is reported per repo by fetch, which then skips it.
  VACUUM_AFTER=$(prc_get settings.vacuumAfter "" true 2>/dev/null) || VACUUM_AFTER=0
  RATE_FLOOR=$(prc_get settings.rateLimitFloor "" true 2>/dev/null) || RATE_FLOOR=0

  for repo in "${repos[@]}"; do
    [[ -d $repo ]] || continue
    name=$(basename "$repo")
    mapfile -t branches < <(enrolled_branches "$repo")
    sweep_pins "$repo"
    local -a kept=()
    for b in "${branches[@]}"; do
      if git -C "$repo" rev-parse -q --verify "refs/heads/$b" >/dev/null; then
        kept+=("$b")
      elif git -C "$repo" config --unset "branch.$b.sheepdog"; then
        lines+="$name"$'\t'"$b"$'\t-\tunenrolled: no local branch\n'
        vacuum_log "$name" "$b" "unenrolled: no local branch"
      fi
    done
    branches=("${kept[@]}")
    out=$(report_gone "$repo" "$name") || true
    [[ -z $out ]] || lines+=$out$'\n'
    (( ${#branches[@]} )) || continue

    if [[ -z $stopped ]]; then
      if ! out=$(fetch "$repo" "$name"); then
        lines+=$out$'\n'
        for b in "${branches[@]}"; do vacuum_log "$name" "$b" "skipped: ${out##*$'\t'}"; done
        continue
      fi
      [[ -z $out ]] || lines+=$out$'\n'
    fi
    load_worktrees "$repo"

    for b in "${branches[@]}"; do
      if [[ -n $stopped ]]; then
        lines+=$stop_line"$name"$'\t'"$b"$'\t-\tnot checked: rate limit\n' stop_line=""
        printf '%s\t%s\n' "${worktree_of[$b]:-}" "$b" >> "$SKIPPED"
        vacuum_log "$name" "$b" "skipped, not checked: GitHub rate limit"
        continue
      fi
      lines+=$(check "$repo" "$name" "$b" "${worktree_of[$b]:-}")$'\n' || true
      if [[ -s $RATE_STOP ]]; then stopped=$(cat "$RATE_STOP") stop_line="$name"$'\t-\t⚠️\t'"$stopped"$'\n'; fi
    done
  done

  # The branches not checked keep their glyphs, files and index rows both.
  local f
  while IFS= read -r row; do
    printf '%s\n' "$row" >> "$GLYPHS"
    wt=${row%%$'\t'*}
    echo "$STATUS_DIR/$(basename "$wt").pr" >> "$WRITTEN"
  done < <(awk -F'\t' 'FILENAME == ARGV[1] { keep[$1 FS $2]; next } ($1 FS $2) in keep' "$SKIPPED" "$STATE_DIR/glyphs" 2>/dev/null)
  for f in "$STATUS_DIR"/*.pr; do
    [[ -e $f ]] || continue
    grep -qxF "$f" "$WRITTEN" || rm -f "$f"
  done
  drop_ambiguous "$GLYPHS"
  mv "$GLYPHS" "$STATE_DIR/glyphs"
  { date '+last pass: %Y-%m-%d %H:%M:%S'; printf '%s' "$lines"; } > "$STATE_DIR/last-pass"
}

die() { echo "sd watch: $*" >&2; exit 1; }

show() { sed "s/$(printf '\t')/  /g"; }

usage() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }

refresh() {
  (( $# <= 1 )) || die "usage: sd watch refresh [<branch>]"
  case ${1:-} in
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
  esac
  local b=${1:-} repo name out line rc=0
  git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"
  if [[ -z $b ]]; then
    b=$(git symbolic-ref -q --short HEAD) || die "not on a branch: name one (sd watch refresh <branch>)"
  fi
  git rev-parse -q --verify "refs/heads/$b" >/dev/null || die "no such branch: $b"
  [[ $(git config "branch.$b.sheepdog") == true ]] || die "$b isn't enrolled (sd act enroll $b)"
  # The repo as enroll registered it, so a pass and a refresh share the branch's state.
  repo=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  grep -qxF "$repo" <<<"$(git config --global --get-all sheepdog.repo || true)" \
    || die "$repo isn't registered, so the pass doesn't watch it (sd act enroll $b)"
  prc_super_init || exit 1
  name=$(basename "$repo")
  mkdir -p "$STATE_DIR" "$STATUS_DIR"
  WRITTEN=/dev/null GLYPHS=$(mktemp "$STATE_DIR/glyphs.XXXXXX") GLYPHS_NEW=$(mktemp "$STATE_DIR/glyphs.XXXXXX")
  trap 'rm -f "$GLYPHS" "$GLYPHS_NEW"' EXIT
  out=$(fetch "$repo" "$name") || { show <<<"$out"; exit 1; }
  VACUUM_AFTER=$(cd "$repo" && prc_get settings.vacuumAfter "" true) || VACUUM_AFTER=0
  [[ -z $out ]] || show <<<"$out"
  load_worktrees "$repo"
  line=$(check "$repo" "$name" "$b" "${worktree_of[$b]:-}") || rc=1
  # Unlocked like the state file: a pass that finishes between this read and
  # the mv loses to the older index until the next pass. Other worktrees' rows
  # are the last pass's, so drop_ambiguous can drop a .pr file for a twin
  # that has since gone, and check has already written the shared file; the
  # next pass settles both.
  if [[ -s $GLYPHS ]]; then
    { awk -F'\t' -v p="${worktree_of[$b]}" '$1 != p' "$STATE_DIR/glyphs" 2>/dev/null; cat "$GLYPHS"; } > "$GLYPHS_NEW" \
      && mv "$GLYPHS_NEW" "$STATE_DIR/glyphs"
    drop_ambiguous "$STATE_DIR/glyphs"
  fi
  show <<<"$line"
  return $rc
}

vacuum() {
  VACUUM_LOG=$(mktemp)
  run_pass
  if [[ -s $VACUUM_LOG ]]; then show < "$VACUUM_LOG"; else echo "nothing stale"; fi
}

# vacuum_preview: what vacuum would do to each enrolled branch, from cached
# state, and when a pass would.
vacuum_preview() {
  local -a repos branches
  local repo name b after f carry since reason now out=""
  now=$(date +%s)
  after=$(prc_get settings.vacuumAfter "" true) || die "sd config failed"
  mapfile -t repos < <(git config --global --get-all sheepdog.repo || true)
  for repo in "${repos[@]}"; do
    [[ -d $repo ]] || continue
    name=$(basename "$repo")
    mapfile -t branches < <(enrolled_branches "$repo")
    for b in "${branches[@]}"; do
      if ! git -C "$repo" rev-parse -q --verify "refs/heads/$b" >/dev/null; then
        out+="$name"$'\t'"$b"$'\tno local branch: vacuum unenrolls it, as does the next pass\n'
        continue
      fi
      f="$(state_dir "$repo")/$b.json"
      if [[ ! -f $f ]]; then
        out+="$name"$'\t'"$b"$'\tnot checked yet: vacuum checks it first\n'
        continue
      fi
      carry= since= reason=
      read -r carry since reason < <(prc_line 'values f"{coalesce(carry, false)} {coalesce(stale.since, "")} {coalesce(stale.reason, "")}"' \
        "$(cat "$f")" 2>/dev/null) || true
      if [[ $carry == true ]]; then
        out+="$name"$'\t'"$b"$'\tunsure at the last saved check: vacuum skips it if sd state still is\n'
        continue
      fi
      [[ -n $since ]] || continue
      out+="$name"$'\t'"$b"$'\t'"$reason for $(dur $(( now - since ))): vacuum unenrolls it"
      if (( after == 0 )); then out+=$'; a pass doesn\'t (vacuumAfter 0)\n'
      elif (( now - since >= after )); then out+=$', as does the next pass\n'
      else out+="; a pass, after $(dur "$after")"$'\n'; fi
    done
  done
  if [[ -n $out ]]; then printf '%s' "$out" | show; else echo "nothing stale"; fi
}

plist_path() { echo "$LAUNCH_AGENTS/$LABEL.plist"; }

xml() { local v=${1//&/\&amp;}; v=${v//</\&lt;}; printf '%s' "${v//>/\&gt;}"; }

install_job() {
  local plist bindir path prog interval tmp
  plist=$(plist_path)
  bindir=${LOCAL_BIN:-$HOME/.local/bin}
  # launchd runs the job from /, so a relative LOCAL_BIN is resolved here.
  [[ $bindir == /* || ! -d $bindir ]] || bindir=$(cd "$bindir" && pwd)
  prog="$bindir/sd"
  # ~/.local/bin stays on PATH: bash5 and claude are linked there.
  path="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
  [[ $bindir == "$HOME/.local/bin" ]] || path="$bindir:$path"
  [[ -x $prog ]] || prog=$(realpath "$(dirname "$(realpath "$0")")/../bin/sd")
  interval=$(prc_get settings.interval "" true) || { echo "sd watch: sd config failed" >&2; exit 1; }
  [[ $interval =~ ^[1-9][0-9]*$ ]] || { echo "sd watch: settings.interval must be whole seconds: $interval" >&2; exit 1; }
  mkdir -p "$LAUNCH_AGENTS" "$STATE_DIR"
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(xml "$prog")</string><string>watch</string></array>
  <key>StartInterval</key><integer>$interval</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml "$path")</string>
  </dict>
  <key>StandardOutPath</key><string>$(xml "$STATE_DIR/launchd.log")</string>
  <key>StandardErrorPath</key><string>$(xml "$STATE_DIR/launchd.log")</string>
</dict>
</plist>
EOF
  plutil -lint -s "$tmp" || { rm -f "$tmp"; echo "sd watch: generated plist is invalid" >&2; exit 1; }
  mv "$tmp" "$plist"
  retire_old_labels
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "installed $plist (every ${interval}s)"
}

retire_old_labels() {
  local l
  for l in "${OLD_LABELS[@]}"; do
    launchctl bootout "gui/$(id -u)/$l" 2>/dev/null || true
    rm -f "$LAUNCH_AGENTS/$l.plist"
  done
}

uninstall_job() {
  retire_old_labels
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$(plist_path)"
  echo "uninstalled $LABEL"
}

case ${1:-} in
  "") prc_super_init || exit 1; run_pass ;;
  refresh) shift; refresh "$@" ;;
  glyph)
    (( $# <= 2 )) || die "usage: sd watch glyph [<path>]"
    case ${2:-} in
      -h|--help) usage ;;
      -*) die "unknown option: $2" ;;
      *) glyph_of "${2:-}" ;;
    esac ;;
  vacuum)
    case $#:${2:-} in
      1:) prc_super_init || exit 1; vacuum ;;
      2:--dry-run) prc_super_init || exit 1; vacuum_preview ;;
      2:-h|2:--help) usage ;;
      *) die "usage: sd watch vacuum [--dry-run]" ;;
    esac ;;
  status)
    if [[ -f $STATE_DIR/last-pass ]]; then show < "$STATE_DIR/last-pass"; else echo "no pass yet"; fi ;;
  install) prc_super_init || exit 1; install_job ;;
  uninstall) uninstall_job ;;
  -h|--help) usage ;;
  *) echo "sd watch: unknown command: $1" >&2; exit 1 ;;
esac
