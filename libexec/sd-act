#!/usr/bin/env bash5
#
# sd act - verbs that change a branch's PR.
#
# Usage:
#   sd act start    [--parent <branch>] [--harness <h>] [--no-implement] <name> [<task>]
#   sd act implement [--harness <h>] [<branch>]
#   sd act enroll   [<branch>]
#   sd act unenroll [<branch>]
#   sd act forget   [<branch>]
#   sd act unregister [--force] [<path>]
#   sd act address  [--force] [--no-publish] [--harness <h>] [<branch>]
#   sd act ack      [--id <id>]... [<branch>]
#   sd act restack  [--force] [--resolve] [<branch>]
#   sd act retarget [<branch>]
#   sd act push     [--force] [<branch>]
#   sd act verify   [<branch>]
#   sd act autofix  [<branch>]
#   sd act ci-fix   [--force] [--no-publish] [--harness <h>] [<branch>]
#   sd act review   [--accept] [<branch>]
#   sd act describe [<branch>]
#   sd act ship     [--force] [<branch>]
#   sd act trigger  [--force] [<branch>]
#   sd act attach   [--force] [--harness <h>] [<branch>]
#
# Examples:
#   cd "$(sd act start fix-login "Fix the login redirect")"   worktree, then the agent builds it
#   sd act start --no-implement --parent fix-login fix-login-tests
#   sd act enroll                      sd watch starts tracking this branch
#   sd act address --no-publish        the agent fixes locally; nothing pushed or posted
#   sd act address --harness pi
#   sd act ack                         after reading sd state --long: the i items are done
#   sd act restack && sd act push      catch up with the parent, then publish
#   sd act restack --resolve           the same, with the agent resolving conflicts
#   sd act review                      verify, then the local reviewer; clean pins local
#   sd act ship                        describe, push, open a draft PR, enroll
#   sd act attach                      open the branch's session yourself; agent steps wait
#
# Verbs:
#   start     a worktree beside the main one, named after <name> with
#             slashes as dashes, on the branch <name> (an existing local
#             branch; else origin/<name>, tracked; else new, off the fetched
#             default branch or --parent). Runs the repo's setup hook
#             there, as wt-new does: $GIT_COMMON_DIR/worktree-setup, else git
#             config wt.setup. Records the task and parent, pins base at a new
#             branch's start point, enrolls; then implement unless
#             --no-implement. stdout is only the worktree's path. Spends
#             tokens unless --no-implement
#   implement the agent works the recorded task (J0) in the branch's session;
#             the pipeline commits its edits, then runs verify. Claude may run
#             only read-only git, the verify command when it's plain words (no
#             globs, pipes or quotes), and settings.implementAllow's rules; pi
#             runs nothing. "needs-input" prints the agent's question and
#             leaves the edits uncommitted, for chrismo to answer in the
#             session (sd act attach). Review findings recorded on HEAD (sd
#             act review) go into the prompt, each answered on its own (see
#             review). Spends tokens
#   enroll    mark the branch for sd watch, and register this repo; for a
#             stacked PR, store its parent and base before a merge erases them
#             (or warn that git can't find the base, and how to pin it);
#             with no PR and no sd-parent, store the branch it was made from by
#             a plain git branch (#94), or say why git can't pick one (a tie,
#             or a parent that moved on) and store nothing
#   unenroll  clear the mark
#   forget    the branch is done (merged, abandoned): unenroll it and delete
#             its refs/sheepdog/<branch>/* pins, which outlive a branch -D
#   unregister  take this repo (or <path>, e.g. one that's gone) off the
#             watcher's list; refuses while any branch is still enrolled
#   address   hand owed bot feedback to an agent, then commit, verify, push,
#             reply and resolve; items the agent marks "ask" are left for
#             chrismo. Replies are posted with /commands and @mentions
#             defanged. Spends tokens
#   ack       mark owed bot review bodies and comments read, with no reply:
#             every i item, or only the --id ones (ids from sd state --json)
#   restack   rebase --onto the parent (the default branch once the parent
#             merged), check the branch's own change came through unchanged,
#             else roll back; never pushes. When the old base isn't an
#             ancestor but HEAD fully holds the merged parent (sync.by_tree),
#             it goes by tree merge instead: one commit, committed by
#             whoever runs it. Once the branch lands on the
#             default branch, sd-parent is rewritten to it, unless the PR
#             still targets the parent (retarget does that) or can't be
#             read. A conflict is
#             refused, or with --resolve handed to the agent (J1): it edits
#             the conflicting files in the branch's session, the pipeline
#             adds and continues, up to 3 stops; an agent that finds the
#             replayed commit already on the target rolls it back as a wrong
#             base. A resolved rebase skips the
#             unchanged-change check (a resolution changes the diff), so its
#             result is unreviewed: verify runs, then sd act review is next
#   retarget  after the parent merged: point the PR at the default branch
#             (gh pr edit --base; GitHub usually did it already when the
#             parent's branch was deleted) and rewrite sd-parent to it
#   push      publish: a plain push for new commits; rewritten history, or a
#             pushed commit reset away, is force-pushed with a lease, only
#             over a remote head of our own.
#             Never over commits this copy has never had, --force or not.
#             A reset-away drop is refused when a dropped commit wasn't
#             authored and committed here (take it back with merge
#             --ff-only), or when the worktree has uncommitted or untracked
#             changes (a soft or mixed reset: commit or remove them first).
#             Releases a CI config hold: chrismo pushing is the approval
#   verify    run settings.verify in the branch's worktree, zero tokens. Pass:
#             one line. Fail: nonzero, the output trimmed to its last 40 lines
#             for the fix step. A command that changes the tree fails too.
#             Gates local review and everything after it
#   autofix   run settings.autofix (formatters, lint --fix) in the branch's
#             worktree, zero tokens, and commit what it changed ("autofix:
#             <command>"). Nothing to commit: says so. A failing command is
#             nonzero with its output's tail, its changes left uncommitted.
#             implement and address run it when verify fails, then verify
#             again (A11), and ci-fix runs it first
#   ci-fix    CI is red on HEAD: verify and autofix first (zero tokens; a
#             fix there is pushed as is), else hand the agent the failing
#             checks, their logs (commit statuses and check runs over REST;
#             rwx results/logs for RWX, gh run view --log-failed for GitHub
#             Actions) and the local verify output, in the branch's session
#             (J2). The pipeline commits its fix, verifies, pushes. "flaky"
#             (the agent blames CI's environment) commits nothing and is
#             recorded against the red SHA, so the same red isn't handed
#             over again: rerun CI instead. Refuses on an old head or with
#             unpushed commits (push first) and on cancelled CI (rerun it).
#             Spends tokens
#   review    verify, then the local reviewer (settings.localReview, default
#             libexec/sd-review-local) over the branch's own change, base..HEAD.
#             Clean, or only nits: pin local at HEAD. Errors or warnings:
#             printed as JSON and recorded (refs/sheepdog/<b>/findings: head,
#             base, round, findings; implement adds each finding's id, action
#             and reply), nothing pinned; each such review of a changed HEAD
#             is the next round, until a pin clears the record. A failed
#             reviewer is never clean. sd state shows the record and NEXT
#             follows it: findings about HEAD (the same change, even rebased)
#             go to the agent (review-fix: sd act implement, its prompt
#             carrying the ones it hasn't declined) below
#             settings.reviewRounds. The agent answers each: fixed, declined
#             (with why) or ask. Any ask goes to chrismo as needs-input does,
#             nothing committed; otherwise its fixes are committed and the
#             next round is due, or with every finding declined, chrismo
#             decides (review-decide), as at the cap; findings on an older
#             head get a new review. sd state's flags (suppressions, skips,
#             edited tests) are printed on stderr for chrismo, whatever the
#             verdict; never a gate. Not stored with the record or the pin:
#             sd state recomputes them from base..HEAD on every call, so they
#             outlive stderr and never go stale. Spends tokens.
#             --accept: pin accepted at HEAD instead, reviewing nothing (HEAD
#             is reviewed enough), and drop the findings
#   describe  the agent writes the PR title and body (J6) from the task, the
#             commits and the diff, read-only, in the branch's session; stored
#             for HEAD and the PR's target. Spends tokens
#   ship      describe unless one for HEAD and the target is stored, check
#             HEAD didn't move, push, then open a draft PR on the parent
#             (sd-parent, else the PR's base, else with no PR the branch it
#             was made from, stored as enroll does, else the default branch)
#             and enroll; with a PR already open, fix up its title, body and
#             base instead. Warns when the local review doesn't cover HEAD;
#             the draft stays a draft until it does. Refuses when git can't
#             pick the branch it was made from, and while the parent isn't on
#             the remote, has merged (restack first), was closed, or can't be
#             looked up; a merged parent with the branch already on the
#             default branch ships onto it and rewrites sd-parent. Spends
#             tokens unless a description for HEAD and the target is stored
#   trigger   post settings.botCommand on the PR so the review bot runs, and
#             pin bot at HEAD, recording when (sd state then waits on the
#             bot's reply); nothing when already pinned there. HEAD must
#             be on the remote (the bot reviews what GitHub has); the local
#             review not covering HEAD is a soft refusal
#   attach    takeover (A9): hold branch.<b>.sd-lock, open the branch's
#             session interactively in its worktree (claude --resume, or pi
#             --session-id; a new session when none is stored, kept once the
#             harness wrote its transcript), with the harness block's model,
#             effort, provider and args, and for claude without
#             ANTHROPIC_API_KEY unless useApiKey; release the lock when the session
#             exits, Ctrl-C included. While the lock is held, agent steps
#             (implement, address, restack --resolve, review, describe) and
#             the verbs that publish refuse to run; verify and the rest of
#             sd state's mechanics go on. A lock whose process is gone from
#             this host is stale, and every sd act verb clears it first
#
# CI config hold (#124): when the commit of an agent step that edits
# (implement and its review-fix rounds, address, ci-fix, restack --resolve)
# touches a protected path, the branch is held: address, ci-fix and ship
# don't push it, --force or not, and sd state's NEXT is chrismo's: review,
# then sd act push, which releases it. A later agent commit there holds it
# again. Protected paths: settings.protectedPaths; else
# .sheepdog/protected-paths in the base commit (one per line, # comments);
# else .github/workflows/ .github/actions/ .rwx/ .captain/ .circleci/
# .gitlab-ci.yml .buildkite/; unless the setting is set,
# .sheepdog/protected-paths itself too. Each covers itself and what's under it.
#
# --force:
#   address         run even if the branch is unpushed, diverged or taken over
#   restack, push, ship   run even if taken over
#   implement, review, describe   the same
#   attach          take over a lock another attach still holds
#   ci-fix          run again on a red the agent already called flaky
#   trigger         even when the local review doesn't cover HEAD, or the bot
#                   is already pinned at HEAD (trigger it again)
#   unregister      even with branches still enrolled (the watcher drops them)
#
# start options:
#   --parent <b>    start from <b> (local, else origin/<b>) and stack on it
#   --no-implement  stop after the setup; the task is then optional
#
# restack options:
#   --resolve       on a conflict, run the agent instead of refusing. Spends tokens
#
# address options:
#   --no-publish    stop after the local commit (the agent still runs: tokens);
#                   also ci-fix
#   --harness <h>   claude (default) or pi; remembered for the branch (also
#                   start, implement)
#
# Config (sd config show):
#   settings  remote, verify, autofix, stepTimeout, stepBudget, forkLimit (a
#             session with more context starts over), replyPrefix, botLogin, implementAllow,
#             protectedPaths,
#             <step>Prompt for implement, reviewFix, review, describe, address,
#             resolve, ciFix (a file; else .sheepdog/<step>.md in the base
#             commit, kebab-cased, else the shipped lib/prompts/<step>.md)
#   harness   model, effort, provider (pi), args
#
# State (git config): branch.<b>.sheepdog, .sd-task, .sd-parent, .sd-session,
# .sd-harness, .sd-handled, .sd-lock ("<pid>@<host> <time>" while attached),
# .sd-ci-fix ("<sha> fixed|flaky|autofix", the last red ci-fix handled),
# .sd-bot-triggered (when trigger's comment was posted, by GitHub's clock),
# .sd-held (the CI config hold: the commit, then the paths, one per line);
# sheepdog.repo (global) lists the enrolled repos.
#
# <branch> defaults to the current one.

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/sheepdog.sh"
source "$(dirname "$(realpath "$0")")/../lib/config.sh"
SD_LIB=$(dirname "$(realpath "$0")")/../lib

die() { echo "sd act: $*" >&2; exit 1; }
help() { sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; }
usage() { help >&2; exit 1; }

(( $# )) || usage
verb=$1; shift
if [[ $verb == -h || $verb == --help ]]; then help; exit 0; fi

force=false accept=false no_publish=false resolve=false no_implement=false harness_opt="" parent_opt="" branch=""
ids=() positionals=()
while (( $# )); do
  case $1 in
    --force) force=true ;;
    --accept) accept=true ;;
    --no-publish) no_publish=true ;;
    --resolve) resolve=true ;;
    --no-implement) no_implement=true ;;
    --parent) (( $# > 1 )) || die "--parent needs a value"; parent_opt=$2; shift ;;
    --harness) (( $# > 1 )) || die "--harness needs a value"; harness_opt=$2; shift ;;
    --id) (( $# > 1 )) || die "--id needs a value"; ids+=("$2"); shift ;;
    -*) die "unknown option: $1" ;;
    *) branch=$1; positionals+=("$1") ;;
  esac
  shift
done

prc_super_init || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
task_arg=""
if [[ $verb == start ]]; then
  (( ${#positionals[@]} >= 1 && ${#positionals[@]} <= 2 )) \
    || die "usage: sd act start [--parent <branch>] [--harness <h>] [--no-implement] <name> [<task>]"
  branch=${positionals[0]} task_arg=${positionals[1]:-}
fi
if $accept && [[ $verb != review ]]; then die "--accept is for sd act review only"; fi
positional=$branch
branch=${branch:-$(git branch --show-current)}
[[ -n $branch ]] || die "detached HEAD; name a branch"

# ── address ──────────────────────────────────────────────────────────────────

# Hard refusals (no PR, closed, GitHub unreadable) can't be forced; soft ones
# can; warnings never block. A list of {hard}, {soft} and {warn} records.
read -r -d '' GATE <<'EOF' || true
values [
  nul(pr) ? {hard: f"no PR for {branch}"}
  : on(pr.state != "OPEN") ? {hard: f"PR #{pr.number} is {lower(pr.state)}"}
  : nul(threads.owed_bot) ? {hard: f"can't read the PR from GitHub: {sj(coalesce(errors, []), "; ")}"}
  : null,
  on(session.locked) ? {soft: f"taken over (branch.{branch}.sd-lock is set)"} : null,
  on(sync.conflict) ? {soft: "restack due, and it would conflict"}
  : nul(sync.up_to_date) ? {soft: f"sync with {coalesce(sync.target, "the parent")} unknown"}
  : null,
  nul(push.remote_sha) ? {soft: "not pushed"}
  : on(push.diverged) ? {soft: "diverged from the remote branch"}
  : n(push.behind) > 0 ? {soft: f"the remote branch has {push.behind} commit(s) you don't"}
  : n(push.ahead) > 0 ? {soft: f"{push.ahead} unpushed commit(s)"}
  : null,
  on(sync.up_to_date == false) and not on(sync.conflict) ? {warn: f"behind {sync.target} by {sync.behind}"} : null,
  on(ci.verdict == "pending") ? {warn: "CI is still running"} : null
]
| values coalesce([unnest this | where this is not null], [])
EOF

read -r -d '' NODES_Q <<'EOF' || true
query($ids: [ID!]!) {
  viewer { login }
  nodes(ids: $ids) {
    __typename
    ... on PullRequestReviewThread { id path line isOutdated
      comments(first: 50) { nodes { author { __typename login } body } } }
    ... on PullRequestReview { id url author { __typename login } body }
    ... on IssueComment { id url author { __typename login } body }
  }
}
EOF

read -r -d '' SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "commit_message", "summary", "items"],
 "properties": {
   "outcome": {"enum": ["done", "needs-input", "gave-up"]},
   "commit_message": {"type": ["string", "null"]},
   "summary": {"type": "string"},
   "items": {"type": "array", "items": {"type": "object", "required": ["id", "action", "reply"],
     "properties": {"id": {"type": "string"},
                    "action": {"enum": ["fixed", "reply", "pushback", "ask"]},
                    "reply": {"type": "string"}}}}}}
EOF

# The address step's prompt: guidance (settings.addressPrompt, else
# .sheepdog/address.md in the base commit, else lib/prompts/address.md), then
# this contract, which the schema, the posting and the pipeline rely on.
read -r -d '' ADDRESS_CONTRACT <<'EOF' || true
For each finding below, pick exactly one action:
- fixed:    you changed code to address it
- reply:    no change needed (already handled, or a question you can answer)
- pushback: you disagree; say why
- ask:      it needs a decision from the PR's author; say what the question is

Do not commit, push, or run gh: the pipeline commits your edits, runs checks,
pushes, and posts each `reply` on the PR. A /word or @login in a reply is posted
with a lookalike glyph so it can't trigger a bot or ping anyone; for a path,
use a relative one. Return one item per finding id, a one-line commit_message
if you changed anything (else null), and outcome "done", "needs-input"
(anything you marked ask) or "gave-up" (you couldn't make sense of it; nothing
is posted).
EOF

# The owed items' text, from the nodes(ids:) answer: {bots, n}. Anyone else
# in a thread is untrusted: their text would steer edits that verify runs and
# the push publishes.
read -r -d '' FINDINGS_Q <<'EOF' || true
fn unbot(s): regexp_replace(s, "\\[bot\\]$", "")
values {ctx: {me: n.data.viewer.login, bots: coalesce([unnest bots | values unbot(this)], [])},
        nodes: coalesce([unnest n.data.nodes | where this is not null], [])}
| values coalesce([
    unnest {ctx, x: nodes}
    | values {ctx, f: {
        id: x.id,
        type: case x.__typename when "PullRequestReviewThread" then "thread"
                                when "PullRequestReview" then "review"
                                when "IssueComment" then "comment" else null end,
        url: coalesce(x.url, null), path: coalesce(x.path, null), line: coalesce(x.line, null),
        outdated: coalesce(x.isOutdated, null),
        conversation: coalesce([
          unnest (coalesce(x.comments.nodes, null) is not null ? x.comments.nodes : [x])
          | values {author: author.login, bot: author.__typename == "Bot", body}
        ], [])}}
    | values {f, untrusted: coalesce([
        unnest {ctx, c: f.conversation}
        | where not (c.bot or coalesce(c.author == ctx.me, false) or coalesce(unbot(c.author) in ctx.bots, false))
        | values c.author
        | sort this
        | uniq
      ], [])}
    | values {...f, conversation: coalesce([unnest f.conversation | values {author, body}], []), untrusted}
  ], [])
EOF

# The findings with the agent's answers: {f: findings, r: result, changed, held}.
read -r -d '' PLAN_Q <<'EOF' || true
values {held, f, ctx: {changed, items: kind(coalesce(r.items, null)) == "array" ? r.items : []}}
| values [
    ...coalesce([
      unnest {ctx, f}
      | values {f, changed: ctx.changed,
                a: coalesce(coalesce([unnest {f, i: ctx.items} | where i.id == f.id | values i], [])[0], {})}
      | values {f, changed, act: coalesce(a.action, ""), rep: coalesce(a.reply, null)}
      | values {...f, ...(case
          when not (act in ["fixed", "reply", "pushback", "ask"]) then {action: "ask", reply: "(the agent did not answer this one)"}
          when not is(rep, <string>) then {action: "ask", reply: "(the agent gave no reply text)"}
          when not grep("\\S", rep) then {action: "ask", reply: "(the agent gave no reply text)"}
          when act == "fixed" and not changed then {action: "ask", reply: f"(said fixed but changed nothing): {rep}"}
          else {action: act, reply: rep} end)}
    ], []),
    ...held
  ]
EOF

# The plan, as printed: the agent's answers, then the ask items under
# "needs chrismo:" when there are any.
read -r -d '' REPORT <<'EOF' || true
fn where(it): it.type == "thread" ? f"{it.path}:{it.line}" : it.type == "review" ? "review body" : "PR comment"
fn pad(s, n): len(s) >= n ? s : s || "                    "[0:n-len(s)]
values [
  ...coalesce([unnest this | where action != "ask" | values f"  {pad(action, 9)} {pad(where(this), 20)} {reply}"], []),
  ...(len(coalesce([unnest this | where action == "ask"], [])) > 0 ? ["needs chrismo:"] : []),
  ...coalesce([unnest this | where action == "ask" | values f"  {pad(where(this), 20)} {reply}"], [])
] | unnest this
EOF

# The thread replies to post: id, action, where and the reply (any number of
# lines), then a record separator, per item.
read -r -d '' REPLIES <<'EOF' || true
fn where(it): it.type == "thread" ? f"{it.path}:{it.line}" : it.type == "review" ? "review body" : "PR comment"
unnest this | where this.type == "thread" and action != "ask"
| values id, action, where(this), reply, "\u001e"
EOF

# A reply is posted as written, so a /command or @mention in it would run a
# bot or ping a person. Lookalike glyphs keep the reading: a /command written
# as a word (a /word at a line start or after whitespace, a bracket or a
# quote, not followed by more path) gets U+2215 for its slash, which defeats
# the line-start regexes and whitespace-delimited substring checks bots use;
# an @login after anything but a letter, a digit or a slash gets U+FF20, which
# GitHub doesn't read as a mention (t@e.com and medium.com/@who stay; _@who_
# is scrubbed, since markdown runs before mention detection). Not covered: a
# /word glued to other text (foo/marge, **/marge**, a URL ending in /marge),
# which stays as written, and a one-segment absolute path (/tmp, /README.md),
# which reads as a command, code spans included (so does an @ in code, like
# `npm i @types/node`), and an @ right after a slash outside a URL (a/@who),
# which GitHub may still read as a mention (unverified). Only posted text is
# touched: ask items stay as the agent wrote them, since chrismo reads those,
# and the terminal report shows the posted text, glyphs included, on purpose.
# Two passes, because a match
# eats the character after the command, which may be the boundary of the next
# one ("/a /b").
read -r -d '' SCRUB_Q <<'EOF' || true
fn cmd(s): regexp_replace(s, "(^|[\\s(\\[\"'`])/([A-Za-z][A-Za-z0-9_-]*)($|[^A-Za-z0-9_/-])", "${1}∕${2}${3}")
fn scrub(s): regexp_replace(cmd(cmd(s)), "(^|[^A-Za-z0-9/])@([A-Za-z0-9])", "${1}＠${2}")
values coalesce([unnest this | values {...this, reply: is(reply, <string>) and action != "ask" ? scrub(reply) : reply}], [])
EOF

# A gate is a list of {hard}, {soft}, {warn} and {done} records (address,
# restack) or one such record (trigger, retarget). gate_get <gate> <key>
# prints that key's lines, in order.
gate_get() {
  local q="unnest (kind(this) == \"array\" ? this : [this]) | where coalesce($2, null) is not null | values $2"
  prc_line "$q" "$1"
}

# soft_gate <gate-json> <doing>: unless --force, list the soft refusals and exit.
soft_gate() {
  local soft
  soft=$(gate_get "$1" soft)
  if $force || [[ -z $soft ]]; then return 0; fi
  { echo "sd act: not $2:"
    sed 's/^/  - /' <<<"$soft"
    echo "(--force to run anyway)"; } >&2
  exit 1
}

gql() { gh api graphql "$@"; }

report() { # report <plan> <summary>
  echo "$branch: $2"
  prc_line "$REPORT" "$1"
}

address() {
  local b=$branch wt remote state gate line owed nodes findings bots
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  git -C "$wt" fetch --quiet "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"

  gate=$(prc_json "$GATE" "$state") || die "can't parse sd state's answer"
  line=$(gate_get "$gate" hard | head -1)
  [[ -z $line ]] || die "$line"
  owed=$(prc_json 'values coalesce([unnest threads.items | where kind == "bot"], [])' "$state")
  if [[ $owed == '[]' ]]; then
    echo "nothing to address on $b ($(prc_val "$state" 'coalesce(threads.owed_human, 0)') human item(s) are chrismo's)"
    return
  fi
  soft_gate "$gate" "addressing $b"
  gate_get "$gate" warn | sed 's/^/sd-act: warning: /' >&2

  local -a id_args=()
  (( $(prc_val "$owed" 'len(this)') <= 100 )) || echo "sd act: warning: over 100 owed items; taking the first 100" >&2
  while IFS= read -r line; do id_args+=(-f "ids[]=$line"); done < <(prc_line 'unnest this | head 100 | values id' "$owed")
  nodes=$(gql -f query="$NODES_Q" "${id_args[@]}") || die "couldn't fetch the findings' text"
  bots=$(prc_get settings.botLogin "$b" false json) || die "sd config failed"
  findings=$(prc_json "$FINDINGS_Q" "{\"bots\": $bots, \"n\": $nodes}") || die "couldn't read the findings' text"
  [[ $findings != '[]' ]] || die "none of the owed items could be fetched"
  local held
  held=$(prc_json 'values coalesce([unnest this | where len(untrusted) > 0
    | values {...this, action: "ask", reply: f"joined by {sj(untrusted, ", ")}: yours to answer"} | drop untrusted], [])' "$findings")
  findings=$(prc_json 'values coalesce([unnest this | where len(untrusted) == 0 | drop untrusted], [])' "$findings")
  if [[ $findings == '[]' ]]; then
    report "$held" "no bot feedback the agent can take"
    return
  fi

  local stored_h sid h mode result outcome plan timeout cfg forced verify guidance gbase
  stored_h=$(git config --get "branch.$b.sd-harness" || true)
  sid=$(git config --get "branch.$b.sd-session" || true)
  forced=${harness_opt:-$stored_h}
  cfg=$(prc_step address "$b" "$forced") || die "sd config failed"
  h=$(prc_val "$cfg" harness)
  if [[ -n $sid ]]; then
    [[ $h == "${stored_h:-claude}" ]] \
      || die "branch.$b.sd-session belongs to ${stored_h:-claude}; unset it to start a $h session"
    mode=resume
    if past_fork_limit "$b" "$h" "$sid"; then sid=; fi
  fi
  if [[ -z $sid ]]; then
    sid=$(uuidgen | tr 'A-F' 'a-f') mode=new
  fi
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  verify=$(cd "$wt" && prc_get settings.verify "$b" false) || die "sd config failed"
  [[ $verify != *$'\n'* ]] || die "verify must be a single command, not a list"
  gbase=$(guidance_base "$b") || die "can't find $b's base, to read its prompt guidance from"
  guidance=$(cd "$wt" && step_guidance addressPrompt "$b" "$gbase" "$SD_LIB/prompts/address.md") \
    || die "can't read the address guidance"
  echo "sd act: $h ($mode session $sid) is addressing $(prc_val "$findings" 'len(this)') item(s) on $b…" >&2
  local before
  before=$(git rev-parse "refs/heads/$b")
  result=$(cd "$wt" && HARNESS_STEP=address HARNESS_BRANCH=$b harness_run "$h" "$sid" "$mode" "$timeout" \
             "$guidance"$'\n\n'"$ADDRESS_CONTRACT"$'\n\nPR '"$(prc_val "$state" pr.url)"$'\nFindings:\n'"$(printf '%s\n' "$findings" | prc_super -i json -J -c 'values this' -)" "$SCHEMA" "$cfg") \
    || { hold_since "$b" "$gbase" "$before"; die "the $h step failed or returned no usable result (session $sid)"; }
  git config "branch.$b.sd-session" "$sid"
  git config "branch.$b.sd-harness" "$h"
  hold_since "$b" "$gbase" "$before"
  local agent_head
  agent_head=$(git rev-parse "refs/heads/$b")

  # pi has no schema enforcement, so check the shape here too.
  outcome=$(prc_val "$result" 'coalesce(outcome, "")')
  case $outcome in
    done|needs-input) ;;
    gave-up) die "the agent gave up: $(prc_val "$result" 'coalesce(summary, "")'). Any edits are left uncommitted in $wt" ;;
    *) die "the agent returned outcome \"$outcome\"; edits (if any) are left uncommitted in $wt" ;;
  esac
  local changed=false
  [[ -n $(git -C "$wt" status --porcelain) ]] && changed=true
  plan=$(prc_json "$PLAN_Q" "{\"f\": $findings, \"r\": $result, \"changed\": $changed, \"held\": $held}") \
    || die "couldn't read the agent's answer; edits (if any) are left uncommitted in $wt"
  plan=$(prc_json "$SCRUB_Q" "$plan") || die "couldn't scrub the replies; edits (if any) are left uncommitted in $wt"

  local msg
  if $changed; then
    msg=$(prc_line 'values {m: coalesce(commit_message, null)}
      | values case when is(m, <string>) and grep("\\S", m) then m else "Address review feedback" end' "$result")
    git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || die "commit failed; the edits are left in $wt"
  fi
  hold_since "$b" "$gbase" "$agent_head"
  verify_autofix "$wt" "$b" || die "verify failed ($verify); the commit is kept in $wt, nothing pushed or posted"

  report "$plan" "$(prc_val "$result" 'coalesce(summary, "")')"
  if $no_publish; then
    echo "not published: nothing pushed or posted"
    return
  fi

  # The plan isn't kept: after the push, the items are still owed, and a
  # second address finds the fix already in (it spends tokens again).
  hold_gate "$b" "pushing $b" "The replies weren't posted, so the items are still owed: after sd act push, sd act address answers them again, or answer them on GitHub"
  push_branch "$b" "$remote" || die "not pushed, so nothing posted"
  local prefix id action at reply line failed=0 pr_id body=""
  prefix=$(prc_get settings.replyPrefix "$b" false) || die "sd config failed"
  while IFS= read -r id && IFS= read -r action && IFS= read -r at; do
    reply=""
    while IFS= read -r line && [[ $line != $'\x1e' ]]; do reply+=$line$'\n'; done
    gql -f query='mutation($thread: ID!, $body: String!) {
          addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $thread, body: $body}) { comment { id } } }' \
        -f thread="$id" -f body="$prefix${reply%$'\n'}" >/dev/null \
      || { echo "sd act: replying to $at failed" >&2; failed=1; continue; }
    if [[ $action != pushback ]]; then
      gql -f query='mutation($thread: ID!) { resolveReviewThread(input: {threadId: $thread}) { thread { id } } }' \
          -f thread="$id" >/dev/null \
        || { echo "sd act: resolving $at failed" >&2; failed=1; }
    fi
  done < <(prc_line "$REPLIES" "$plan")

  # Review bodies and PR comments can't be replied to or resolved: answer them
  # in one PR comment and remember them in branch.<b>.sd-handled. Link, don't
  # quote: quoted text can carry what other bots act on (/commands, @mentions).
  local pj
  pj=$(prc_json_string "$prefix") || die "settings.replyPrefix isn't usable"
  body=$(prc_line '
    values {p, parts: coalesce([unnest plan | where this.type != "thread" and action != "ask"
                                | values f"[{this.type == "review" ? "Review" : "Comment"}]({url})\n\n{reply}"], [])}
    | where len(parts) > 0
    | values f"{p}Addressed review feedback:\n\n{join(parts, "\n\n")}"' "{\"p\": $pj, \"plan\": $plan}")
  if [[ -n $body ]]; then
    # By URL, not {owner}/{repo}: gh's default repo may be a fork.
    if pr_id=$(gql -f url="$(prc_val "$state" pr.url)" \
                 -f query='query($url: URI!) { resource(url: $url) { ... on PullRequest { id } } }' \
               | prc_line 'values data.resource.id') \
       && gql -f query='mutation($subject: ID!, $body: String!) { addComment(input: {subjectId: $subject, body: $body}) { clientMutationId } }' \
              -f subject="$pr_id" -f body="$body" >/dev/null; then
      while IFS= read -r id; do git config --add "branch.$b.sd-handled" "$id"; done \
        < <(prc_line 'unnest this | where this.type != "thread" and action != "ask" | values id' "$plan")
    else
      echo "sd act: posting the PR comment failed" >&2; failed=1
    fi
  fi
  return "$failed"
}

# ── verify ───────────────────────────────────────────────────────────────────

VERIFY_TAIL=40
VERIFY_CMD=""

# verify_run <worktree> <branch>: settings.verify there, under
# settings.stepTimeout, output captured. 0: passed, or nothing configured
# (VERIFY_CMD is then empty). Otherwise the command's status, with its output
# trimmed to the last $VERIFY_TAIL lines on stdout for the fix step that
# follows. A command that exits 0 but changes the tree (a formatter) fails too.
verify_run() {
  local wt=$1 b=$2 timeout out rc=0 n before
  VERIFY_CMD=$(cd "$wt" && prc_get settings.verify "$b" false) || die "sd config failed"
  [[ $VERIFY_CMD != *$'\n'* ]] || die "verify must be a single command, not a list"
  [[ -n $VERIFY_CMD ]] || return 0
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  out=$(mktemp)
  before=$(git -C "$wt" status --porcelain)
  (cd "$wt" && with_timeout "$timeout" sh -c "$VERIFY_CMD" </dev/null >"$out" 2>&1) || rc=$?
  if (( rc == 0 )) && [[ $(git -C "$wt" status --porcelain) != "$before" ]]; then
    echo "verify changed files in $wt (a formatter?); commit them and rerun"
    rc=1
  elif (( rc != 0 )); then
    n=$(wc -l < "$out" | tr -d " ")
    (( n <= VERIFY_TAIL )) || echo "… (last $VERIFY_TAIL of $n lines)"
    tail -n "$VERIFY_TAIL" "$out"
  fi
  rm -f "$out"
  return $rc
}

verify() {
  local b=$branch wt rc=0
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b is not checked out in any worktree"
  verify_run "$wt" "$b" || rc=$?
  if (( rc != 0 )); then die "verify failed ($VERIFY_CMD)"
  elif [[ -z $VERIFY_CMD ]]; then echo "no settings.verify configured; nothing to run"
  else echo "verify passed ($VERIFY_CMD)"
  fi
}

# ── autofix: A11 ─────────────────────────────────────────────────────────────

# autofix_run <worktree> <branch> [revert]: settings.autofix in the worktree
# under settings.stepTimeout, from a clean tree, and a commit of what it
# changed: AUTOFIX_COMMIT is its short sha, else empty. A failing command
# prints its output's tail, as verify_run does, and its changes are left
# uncommitted to look at, or with revert (the hook) put back, so the next
# step starts from the commit it knows.
autofix_run() {
  local wt=$1 b=$2 revert=${3:-} timeout out rc=0 n changed
  AUTOFIX_COMMIT=""
  AUTOFIX_CMD=$(cd "$wt" && prc_get settings.autofix "$b" false) || die "sd config failed"
  [[ $AUTOFIX_CMD != *$'\n'* ]] || die "autofix must be a single command, not a list"
  [[ -n $AUTOFIX_CMD ]] || return 0
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes; autofix needs a clean tree to commit from"
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  out=$(mktemp)
  (cd "$wt" && with_timeout "$timeout" sh -c "$AUTOFIX_CMD" </dev/null >"$out" 2>&1) || rc=$?
  changed=$(git -C "$wt" status --porcelain | wc -l | tr -d " ")
  if (( rc != 0 )); then
    n=$(wc -l < "$out" | tr -d " ")
    (( n <= VERIFY_TAIL )) || echo "… (last $VERIFY_TAIL of $n lines)"
    tail -n "$VERIFY_TAIL" "$out"
    if (( changed > 0 )) && [[ $revert == revert ]]; then
      git -C "$wt" reset -q --hard && git -C "$wt" clean -qfd
      echo "autofix changed $(plural "$changed" file) before failing; reverted"
    elif (( changed > 0 )); then
      echo "autofix changed $(plural "$changed" file) in $wt before failing; left uncommitted"
    fi
  elif (( changed > 0 )); then
    git -C "$wt" add -A && git -C "$wt" commit -q -m "autofix: $AUTOFIX_CMD" || die "commit failed; autofix's changes are left in $wt"
    AUTOFIX_COMMIT=$(git -C "$wt" rev-parse --short HEAD)
    echo "autofix committed $AUTOFIX_COMMIT: $(plural "$changed" file) ($AUTOFIX_CMD)"
  else
    echo "autofix changed nothing ($AUTOFIX_CMD)"
  fi
  rm -f "$out"
  return $rc
}

# verify_autofix <worktree> <branch>: verify; when it fails, autofix, and when
# that committed something, verify again. The zero-token pass before a fix
# step. A verify that dirtied the tree is verify's own failure: no autofix.
verify_autofix() {
  AUTOFIX_COMMIT=""
  verify_run "$1" "$2" && return 0
  [[ -z $(git -C "$1" status --porcelain) ]] || return 1
  autofix_run "$1" "$2" revert || return 1
  [[ -n $AUTOFIX_COMMIT ]] || return 1
  verify_run "$1" "$2" || return 1
  echo "verify passed after autofix ($VERIFY_CMD)"
}

autofix() {
  local b=$branch wt
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b is not checked out in any worktree"
  autofix_run "$wt" "$b" || die "autofix failed ($AUTOFIX_CMD)"
  [[ -n $AUTOFIX_CMD ]] || echo "no settings.autofix configured; nothing to run"
}

# no_base_why <branch> <state>: why sd state found no base: its errors, else a
# parent that exists only here (parent.unpushed), which sd state reports as a
# step, not an error (#105).
no_base_why() {
  local remote; remote=$(prc_get settings.remote "$1" false) || remote=origin
  prc_val "$2" "len(coalesce(errors, [])) > 0 ? sj(errors, \"; \")
    : on(parent.unpushed) ? f\"parent {parent.name} isn't on $remote yet: ship it first (sd act ship {parent.name})\" : \"\""
}

# ── review ───────────────────────────────────────────────────────────────────

review() {
  local b=$branch wt state base head task timeout reviewer findings n blocking round rec prev flagged
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  attached_check "$b" "reviewing $b"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  [[ -n $base ]] || die "can't find $b's base: $(no_base_why "$b" "$state")"
  head=$(git rev-parse "refs/heads/$b")
  if $accept; then
    pin_write "$b" accepted "$head" "$base"
    git update-ref -d "refs/sheepdog/$b/findings"
    echo "accepted: $b at ${head:0:7} against ${base:0:7}; pinned accepted"
    return
  fi
  verify_run "$wt" "$b" || die "verify failed ($VERIFY_CMD); not reviewing"
  timeout=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"
  reviewer=$(prc_get settings.localReview "$b" false) || die "sd config failed"
  if [[ -z $reviewer ]]; then
    reviewer="$(dirname "$(realpath "$0")")/sd-review-local"
    # The default reviewer's harness_run has its own stepTimeout, which must
    # fire first: it kills the harness and shows its stderr. This one can't
    # reach the harness (with_timeout puts it in its own process group), so
    # firing first would leave it running, still spending tokens.
    timeout=$((timeout + 30))
  fi
  task=$(git config --get "branch.$b.sd-task" || true)
  findings=$(cd "$wt" && SHEEPDOG_BASE=$base SHEEPDOG_HEAD=$head SHEEPDOG_TASK=$task \
               with_timeout "$timeout" sh -c "$reviewer" </dev/null) \
    || die "the reviewer failed ($reviewer); nothing pinned"
  n=$(prc_line 'where kind(this) == "array" | values len(this)' "$findings" 2>/dev/null) && [[ -n $n ]] \
    || die "the reviewer printed no JSON list ($reviewer)"
  blocking=$(prc_line 'values len(coalesce([unnest this | where coalesce(severity, "") != "nit"], []))' "$findings") \
    && [[ $blocking =~ ^[0-9]+$ ]] || die "couldn't count the findings that block ($reviewer); nothing pinned"
  # sd state's flags (#125): information, whatever the verdict.
  flagged=$(prc_val "$state" 'len(coalesce(flags, []))')
  if (( flagged > 0 )); then
    echo "sd act: $flagged flagged for chrismo in ${base:0:7}..${head:0:7} (not a gate):" >&2
    flag_lines "$state" >&2
  fi
  if (( blocking == 0 )); then
    pin_write "$b" local "$head" "$base"
    git update-ref -d "refs/sheepdog/$b/findings"
    if (( n == 0 )); then
      echo "clean: $b at ${head:0:7} reviewed against ${base:0:7}; pinned local"
    else
      echo "clean: $b at ${head:0:7} reviewed against ${base:0:7}; pinned local ($(plural "$n" nit))"
      printf '%s\n' "$findings"
    fi
  else
    prev=$(git cat-file blob "refs/sheepdog/$b/findings" 2>/dev/null || true)
    round=$(prc_line 'values coalesce(round, 0)' "${prev:-null}" 2>/dev/null || true)
    [[ $round =~ ^[0-9]+$ ]] || round=0
    # The same HEAD (or the same change rebased, as sd state judged it) reviewed
    # again isn't a new round. Its findings replace the earlier ones and their
    # answers, which were about a list this one needn't repeat.
    [[ $(prc_val "$state" 'on(review.findings.at_head)') == true ]] || round=$(( round + 1 ))
    rec=$(prc_json 'values {head: h, base: b, round: r, findings: f}' \
            "{\"h\": \"$head\", \"b\": \"$base\", \"r\": $round, \"f\": $findings}") \
      && git update-ref -m "review round $round" "refs/sheepdog/$b/findings" "$(git hash-object -w --stdin <<<"$rec")" \
      || die "couldn't record the findings"
    echo "sd act: $(plural "$n" finding) on $b, $blocking blocking (review round $round); nothing pinned" >&2
    printf '%s\n' "$findings"
  fi
}

# ── agent sessions ───────────────────────────────────────────────────────────

# step_session <branch> <step>: the harness and session a step runs in: the
# branch's session (branch.<b>.sd-session) resumed, else a new one. Sets
# STEP_CFG, STEP_H, STEP_SID, STEP_MODE, STEP_TIMEOUT. Refuses while the
# branch is attached: the session is open in a TUI, and a resume beside it
# forks the transcript (#14).
step_session() {
  local b=$1 step=$2 stored_h
  attached_check "$b" "running the $step step on $b"
  export HARNESS_STEP=$step HARNESS_BRANCH=$b
  stored_h=$(git config --get "branch.$b.sd-harness" || true)
  STEP_CFG=$(prc_step "$step" "$b" "${harness_opt:-$stored_h}") || die "sd config failed"
  STEP_H=$(prc_val "$STEP_CFG" harness)
  STEP_SID=$(git config --get "branch.$b.sd-session" || true)
  if [[ -n $STEP_SID ]]; then
    [[ $STEP_H == "${stored_h:-claude}" ]] \
      || die "branch.$b.sd-session belongs to ${stored_h:-claude}; unset it to start a $STEP_H session"
    STEP_MODE=resume
    if past_fork_limit "$b" "$STEP_H" "$STEP_SID"; then STEP_SID=; fi
  fi
  if [[ -z $STEP_SID ]]; then
    STEP_SID=$(uuidgen | tr 'A-F' 'a-f') STEP_MODE=new
  fi
  STEP_TIMEOUT=$(prc_get settings.stepTimeout "$b" false) || die "sd config failed"
  [[ $STEP_TIMEOUT =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $STEP_TIMEOUT"
}

# past_fork_limit <branch> <harness> <session-id>: the session's context (its
# last turn's tokens, harness_tally) is past settings.forkLimit, so a step
# starts a new session instead of inheriting it (#121). Every step's prompt is
# self-contained (task, contract, findings or logs), so the history is only an
# optimization, and past the limit it stops paying for itself. 0 is no limit;
# no transcript, or none that says, is resumed.
past_fork_limit() {
  local limit ctx
  limit=$(prc_get settings.forkLimit "$1" false) || die "sd config failed"
  (( limit > 0 )) || return 1
  ctx=$(prc_val "$(harness_tally "$2" "$3")" 'coalesce(context, "")') || return 1
  [[ -n $ctx ]] && (( ctx > limit )) || return 1
  echo "sd act: session $3 is $ctx tokens, past settings.forkLimit ($limit): starting a new one" >&2
}

# step_store <branch>: after a step ran, remember its session and harness.
step_store() {
  git config "branch.$1.sd-session" "$STEP_SID"
  git config "branch.$1.sd-harness" "$STEP_H"
}

# ── attach: A9, takeover ─────────────────────────────────────────────────────

# branch.<b>.sd-lock is "<pid>@<host> <time>": the attach holding the branch's
# session open. Stale once that pid is gone from this host; a lock from
# another host can't be checked, so it never is.
lock_stale() {
  local pid=${1%%@*} host=${1#*@}
  host=${host%% *}
  [[ $pid =~ ^[0-9]+$ && $host == "$(hostname)" ]] || return 1
  ! kill -0 "$pid" 2>/dev/null
}

# lock_sweep <branch>: clear a stale lock, so every verb's gate sees only live ones.
lock_sweep() {
  local lock
  lock=$(git config --get "branch.$1.sd-lock" 2>/dev/null || true)
  [[ -n $lock ]] && lock_stale "$lock" || return 0
  echo "sd act: clearing a stale lock on $1 ($lock)" >&2
  git config --unset "branch.$1.sd-lock"
}

# attached_check <branch> <doing>: an agent step on an attached branch is
# refused; --force runs it anyway.
attached_check() {
  local lock
  lock=$(git config --get "branch.$1.sd-lock" || true)
  [[ -n $lock ]] || return 0
  if $force; then
    echo "sd act: warning: $1 is attached ($lock); running anyway" >&2
  else
    die "not $2: attached ($lock). Exit that session, or --force"
  fi
}

# attach_release <branch>: drop the lock, if it is still the one attach took.
attach_release() {
  [[ $(git config --get "branch.$1.sd-lock" || true) == "$ATTACH_LOCK" ]] || return 0
  git config --unset "branch.$1.sd-lock"
}

# harness_flags <harness> <branch>: the harness block's model, effort,
# provider and args as the TUI's flags, the typed ones as harness_run
# passes them. Printed one per line; args split on whitespace.
harness_flags() {
  local h=$1 b=$2 k v rc
  for k in provider model effort args; do
    v=$(prc_get "harnesses.$h.$k" "$b" false) || { rc=$?; (( rc == 3 )) || die "sd config failed"; continue; }
    [[ -n $v ]] || continue
    case $h:$k in
      claude:model|pi:model) printf -- '--model\n%s\n' "$v" ;;
      claude:effort) printf -- '--effort\n%s\n' "$v" ;;
      pi:effort) printf -- '--thinking\n%s\n' "$v" ;;
      pi:provider) printf -- '--provider\n%s\n' "$v" ;;
      *:args) tr -s ' \t' '\n\n' <<<"$v" | sed '/^$/d' ;;
    esac
  done
}

# session_exists <harness> <id>: the harness wrote a transcript for the session.
session_exists() { [[ -n $(harness_transcript "$1" "$2") ]]; }

attach() {
  local b=$branch wt lock stored_h h sid mode use_key rc=0
  local -a cmd flags
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  lock=$(git config --get "branch.$b.sd-lock" || true)
  if [[ -n $lock ]]; then
    $force || die "$b is already attached ($lock); exit that session, or --force to take it over"
    echo "sd act: taking over $b's lock ($lock)" >&2
  fi
  stored_h=$(git config --get "branch.$b.sd-harness" || true)
  sid=$(git config --get "branch.$b.sd-session" || true)
  h=${harness_opt:-$stored_h}
  if [[ -z $h ]]; then h=$(prc_get harness "$b" false) || die "sd config failed"; fi
  if [[ -n $sid ]]; then
    [[ $h == "${stored_h:-claude}" ]] \
      || die "branch.$b.sd-session belongs to ${stored_h:-claude}; unset it to start a $h session"
    mode=resume
  else
    sid=$(uuidgen | tr 'A-F' 'a-f') mode=new
  fi
  case $h in
    claude)
      # Same rule as harness_run (#68): the claude.ai login unless useApiKey.
      use_key=$(prc_get harnesses.claude.useApiKey "$b" false) || use_key=false
      [[ $use_key == true ]] || cmd=(env -u ANTHROPIC_API_KEY)
      if [[ $mode == resume ]]; then cmd+=(claude --resume "$sid"); else cmd+=(claude --session-id "$sid"); fi ;;
    pi) cmd=(pi --session-id "$sid") ;;
    *) die "unknown harness: $h (claude or pi)" ;;
  esac
  mapfile -t flags < <(harness_flags "$h" "$b")
  ATTACH_LOCK="$$@$(hostname) $(date -u +%FT%TZ)"
  git config "branch.$b.sd-lock" "$ATTACH_LOCK"
  # The TUI gets Ctrl-C and a closed terminal before this shell does, and bash
  # holds a signal until the foreground child exits; the no-op traps then let
  # the session be recorded, and the EXIT trap releases the lock either way.
  trap 'attach_release "$b"' EXIT
  trap : INT TERM HUP
  echo "sd act: attached to $b: $h ($mode session $sid) in $wt; agent steps wait until you exit" >&2
  (cd "$wt" && "${cmd[@]}" "${flags[@]}") || rc=$?
  if [[ $mode == resume ]] || session_exists "$h" "$sid"; then
    git config "branch.$b.sd-session" "$sid"
    git config "branch.$b.sd-harness" "$h"
  else
    echo "sd act: $h wrote no transcript for session $sid, so nothing is stored; attach again to start one" >&2
  fi
  exit "$rc"
}

# ── start: A0 ───────────────────────────────────────────────────────────────

# Duplicates agent-rig's wt-new (#14), hook locations and branch resolution
# included, so a repo set up for new_wt needs nothing more. Placement differs
# (#85): beside the main worktree, not beside the current one.

# start_default <remote>
start_default() {
  local head br
  head=$(git symbolic-ref -q --short "refs/remotes/$1/HEAD" 2>/dev/null) && { echo "${head#"$1"/}"; return; }
  for br in main master; do
    if git show-ref -q --verify "refs/remotes/$1/$br" || git show-ref -q --verify "refs/heads/$br"; then
      echo "$br"; return
    fi
  done
  return 1
}

# start_point <remote> <branch>
start_point() {
  if git show-ref -q --verify "refs/remotes/$1/$2"; then echo "refs/remotes/$1/$2"
  elif git show-ref -q --verify "refs/heads/$2"; then echo "refs/heads/$2"
  else return 1
  fi
}

# start_hook <src> <dst> <branch>: all output on stderr; stdout is start's path.
start_hook() {
  local src=$1 dst=$2 b=$3 script cmd rc=0
  script="$(cd "$(git rev-parse --git-common-dir)" && pwd)/worktree-setup"
  if [[ -x $script ]]; then
    echo "sd act: running $script" >&2
    (cd "$dst" && WT_SRC=$src WT_DST=$dst WT_BRANCH=$b "$script") >&2 || rc=$?
  else
    cmd=$(git config --get wt.setup || true)
    [[ -n $cmd ]] || return 0
    echo "sd act: running wt.setup: $cmd" >&2
    (cd "$dst" && WT_SRC=$src WT_DST=$dst WT_BRANCH=$b sh -c "$cmd") >&2 || rc=$?
  fi
  (( rc == 0 )) || echo "sd act: the setup hook failed (exit $rc); the worktree is kept at $dst" >&2
  return $rc
}

start() {
  local b=$branch remote src dst from="" base="" default rc=0
  git check-ref-format --branch "$b" >/dev/null 2>&1 || die "not a valid branch name: $b"
  $no_implement || [[ -n $task_arg ]] || die "no task: sd act start $b \"<task>\" (or --no-implement)"
  src=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a worktree"
  # Beside the main worktree, whichever worktree this runs from, so a stack
  # built with cd "$(sd act start ...)" stays in one place; a slash in the
  # branch name would make directories, so it becomes a dash (#85).
  dst="$(dirname "$(main_worktree)")/${b//\//-}"
  [[ ! -e $dst ]] || die "$dst already exists"
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  git fetch --quiet --prune "$remote" || die "fetch from $remote failed"

  if git show-ref -q --verify "refs/heads/$b"; then
    git worktree add "$dst" "$b" >&2 || die "git worktree add failed"
  elif git show-ref -q --verify "refs/remotes/$remote/$b"; then
    echo "sd act: tracking $remote/$b" >&2
    git worktree add --track -b "$b" "$dst" "$remote/$b" >&2 || die "git worktree add failed"
  else
    if [[ -n $parent_opt ]]; then
      if git show-ref -q --verify "refs/heads/$parent_opt"; then from=refs/heads/$parent_opt
      else from=$(start_point "$remote" "$parent_opt") || die "no such parent branch: $parent_opt"
      fi
    else
      default=$(start_default "$remote") || die "can't tell the default branch (no $remote/HEAD, main or master)"
      from=$(start_point "$remote" "$default") || die "no $remote/$default or $default to start from"
    fi
    base=$(git rev-parse "$from^{commit}")
    echo "sd act: branching $b off ${from#refs/*/} (${base:0:7})" >&2
    # From the SHA, not the ref: a remote-tracking start point would become the upstream.
    git worktree add -b "$b" "$dst" "$base" >&2 || die "git worktree add failed"
  fi

  if [[ -n $task_arg ]]; then git config "branch.$b.sd-task" "$task_arg"; fi
  if [[ -n $parent_opt ]]; then git config "branch.$b.sd-parent" "$parent_opt"; fi
  if [[ -n $base ]]; then git update-ref -m "sd act start" "refs/sheepdog/$b/base" "$base"; fi
  enroll_mark "$b" >&2

  if ! start_hook "$src" "$dst" "$b"; then
    rc=1
    $no_implement || echo "sd act: fix it, then: sd act implement $b" >&2
  elif ! $no_implement; then
    (implement_run "$b" "$dst") >&2 || rc=$?
  fi
  echo "$dst"
  return $rc
}

# ── implement: J0 ────────────────────────────────────────────────────────────

# The implement step's prompt: guidance (settings.implementPrompt, else
# .sheepdog/implement.md in the base commit, else lib/prompts/implement.md),
# then this contract, which the pipeline relies on. A fix round swaps in the
# review-fix guidance and contract.
read -r -d '' IMPLEMENT_CONTRACT <<'EOF' || true
Edit files, but do not commit, push, or run gh: the pipeline commits your edits
with your commit_message, runs the repo's checks, and opens the PR later.

Return outcome "done" when the task is implemented, with a one-line
commit_message; "needs-input" when you need a decision from the task's author
(put the question in summary and leave your edits in place); or "gave-up" when
you can't make sense of it (say why in summary).
EOF

read -r -d '' REVIEW_FIX_CONTRACT <<'EOF' || true
For each finding below, pick exactly one action:
- fixed:    you changed code to address it
- declined: you judge it wrong, or it needs no change; say why
- ask:      it needs a decision from the branch's owner; say what the question is

Edit files, but do not commit, push, or run gh: the pipeline commits your edits
with your commit_message and runs the repo's checks. Return one item per
finding id (the number in brackets), with your reason or question as its
reply (for fixed, what you changed, or ""); a one-line commit_message if you changed anything (else null); and
outcome "done", "needs-input" (anything you marked ask: your edits are left
uncommitted for the owner) or "gave-up" (you can't make sense of them; say why
in summary). What you decline goes to the next review round, or to the owner
when you decline them all.
EOF

# guidance_base <branch>: the commit a step reads repo guidance (.sheepdog/,
# relative prompt paths) from, which the branch's agent can't rewrite: the
# base pin, else where the branch forked from the default branch, the remote's
# or else the local one, unless the branch is the default branch: sheepdog
# pushes it, so neither ref is clear of its commits. Nothing when none
# qualifies: the branch's own commits are never trusted for its guidance.
guidance_base() {
  local remote def ref
  git rev-parse -q --verify "refs/sheepdog/$1/base" && return
  remote=$(prc_get settings.remote "$1" false) || return 1
  if def=$(start_default "$remote") && [[ $def != "$1" ]]; then
    for ref in "refs/remotes/$remote/$def" "refs/heads/$def"; do
      git show-ref -q --verify "$ref" && git merge-base "refs/heads/$1" "$ref" && return
    done
  fi
  return 0
}

read -r -d '' IMPLEMENT_SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "commit_message", "summary"],
 "properties": {"outcome": {"enum": ["done", "needs-input", "gave-up"]},
                "commit_message": {"type": ["string", "null"]},
                "summary": {"type": "string"}}}
EOF

# A fix round's schema: one item per finding id, in the vocabulary #133 gives
# every source's findings.
read -r -d '' REVIEW_FIX_SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "commit_message", "summary", "items"],
 "properties": {
   "outcome": {"enum": ["done", "needs-input", "gave-up"]},
   "commit_message": {"type": ["string", "null"]},
   "summary": {"type": "string"},
   "items": {"type": "array", "items": {"type": "object", "required": ["id", "action", "reply"],
     "properties": {"id": {"type": "string"},
                    "action": {"enum": ["fixed", "declined", "ask"]},
                    "reply": {"type": "string"}}}}}}
EOF

# The findings record's findings, each with its id (its place in the list)
# and open: it blocks and the agent hasn't declined it, so a fix round hands
# it over.
read -r -d '' NUMBERED_Q <<'EOF' || true
values coalesce([
  unnest coalesce(findings, [])
  | count {r: this, j}
  | values {...r, id: f"{j}",
            open: coalesce(r.severity, "") != "nit" and coalesce(r.action, "") != "declined"}
], [])
EOF

# The agent's answers on the numbered findings: {f, r: result, changed}. An
# open finding takes its item's action and reply; no answer, a decline or ask
# with no reply text, or fixed with nothing changed is ask, so chrismo sees
# it. A fix needs no reply text: the commit shows it.
read -r -d '' ANSWERS_Q <<'EOF' || true
values {f, ctx: {changed, items: kind(coalesce(r.items, null)) == "array" ? r.items : []}}
| values coalesce([
    unnest {ctx, f}
    | values {f, changed: ctx.changed,
              a: f.open ? coalesce(coalesce([unnest {f, i: ctx.items} | where i.id == f.id | values i], [])[0], {}) : null}
    | values {f, changed, a, act: coalesce(a.action, ""), rep: coalesce(a.reply, null)}
    | values {f, changed, a, act, rep: is(rep, <string>) ? rep : ""}
    | values a is null ? f : {...f, ...(case
        when not (act in ["fixed", "declined", "ask"]) then {action: "ask", reply: "(the agent did not answer this one)"}
        when act == "fixed" and not changed then {action: "ask", reply: f"(said fixed but changed nothing): {rep}"}
        when act == "fixed" then {action: act, reply: rep}
        when not grep("\\S", rep) then {action: "ask", reply: "(the agent gave no reply text)"}
        else {action: act, reply: rep} end)}
  ], [])
EOF

# The answers, as printed: one line per finding the round handed over.
read -r -d '' ANSWERS_REPORT <<'EOF' || true
fn pad(s, n): len(s) >= n ? s : s || "         "[0:n-len(s)]
unnest this | where open
| values f"  {pad(action, 9)} [{id}] {coalesce(file, "?")}:{coalesce(line, "?")} {reply}"
EOF

# implement_run <branch> <worktree>
implement_run() {
  local b=$1 wt=$2 task verify before agent_head prompt result outcome summary msg extra rule rec state gbase guidance listed="" allow=$HARNESS_CLAUDE_ALLOW
  local numbered answered asks changed=false schema=$IMPLEMENT_SCHEMA
  local -a rules=()
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  task=$(git config --get "branch.$b.sd-task" || true)
  before=$(git rev-parse "refs/heads/$b")
  # A fix round: sd act review's open findings, when they're about HEAD. The
  # task goes along as context.
  rec=$(git cat-file blob "refs/sheepdog/$b/findings" 2>/dev/null || true)
  # sd state decides whether they're about HEAD, so NEXT and this agree.
  if [[ -n $rec ]]; then
    state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  fi
  if [[ -n $rec && $(prc_line 'values on(review.findings.at_head)' "$state") == true ]]; then
    numbered=$(prc_json "$NUMBERED_Q" "$rec") \
      && listed=$(prc_line 'unnest this | where open
        | values f"- [{id}] {coalesce(file, "?")}:{coalesce(line, "?")} ({coalesce(severity, "?")}) {coalesce(body, "")}"' "$numbered") \
      || die "couldn't read the review findings on $b"
  fi
  [[ -n $task || -n $listed ]] || die "no task recorded for $b: git config branch.$b.sd-task \"<task>\""
  verify=$(cd "$wt" && prc_get settings.verify "$b" false) || die "sd config failed"
  extra=$(cd "$wt" && prc_get settings.implementAllow "$b" false) || die "sd config failed"
  # A rule's * is a wildcard, so only plain words become an exact rule.
  if [[ $verify =~ ^[A-Za-z0-9_./:=@+-]+( [A-Za-z0-9_./:=@+-]+)*$ ]]; then
    rules+=("Bash($verify)")
  elif [[ -n $verify && -z $extra ]]; then
    echo "sd act: warning: verify ($verify) isn't plain words, so the agent may not run it; allow what it may run in settings.implementAllow" >&2
  fi
  while IFS= read -r rule; do [[ -z $rule ]] || rules+=("$rule"); done <<<"$extra"
  step_session "$b" implement
  gbase=$(guidance_base "$b") || die "can't find $b's base, to read its prompt guidance from"
  if [[ -n $listed ]]; then
    guidance=$(step_guidance reviewFixPrompt "$b" "$gbase" "$SD_LIB/prompts/review-fix.md") || die "can't read the review-fix guidance"
    prompt="$guidance"$'\n\n'"$REVIEW_FIX_CONTRACT"$'\n\nFindings:\n'"$listed"$'\n\nThe task this branch was made for, for context:\n'"${task:-(none recorded)}"
    schema=$REVIEW_FIX_SCHEMA
  else
    guidance=$(step_guidance implementPrompt "$b" "$gbase" "$SD_LIB/prompts/implement.md") || die "can't read the implement guidance"
    prompt="$guidance"$'\n\n'"$IMPLEMENT_CONTRACT"$'\n\nTask:\n'"$task"
  fi
  [[ -z $verify ]] || prompt+=$'\n\nThe repo\'s checks, which the pipeline runs after you: '"$verify"
  if [[ $STEP_H == claude ]] && (( ${#rules[@]} )); then
    allow+=$(printf ',%s' "${rules[@]}")
    prompt+=$'\n\nBeyond reading files and read-only git, you may run only these (Claude Code permission rules); anything else is refused:\n'"$(printf '%s\n' "${rules[@]}")"
  else
    prompt+=$'\n\nYou can\'t run commands here beyond read-only git.'
  fi
  echo "sd act: $STEP_H ($STEP_MODE session $STEP_SID) is implementing $b…" >&2
  result=$(cd "$wt" && HARNESS_CLAUDE_ALLOW=$allow \
             && harness_run "$STEP_H" "$STEP_SID" "$STEP_MODE" "$STEP_TIMEOUT" "$prompt" "$schema" "$STEP_CFG") \
    || { hold_since "$b" "$gbase" "$before"; die "the $STEP_H implement step failed or returned no usable result (session $STEP_SID)"; }
  step_store "$b"
  hold_since "$b" "$gbase" "$before"
  agent_head=$(git rev-parse "refs/heads/$b")

  outcome=$(prc_val "$result" 'coalesce(outcome, "")')
  summary=$(prc_val "$result" 'coalesce(summary, "")')
  case $outcome in
    done|needs-input) ;;
    gave-up) die "the agent gave up on $b: $summary. Edits (if any) are left uncommitted in $wt" ;;
    *) die "the agent returned outcome \"$outcome\"; edits (if any) are left uncommitted in $wt" ;;
  esac
  if [[ -n $(git -C "$wt" status --porcelain) || $(git rev-parse "refs/heads/$b") != "$before" ]]; then changed=true; fi
  # A fix round's answers: any ask goes to chrismo, as needs-input does.
  if [[ -n $listed ]]; then
    answered=$(prc_json "$ANSWERS_Q" "{\"f\": $numbered, \"r\": $result, \"changed\": $changed}") \
      && asks=$(prc_line 'unnest this | where open and coalesce(action, "") == "ask"
        | values f"  [{id}] {coalesce(file, "?")}:{coalesce(line, "?")} {reply}"' "$answered") \
      || die "couldn't read the agent's answers to the findings (session $STEP_SID)"
    [[ -z $asks ]] || outcome=needs-input summary+=$'\n'"$asks"
  fi
  if [[ $outcome == needs-input ]]; then
    # implement refuses a dirty worktree, so with edits left the answer goes
    # into the session itself.
    if [[ -n $(git -C "$wt" status --porcelain) ]]; then
      die "the agent needs input on $b: $summary"$'\n'"Its edits are left uncommitted in $wt: answer in its session (sd act attach $b) and commit what you keep, or discard them and run sd act implement again"
    fi
    die "the agent needs input on $b: $summary"$'\n'"Answer in session $STEP_SID, then sd act implement"
  fi
  if [[ -n $(git -C "$wt" status --porcelain) ]]; then
    msg=$(prc_line 'values {m: coalesce(commit_message, null)}
      | values case when is(m, <string>) and grep("\\S", m) then m else "" end' "$result")
    if [[ -z $msg && -n $listed ]]; then msg="Fix the local review findings"; fi
    [[ -n $msg ]] || msg=$(head -1 <<<"$task")
    git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || die "commit failed; the edits are left in $wt"
  elif ! $changed; then
    [[ -n $listed ]] || die "the agent says done but changed nothing (session $STEP_SID)"
  fi
  if [[ -n $listed ]]; then
    rec=$(prc_json 'values {...r, findings: coalesce([unnest f | drop open], [])}' "{\"r\": $rec, \"f\": $answered}") \
      && git update-ref -m "review findings answered" "refs/sheepdog/$b/findings" "$(git hash-object -w --stdin <<<"$rec")" \
      || die "couldn't record the agent's answers to the findings"
  fi
  if ! $changed; then
    echo "$b: the agent declined the review findings: $summary"
    prc_line "$ANSWERS_REPORT" "$answered"
    echo "next: chrismo fixes them, or accepts HEAD: sd act review --accept"
    return 0
  fi
  echo "$b: $summary"
  [[ -z $listed ]] || prc_line "$ANSWERS_REPORT" "$answered"
  git -C "$wt" log --format='  %h %s' "$before..refs/heads/$b"
  hold_since "$b" "$gbase" "$agent_head"
  verify_autofix "$wt" "$b" || die "verify failed ($VERIFY_CMD); the commit is kept in $wt"
  echo "next: sd act review"
}

implement() {
  local wt
  wt=$(worktree_for "$branch")
  [[ -n $wt ]] || die "$branch isn't checked out in any worktree"
  implement_run "$branch" "$wt"
}

# ── ci-fix: J2 ───────────────────────────────────────────────────────────────

read -r -d '' CI_FIX_SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "commit_message", "summary"],
 "properties": {"outcome": {"enum": ["fixed", "flaky", "needs-input", "gave-up"]},
                "commit_message": {"type": ["string", "null"]},
                "summary": {"type": "string"}}}
EOF

CI_LOG_TAIL=150

# ci_tail: stdin cut to its last $CI_LOG_TAIL lines, with a note when cut.
ci_tail() {
  local t n
  t=$(mktemp) || return
  cat > "$t"
  n=$(wc -l < "$t" | tr -d " ")
  (( n <= CI_LOG_TAIL )) || echo "… (last $CI_LOG_TAIL of $n lines)"
  tail -n "$CI_LOG_TAIL" "$t"
  rm -f "$t"
}

# ci_logs_rwx <run-id>: the failed tasks' logs of an RWX run.
ci_logs_rwx() {
  local run=$1 key tid dir f
  while IFS=$'\t' read -r key tid; do
    [[ -n $tid ]] || continue
    dir=$(mktemp -d) || continue
    if rwx logs "$tid" --output "$dir" >/dev/null 2>&1; then
      for f in "$dir"/*.log; do
        [[ -f $f ]] || continue
        echo "### task $key (rwx logs $tid)"
        ci_tail < "$f"
      done
    fi
    rm -rf "$dir"
  done < <(rwx results "$run" --json 2>/dev/null | sed -n '/^{/,$p' \
           | prc_line 'unnest coalesce(Tasks, []) | where coalesce(Status.Result, "") == "failed" | values f"{Key}\t{ID}"' 2>/dev/null || true)
}

# ci_logs <sha>: the failing checks and what can be fetched of their logs, for
# the prompt. All REST: the commit's statuses (RWX and other external CI; an
# RWX run's logs through rwx results and rwx logs) and its check runs (GitHub
# Actions; gh run view --log-failed). Each log is cut to its last $CI_LOG_TAIL
# lines; a source that can't be read is left out, never fatal. @tsv escapes
# tabs and newlines in a field, which %b puts back; the separating tabs
# become \037, since read would merge the tabs around an empty field.
ci_logs() {
  local sha=$1 ctx desc url name title summary
  while IFS=$'\037' read -r ctx desc url; do
    [[ -n $ctx ]] || continue
    printf '## %b: %b\n%b\n' "$ctx" "$desc" "$url"
    [[ $url =~ cloud\.rwx\.com/[^/]+/runs/([0-9a-z]+) ]] && ci_logs_rwx "${BASH_REMATCH[1]}"
  done < <(gh api "repos/{owner}/{repo}/commits/$sha/status" \
             --jq '.statuses[] | select(.state == "failure" or .state == "error") | [.context, .description // "", .target_url // ""] | @tsv' 2>/dev/null \
           | tr '\t' '\037' || true)
  while IFS=$'\037' read -r name title summary url; do
    [[ -n $name ]] || continue
    printf '## %b: %b\n%b\n%b\n' "$name" "$title" "$summary" "$url"
    if [[ $url =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
      echo "### failed steps (gh run view ${BASH_REMATCH[1]} --job ${BASH_REMATCH[2]} --log-failed)"
      gh run view "${BASH_REMATCH[1]}" --job "${BASH_REMATCH[2]}" --log-failed 2>/dev/null | ci_tail || true
    fi
  done < <(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" \
             --jq '.check_runs[] | select(.conclusion == "failure" or .conclusion == "timed_out") | [.name, .output.title // "", .output.summary // "", .details_url // ""] | @tsv' 2>/dev/null \
           | tr '\t' '\037' || true)
}

# agent_rules <worktree> <branch>: what the agent may run beyond reading and
# read-only git: settings.verify when it is plain words, and settings.implementAllow.
agent_rules() {
  local verify extra rule
  verify=$(cd "$1" && prc_get settings.verify "$2" false) || die "sd config failed"
  extra=$(cd "$1" && prc_get settings.implementAllow "$2" false) || die "sd config failed"
  if [[ $verify =~ ^[A-Za-z0-9_./:=@+-]+( [A-Za-z0-9_./:=@+-]+)*$ ]]; then echo "Bash($verify)"; fi
  while IFS= read -r rule; do [[ -z $rule ]] || echo "$rule"; done <<<"$extra"
}

ci_fix() {
  local b=$branch wt remote state s sha failing last base task verify vout vrc logs prompt result outcome summary msg before agent_head allow=$HARNESS_CLAUDE_ALLOW
  local -a rules
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  git -C "$wt" fetch --quiet "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  [[ $(prc_val "$state" 'nul(pr)') == false ]] || die "no PR for $b"
  s=$(prc_val "$state" 'coalesce(pr.state, "")')
  [[ $s == OPEN ]] || die "PR #$(prc_val "$state" pr.number) is $(tr '[:upper:]' '[:lower:]' <<<"$s"); nothing to fix"
  s=$(prc_val "$state" 'coalesce(ci.verdict, "none")')
  sha=$(prc_val "$state" 'coalesce(ci.sha, "")')
  case $s in
    red) ;;
    inconclusive) die "CI was cancelled, not red: rerun it (gh run rerun, or rwx retry), then wait" ;;
    *) die "CI is $s on $b; nothing to fix" ;;
  esac
  [[ $(prc_val "$state" 'on(ci.for_head)') == true ]] \
    || die "CI's red is for ${sha:0:7}, not HEAD: push if there is something to push, then wait for CI on HEAD"
  (( $(prc_val "$state" 'n(push.ahead)') == 0 )) \
    || die "$b has unpushed commits, which may be the fix already: sd act push, then wait for CI"
  failing=$(prc_val "$state" 'sj(coalesce(ci.failing, []), ", ")')
  last=$(git config --get "branch.$b.sd-ci-fix" || true)
  if ! $force && [[ ${last%% *} == "$sha" && ${last#* } == flaky ]]; then
    die "ci-fix already judged ${sha:0:7}'s red flaky and changed nothing; rerun CI (gh run rerun, or rwx retry), or look: gh pr checks. --force hands it over again"
  fi
  step_session "$b" ci-fix
  base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  # With no base from sd state, the trusted one guidance_base finds (maybe none).
  [[ -n $base ]] || base=$(guidance_base "$b") || die "can't find $b's base, to read its prompt guidance from"
  task=$(git config --get "branch.$b.sd-task" || true)

  # Zero tokens first: verify, autofix, verify. A fix there is the whole step.
  vout=$(mktemp)
  verify_autofix "$wt" "$b" >"$vout" 2>&1 && vrc=0 || vrc=$?   # set -e: a failing verify is data here
  if [[ -n $AUTOFIX_COMMIT ]]; then cat "$vout"; fi
  if (( vrc == 0 )) && [[ -n $AUTOFIX_COMMIT ]]; then
    rm -f "$vout"
    git config "branch.$b.sd-ci-fix" "$sha autofix"
    if $no_publish; then echo "autofix fixed what verify saw; not pushed (--no-publish): sd act push"; return; fi
    hold_gate "$b" "pushing $b"
    push_branch "$b" "$remote" || die "autofix's commit is kept in $wt, not pushed"
    echo "autofix fixed what verify saw; CI reruns on the push"
    return
  fi

  [[ -z $(git -C "$wt" status --porcelain) ]] \
    || die "verify ($VERIFY_CMD) changed files in $wt (a formatter?); commit them, then sd act ci-fix"
  logs=$(cd "$wt" && ci_logs "$sha")
  s=$(agent_rules "$wt" "$b") || die "sd config failed"
  rules=(); [[ -z $s ]] || mapfile -t rules <<<"$s"
  verify=$(cd "$wt" && prc_get settings.verify "$b" false) || die "sd config failed"
  prompt=$(cd "$wt" && step_guidance ciFixPrompt "$b" "$base" "$SD_LIB/prompts/ci-fix.md") || die "can't read the ci-fix guidance"
  prompt+=$'\n\nTask: '"${task:-(none recorded)}"
  prompt+=$'\n\nFailing checks on '"${sha:0:7}: $failing"
  [[ -z $logs ]] || prompt+=$'\n\n'"$logs"
  if [[ -z $VERIFY_CMD ]]; then
    prompt+=$'\n\nNo local checks are configured (settings.verify), so only CI\'s logs say what failed.'
  elif (( vrc == 0 )); then
    prompt+=$'\n\nThe repo\'s checks ('"$VERIFY_CMD"$') pass locally, so the failure may be in CI\'s environment, or in what CI runs that the local checks don\'t.'
  else
    prompt+=$'\n\nThe repo\'s checks ('"$VERIFY_CMD"$') fail locally too:\n'"$(<"$vout")"
  fi
  rm -f "$vout"
  [[ -z $verify ]] || prompt+=$'\n\nThe repo\'s checks, which the pipeline runs after you: '"$verify"
  if [[ $STEP_H == claude ]] && (( ${#rules[@]} )); then
    allow+=$(printf ',%s' "${rules[@]}")
    prompt+=$'\n\nBeyond reading files and read-only git, you may run only these (Claude Code permission rules); anything else is refused:\n'"$(printf '%s\n' "${rules[@]}")"
  else
    prompt+=$'\n\nYou can\'t run commands here beyond read-only git.'
  fi
  echo "sd act: $STEP_H ($STEP_MODE session $STEP_SID) is fixing CI on $b ($failing)…" >&2
  before=$(git rev-parse "refs/heads/$b")
  result=$(cd "$wt" && HARNESS_CLAUDE_ALLOW=$allow \
             && harness_run "$STEP_H" "$STEP_SID" "$STEP_MODE" "$STEP_TIMEOUT" "$prompt" "$CI_FIX_SCHEMA" "$STEP_CFG") \
    || { hold_since "$b" "$base" "$before"; die "the $STEP_H ci-fix step failed or returned no usable result (session $STEP_SID)"; }
  step_store "$b"
  hold_since "$b" "$base" "$before"
  agent_head=$(git rev-parse "refs/heads/$b")

  outcome=$(prc_val "$result" 'coalesce(outcome, "")')
  summary=$(prc_val "$result" 'coalesce(summary, "")')
  case $outcome in
    fixed) ;;
    flaky)
      [[ -z $(git -C "$wt" status --porcelain) ]] || die "the agent says flaky but edited files; they are left uncommitted in $wt"
      git config "branch.$b.sd-ci-fix" "$sha flaky"
      echo "$b: the agent calls ${sha:0:7}'s red flaky, not the change's: $summary"
      if [[ $agent_head != "$before" ]]; then echo "the agent committed anyway; kept, unpushed: look (git log $before..$b), then sd act push"
      elif [[ -n $AUTOFIX_COMMIT ]]; then echo "autofix's commit $AUTOFIX_COMMIT is kept, unpushed: sd act push"
      else echo "nothing committed; rerun CI (gh run rerun, or rwx retry), or look: gh pr checks"; fi
      return ;;
    needs-input) die "the agent needs input on $b: $summary"$'\n'"Edits (if any) are left uncommitted in $wt: answer in the session (sd act attach), then commit or discard them, then sd act ci-fix" ;;
    gave-up) die "the agent gave up on $b: $summary. Edits (if any) are left uncommitted in $wt" ;;
    *) die "the agent returned outcome \"$outcome\"; edits (if any) are left uncommitted in $wt" ;;
  esac
  [[ -n $(git -C "$wt" status --porcelain) ]] || die "the agent says fixed but changed nothing (session $STEP_SID)"
  msg=$(prc_line 'values {m: coalesce(commit_message, null)}
    | values case when is(m, <string>) and grep("\\S", m) then m else "" end' "$result")
  [[ -n $msg ]] || msg="Fix CI: ${failing%%,*}"
  git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || die "commit failed; the edits are left in $wt"
  echo "$b: $summary"
  git -C "$wt" log --format='  %h %s' "$before..refs/heads/$b"
  hold_since "$b" "$base" "$agent_head"
  verify_autofix "$wt" "$b" || die "verify failed ($VERIFY_CMD); the commit is kept in $wt, nothing pushed"
  git config "branch.$b.sd-ci-fix" "$sha fixed"
  if $no_publish; then echo "not pushed (--no-publish): sd act push when ready"; return; fi
  hold_gate "$b" "pushing $b"
  push_branch "$b" "$remote" || die "the fix is committed in $wt, not pushed"
  echo "CI reruns on the push"
}

# ── describe ─────────────────────────────────────────────────────────────────

# The describe step's prompt: guidance (settings.describePrompt, else
# .sheepdog/describe.md in the base commit, else lib/prompts/describe.md), then
# this contract.
read -r -d '' DESCRIBE_CONTRACT <<'EOF' || true
You are read-only here; look at the worktree when the diff needs context.
EOF

read -r -d '' DESCRIBE_SCHEMA <<'EOF' || true
{"type": "object", "required": ["title", "body"],
 "properties": {"title": {"type": "string", "minLength": 1}, "body": {"type": "string"}}}
EOF

describe_file() { echo "$(cd "$(git rev-parse --git-common-dir)" && pwd)/sheepdog/${1//\//__}.describe.json"; }

# describe_base <state>: the prompt's line on what the PR targets (sync.target,
# the base ship sets), so the body doesn't describe a merged parent as pending
# (#105). The description is stored with that target: a new one (a parent
# merged under an unchanged HEAD) makes it stale. One stored before #105 has
# none, so it is written again once.
describe_base() {
  local state=$1 target
  target=$(prc_val "$state" sync.target)
  if [[ $(prc_val "$state" 'coalesce(parent.merged, false)') == true ]]; then
    echo "Base: $(prc_val "$state" parent.name) has merged into $target, so this PR targets $target; don't describe the parent as pending."
  elif [[ $target != $(prc_val "$state" sync.default) ]]; then
    echo "Base: this PR is stacked on $target; describe only this branch's change."
  else
    echo "Base: this PR targets $target."
  fi
}

# describe_run <branch> <worktree> <state>: the describe step in the branch's
# session (minted if none), read-only. Stores {head, target, title, body} where ship
# finds it, and prints it.
describe_run() {
  local b=$1 wt=$2 state=$3 base head task commits diff result f guidance
  base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  [[ -n $base ]] || die "can't find $b's base: $(no_base_why "$b" "$state")"
  head=$(git rev-parse "refs/heads/$b")
  step_session "$b" describe
  task=$(git config --get "branch.$b.sd-task" || true)
  commits=$(git log --format='- %s' "$base..$head")
  diff=$(git diff "$base" "$head")
  local where; where=$(describe_base "$state")
  guidance=$(cd "$wt" && step_guidance describePrompt "$b" "$base" "$SD_LIB/prompts/describe.md") \
    || die "can't read the describe guidance"
  echo "sd act: $STEP_H ($STEP_MODE session $STEP_SID) is describing $b…" >&2
  result=$(cd "$wt" && HARNESS_CLAUDE_ALLOW=$HARNESS_READONLY_ALLOW && HARNESS_PI_TOOLS=read \
             && harness_run "$STEP_H" "$STEP_SID" "$STEP_MODE" "$STEP_TIMEOUT" \
                  "$guidance"$'\n\n'"$DESCRIBE_CONTRACT"$'\n\nTask: '"${task:-(none recorded)}"$'\n\n'"$where"$'\n\nCommits ('"${base:0:7}..${head:0:7}"$'):\n'"$commits"$'\n\nDiff:\n'"$diff" \
                  "$DESCRIBE_SCHEMA" "$STEP_CFG") \
    || die "the $STEP_H describe step failed or returned no usable result (session $STEP_SID)"
  [[ $(prc_val "$result" 'case when is(coalesce(title, null), <string>) then grep("\\S", title) else false end' 2>/dev/null) == true ]] \
    || die "the $STEP_H describe step returned no title"
  step_store "$b"
  f=$(describe_file "$b")
  mkdir -p "$(dirname "$f")"
  prc_json 'values {head, target, title: r.title, body: coalesce(r.body, "")}' \
    "{\"head\": \"$head\", \"target\": $(prc_json_string "$(prc_val "$state" sync.target)"), \"r\": $result}" > "$f"
  cat "$f"
}

describe() {
  local b=$branch wt state
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  attached_check "$b" "describing $b"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  describe_run "$b" "$wt" "$state"
}

# ── ship ─────────────────────────────────────────────────────────────────────

ship() {
  local b=$branch wt remote state pr_state f head parent number url title body
  local -a base_arg=()
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  if ! $force && [[ -n $(git config --get "branch.$b.sd-lock" || true) ]]; then
    die "not shipping $b: taken over (branch.$b.sd-lock is set; --force to ship anyway)"
  fi
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  git -C "$wt" fetch --quiet --prune "$remote" || die "fetch from $remote failed"
  hold_gate "$b" "shipping $b"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  pr_state=$(prc_val "$state" 'coalesce(pr.state, "none")')
  case $pr_state in
    none|OPEN) ;;
    *) die "PR #$(prc_val "$state" pr.number) is $(tr '[:upper:]' '[:lower:]' <<<"$pr_state"); nothing to ship" ;;
  esac
  if [[ -z $(git config --get "branch.$b.sd-parent" || true) && $pr_state == none ]]; then
    # A plain git branch from another's tip (#94) would open on the default branch.
    (cd "$wt" && record_lineage "$b" "$state") || die "not shipping $b until its parent is recorded"
    [[ -z $(git config --get "branch.$b.sd-parent" || true) ]] \
      || state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  fi
  # sd state's parent: sd-parent, else the PR's base, else the default branch.
  parent=$(prc_val "$state" parent.name)
  if [[ $parent != "$(prc_val "$state" sync.default)" ]]; then
    # Like RESTACK_GATE: a parent whose state is unknown or closed is nobody's
    # to ship onto; a merged one means restack first, unless the branch is
    # already on the target (a fast-forward or rebase merge), in which case
    # the parent is the default branch from here on; an open parent must be
    # on the remote before its child can be: ship the parent first.
    local pstate
    pstate=$(prc_val "$state" 'parent.merged is null ? "unknown" : on(parent.pr.state == "CLOSED") ? "closed"
      : on(parent.merged) ? (on(sync.up_to_date) ? "merged-on-target" : "merged") : "open"') \
      || die "can't parse sd state's answer"
    case $pstate in
      open) git -C "$wt" show-ref -q --verify "refs/remotes/$remote/$parent" \
              || die "can't ship $b onto $parent: $(no_base_why "$b" "$state")" ;;
      unknown) die "can't tell whether $parent merged: $(prc_val "$state" 'sj(coalesce(errors, []), "; ")')" ;;
      closed) die "parent $parent (#$(prc_val "$state" parent.pr.number)) was closed without merging: decide what $b targets (git config branch.$b.sd-parent <branch>), then ship" ;;
      merged) die "parent $parent has merged: sd act restack first, which lands $b on $(prc_val "$state" sync.target) and rewrites sd-parent" ;;
      merged-on-target) parent_to_default "$b" "$state"; parent=$(prc_val "$state" sync.default) ;;
      *) die "can't read the parent's state from sd state: $pstate" ;;
    esac
  fi
  prc_line 'where not (coalesce(review.local.status, "none") in ["covered", "rewritten-same"])
    | values "sd act: warning: the local review doesn'"'"'t cover HEAD (sd act review); the PR stays a draft until it does"' "$state" >&2
  head=$(git rev-parse "refs/heads/$b")
  f=$(describe_file "$b")
  if [[ ! -f $f || $(prc_line 'values f"{head} {coalesce(target, "")}"' "$(<"$f")" 2>/dev/null) != "$head $(prc_val "$state" sync.target)" ]]; then
    describe_run "$b" "$wt" "$state" >/dev/null
    [[ $(git rev-parse "refs/heads/$b") == "$head" ]] \
      || die "HEAD moved during the describe step (${head:0:7} → $(git rev-parse --short "refs/heads/$b")); nothing pushed. Look, then ship again"
  fi
  title=$(prc_line 'values title' "$(<"$f")") body=$(prc_line 'values body' "$(<"$f")")
  push_branch "$b" "$remote" || exit 1
  if [[ $pr_state == none ]]; then
    url=$(gh pr create --draft --base "$parent" --head "$b" --title "$title" --body "$body") \
      || die "gh pr create failed; $b is pushed. Fix the cause and ship again"
    echo "opened a draft PR for $b on $parent: $url"
    enroll_branch "$b"
  else
    number=$(prc_val "$state" pr.number)
    [[ $(prc_val "$state" pr.base) == "$parent" ]] || base_arg=(--base "$parent")
    gh pr edit "$number" --title "$title" --body "$body" "${base_arg[@]}" >/dev/null \
      || die "gh pr edit failed for PR #$number; $b is pushed"
    echo "shipped $b: PR #$number updated$( (( ${#base_arg[@]} )) && echo ", base now $parent")"
  fi
}

# ── trigger ──────────────────────────────────────────────────────────────────

read -r -d '' TRIGGER_GATE <<'EOF' || true
values {s: this, why: sj(coalesce(errors, []), "; ")}
| values case
    when nul(s.pr) then {hard: f"no PR for {s.branch}{why != "" ? f": {why}" : ""}"}
    when on(s.pr.state != "OPEN") then {hard: f"PR #{s.pr.number} is {lower(s.pr.state)}"}
    when n(s.push.behind) > 0 and n(s.push.ahead) == 0 and on(s.push.remote_ours) and on(s.push.remote_made) and on(s.push.dirty)
      then {hard: f"{s.branch} isn't on the remote at HEAD; the bot reviews what GitHub has: commit or remove the worktree's changes, then sd act push"}
    when nul(s.push.remote_sha) or n(s.push.ahead) > 0 or on(s.push.diverged) or (n(s.push.behind) > 0 and on(s.push.remote_ours) and on(s.push.remote_made))
      then {hard: f"{s.branch} isn't on the remote at HEAD; the bot reviews what GitHub has: sd act push first"}
    when n(s.push.behind) > 0
      then {hard: f"{s.branch} isn't on the remote at HEAD; the bot reviews what GitHub has: take its commits first (git merge --ff-only)"}
    when on(s.review.bot.status == "covered") then {done: f"the bot was already triggered on {s.head[0:7]}"}
    when not (coalesce(s.review.local.status, "") in ["covered", "rewritten-same"])
      then {soft: "the local review doesn't cover HEAD (sd act review)"}
    else {} end
EOF

# The comment goes over REST, which answers with its created_at: the trigger
# time by GitHub's clock, which sd state compares with the bot's replies
# (also GitHub's clock), so a skewed laptop can't make a reply look older
# than the trigger (#63). The repo comes from the PR's URL, not
# {owner}/{repo}: gh's default repo may be a fork.
trigger() {
  local b=$branch state command gate line head base number url at
  command=$(prc_get settings.botCommand "$b" false) || die "sd config failed"
  [[ -n $command ]] || die "no settings.botCommand configured: the comment that makes the review bot run"
  state=$(sd-state --json "$b") || die "sd state failed"
  gate=$(prc_json "$TRIGGER_GATE" "$state") || die "can't parse sd state's answer"
  line=$(gate_get "$gate" hard); [[ -z $line ]] || die "$line"
  line=$(gate_get "$gate" done)
  if [[ -n $line ]] && ! $force; then echo "$line (--force to trigger again)"; return; fi
  line=$(gate_get "$gate" soft)
  if [[ -n $line ]] && ! $force; then die "not triggering the bot on $b: $line (--force to trigger anyway)"; fi
  head=$(git rev-parse "refs/heads/$b")
  base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  [[ -n $base ]] || die "can't find $b's base: $(no_base_why "$b" "$state")"
  number=$(prc_val "$state" pr.number)
  url=$(prc_val "$state" pr.url)
  [[ $url =~ ^https://([^/]+)/([^/]+/[^/]+)/pull/[0-9]+$ ]] || die "can't tell PR #$number's repo from its URL: $url"
  at=$(gh api "repos/${BASH_REMATCH[2]}/issues/$number/comments" --hostname "${BASH_REMATCH[1]}" \
         -f body="$command" --jq '.created_at // ""') \
    || die "posting the trigger comment failed; nothing pinned"
  if [[ ! $at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
    at=$(date -u +%FT%TZ)
    echo "sd act: warning: GitHub's answer had no created_at; the trigger time is this machine's local clock" >&2
  fi
  pin_write "$b" bot "$head" "$base"
  git config "branch.$b.sd-bot-triggered" "$at"
  echo "triggered the review bot on PR #$number with \"$command\"; bot pinned at ${head:0:7}, waiting for its reply"
}

# ── CI config hold (#124) ────────────────────────────────────────────────────

hold_say() { echo "the agent changed CI config (${1//$'\n'/, }): review, then sd act push"; }

# hold_paths <branch> <remote>: the paths an active hold names, one per line.
# Status 1: none; 2: the hold can't be read. It runs in $( ), so it never
# dies (that would only end the subshell, and read as no hold): callers turn 2
# into a refusal. A hold whose commit is on the remote was published some
# other way, so it is cleared (reconcile, not enforce).
hold_paths() {
  local b=$1 v rsha rc=0
  v=$(git config --get "branch.$b.sd-held") || rc=$?
  (( rc == 0 )) || { (( rc == 1 )) && return 1; return 2; }
  rsha=$(git rev-parse -q --verify "refs/remotes/$2/$b^{commit}" || true)
  if [[ -n $rsha ]] && git merge-base --is-ancestor "${v%%$'\n'*}" "$rsha" 2>/dev/null; then
    git config --unset "branch.$b.sd-held" || return 2
    return 1
  fi
  printf '%s\n' "${v#*$'\n'}"
}

# hold_read <branch> <doing>: hold_paths, with settings.remote read here
# (outside $( ), where die exits) and an unreadable hold refused.
hold_read() {
  local remote rc=0
  remote=$(prc_get settings.remote "$1" false) || die "sd config failed"
  HOLD_PATHS=$(hold_paths "$1" "$remote") || rc=$?
  (( rc != 2 )) || die "not $2: can't read branch.$1.sd-held, the CI config hold"
  return "$rc"
}

# hold_after <branch> <base> <files>: after an agent step's edits are
# committed, the files they changed (one per line) against protected_paths
# (read from <base>). On a match, hold the branch: branch.<b>.sd-held is HEAD,
# then the paths, an active hold's included, one per line. The automated
# pushes (address, ci-fix, ship) refuse while it holds; chrismo running sd act
# push is the approval, and clears it. A HEAD already on the remote-tracking
# ref was pushed during the step, by the agent (the deny on git push is no
# guarantee either): a hold would only be cleared as published, unseen, so
# that fails loudly instead.
hold_after() {
  local b=$1 paths hits prev="" remote rsha
  paths=$(protected_paths "$b" "$2") || die "sd config failed"
  hits=$(protected_hits "$paths" "$3")
  [[ -n $hits ]] || return 0
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  rsha=$(git rev-parse -q --verify "refs/remotes/$remote/$b^{commit}" || true)
  if [[ -n $rsha ]] && git merge-base --is-ancestor "refs/heads/$b" "$rsha"; then
    die "the agent pushed CI config itself (${hits//$'\n'/, }): it is on $remote/$b unreviewed; review it now (git log -p $remote/$b -- ${hits//$'\n'/ })"
  fi
  if hold_read "$b" "holding $b"; then prev=$HOLD_PATHS; fi
  hits=$(printf '%s\n' "$prev" "$hits" | sed '/^$/d' | sort -u)
  git config "branch.$b.sd-held" "$(git rev-parse "refs/heads/$b")"$'\n'"$hits"
  echo "held: $(hold_say "$hits")"
}

# hold_since <branch> <base> <since>: hold_after over <since>..the branch, if
# it moved. Each agent step runs it right after the harness returns, failed
# or not, before any outcome can die (the agent may commit itself: the deny is no
# guarantee), and again from there over the pipeline's own commit.
hold_since() {
  [[ $(git rev-parse "refs/heads/$1") != "$3" ]] || return 0
  hold_after "$1" "$2" "$(git diff -z --name-only --no-renames "$3" "refs/heads/$1" | tr '\0' '\n')"
}

# hold_gate <branch> <doing> [<then>]: refuse <doing> while a hold is active;
# <then> follows the message.
hold_gate() {
  hold_read "$1" "$2" || return 0
  die "not $2: $(hold_say "$HOLD_PATHS")${3:+. $3}"
}

# ── push ─────────────────────────────────────────────────────────────────────

plural() { if (( $1 == 1 )); then echo "1 $2"; else echo "$1 $2s"; fi; }

# push_branch <branch> <remote>: publish <branch> as fetched just now. Rewritten
# history, or a pushed commit reset away, is force-pushed with a lease on that
# remote head, and only when the head is in the branch's reflog (we put it there).
push_branch() {
  local b=$1 remote=$2 rsha ahead behind reflog theirs
  git fetch --quiet --prune "$remote" || { echo "sd act: fetch from $remote failed" >&2; return 1; }
  rsha=$(git rev-parse -q --verify "refs/remotes/$remote/$b^{commit}" || true)
  if [[ -z $rsha ]]; then
    push_ref "$b" "$remote" "" || return
    echo "pushed $b to $remote (new branch)"
    track "$b" "$remote"
    return
  fi
  ahead=$(git rev-list --count "$rsha..refs/heads/$b")
  behind=$(git rev-list --count "refs/heads/$b..$rsha")
  if (( ahead == 0 && behind == 0 )); then
    echo "nothing to push on $b"
  elif (( behind == 0 )); then
    push_ref "$b" "$remote" "$rsha" || return
    echo "pushed $b to $remote ($(plural "$ahead" commit))"
  else
    # The remote has commits this branch doesn't. Ours (in the branch's
    # reflog: an amend, or a pushed commit reset away, #86) are replaced with
    # a lease; anyone else's are never pushed over.
    # Not piped into grep -q: under pipefail, git dying of SIGPIPE would read as "not ours".
    reflog=$(git reflog show --format=%H "refs/heads/$b")
    if ! grep -qx "$rsha" <<<"$reflog"; then
      if (( ahead == 0 )); then
        echo "sd act: $remote/$b has $(plural "$behind" commit) you don't; take them with: git merge --ff-only $remote/$b" >&2
      else
        theirs=$(commits_not_ours "$reflog" "$rsha")
        echo "sd act: $remote/$b has $(plural "$theirs" commit) this copy has never had; not pushing over it." \
             "Look: git log $b..$remote/$b, then rebase onto or merge $remote/$b and push again" >&2
      fi
      return 1
    fi
    if (( ahead == 0 )); then
      # Dropping needs more than "the branch once pointed there": a commit
      # taken with merge --ff-only (or a pull, or a rebase onto the remote)
      # and reset away is in the reflog too, and it was someone else's work.
      # Every commit being dropped must have been made here (made_here).
      if ! made_here "refs/heads/$b..$rsha"; then
        echo "sd act: $remote/$b has $(plural "$behind" commit) you don't; this branch had them but didn't make them all, so take them back (git merge --ff-only $remote/$b), or drop them by hand" >&2
        return 1
      fi
      # A soft or mixed reset looks the same as a deliberate drop, except the
      # changes are still in the worktree: don't throw the remote commit away
      # under them.
      local wt st=""; wt=$(worktree_for "$b")
      if [[ -n $wt ]] && ! st=$(git -C "$wt" status --porcelain); then
        echo "sd act: can't read $wt's status; not dropping the remote commit" >&2
        return 1
      fi
      if [[ -n $st ]]; then
        echo "sd act: $remote/$b has $(plural "$behind" commit) this branch was reset off, and $wt has uncommitted or untracked changes:" \
             "commit them (then push replaces the remote commit), or drop them (git reset --hard; git clean -n shows the untracked ones)" >&2
        return 1
      fi
    fi
    push_ref "$b" "$remote" "$rsha" --force-with-lease="refs/heads/$b:$rsha" || return
    if (( ahead == 0 )); then
      echo "force-pushed $b to $remote (dropped $(plural "$behind" commit); the remote head ${rsha:0:7} was ours)"
    else
      echo "force-pushed $b to $remote (rewritten; the remote head ${rsha:0:7} was ours)"
    fi
  fi
  track "$b" "$remote"
}

track() {
  git config "branch.$1.remote" "$2" && git config "branch.$1.merge" "refs/heads/$1" \
    || echo "sd act: warning: $1 is pushed, but its upstream isn't $2/$1: git branch --set-upstream-to=$2/$1 $1" >&2
}

# push_ref <branch> <remote> <expected-remote-sha> [push options...]
push_ref() {
  local b=$1 remote=$2 expected=$3 err now
  shift 3
  if ! err=$(git push --quiet "$@" "$remote" "refs/heads/$b:refs/heads/$b" 2>&1); then
    now=$(git ls-remote "$remote" "refs/heads/$b" 2>/dev/null | cut -f1)
    if [[ $now != "$expected" ]]; then
      echo "sd act: $remote/$b moved while pushing; nothing pushed. Run it again to see what changed" >&2
    else
      echo "sd act: push to $remote failed: ${err//$'\n'/ }" >&2
    fi
    return 1
  fi
}

push() {
  local remote
  git rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no such branch: $branch"
  if ! $force && [[ -n $(git config --get "branch.$branch.sd-lock" || true) ]]; then
    die "not pushing $branch: taken over (branch.$branch.sd-lock is set; --force to push anyway)"
  fi
  remote=$(prc_get settings.remote "$branch" false) || die "sd config failed"
  push_branch "$branch" "$remote" || exit 1
  # chrismo pushing is the approval of what an agent changed in CI config.
  if git config --get "branch.$branch.sd-held" >/dev/null; then
    git config --unset "branch.$branch.sd-held"
    echo "released the CI config hold on $branch"
  fi
}

# ── restack ──────────────────────────────────────────────────────────────────

# -U0: an upstream edit next to the branch's lines must not read as a change.
patch_id() { git diff -U0 "$1" "$2" | git patch-id --stable | cut -d' ' -f1; }

# Over {remote, resolve, replay: old_base..HEAD, newest first, s: the sd state JSON}.
read -r -d '' RESTACK_GATE <<'EOF' || true
values {remote, resolve, s, onto: f"{remote}/{s.sync.target}",
        why: len(coalesce(s.errors, [])) > 0 ? sj(s.errors, "; ")
             : on(s.parent.unpushed) ? f"parent {s.parent.name} isn't on {remote} yet: ship it first (sd act ship {s.parent.name})" : "",
        from_parent: coalesce([unnest {p: coalesce(s.parent.pr.commits, []), r: replay} | where r in p | values r], [])}
| values [
    on(s.parent.pr.state == "CLOSED") and on(s.parent.name != s.sync.default)
      ? {hard: f"{s.parent.name}'s PR #{s.parent.pr.number} was closed without merging; decide what {s.branch} targets"}
    : nul(s.parent.merged) and on(s.parent.name != s.sync.default)
      ? {hard: f"can't tell whether {s.parent.name} merged: {why}"}
    : null,
    nul(s.sync.up_to_date) or (on(s.sync.up_to_date == false) and nul(s.sync.old_base))
      ? {hard: f"can't restack {s.branch}: {why}"}
    : on(s.sync.up_to_date) ? {done: f"{s.branch} is already on {onto}"}
    : on(s.parent.merged) and not on(s.sync.by_tree) and len(from_parent) > 0
      ? {hard: f"wrong base: this would replay {len(from_parent)} of #{s.parent.pr.number}'s commits onto {onto}; if the stack is linear, rebase past them by hand: git rebase --onto {onto} {from_parent[0][0:12]} {s.branch} && git update-ref refs/sheepdog/{s.branch}/base {onto}"}
    : nul(s.sync.conflict) ? {hard: f"can't tell whether restacking {s.branch} would conflict: {why}"}
    : on(s.sync.by_tree) and on(s.sync.conflict)
      ? {hard: f"restacking {s.branch} onto {onto} by tree would conflict; --resolve can't resolve a tree restack. By hand: git switch {s.branch} && git reset --hard {onto} && git diff --binary {s.sync.old_base[0:12]} {s.head[0:12]} | git apply -3, resolve and commit, then git update-ref refs/sheepdog/{s.branch}/base {onto} (the old head stays at {s.head[0:12]})"}
    : on(s.sync.conflict) and not resolve
      ? {hard: f"restacking {s.branch} onto {onto} would conflict; resolve it by hand: git rebase --onto {onto} {s.sync.old_base[0:12]} {s.branch}, then git update-ref refs/sheepdog/{s.branch}/base $(git merge-base {onto} {s.branch}); or let the agent: sd act restack --resolve"}
    : null,
    on(s.session.locked) ? {soft: f"taken over (branch.{s.branch}.sd-lock is set)"} : null
  ]
| values coalesce([unnest this | where this is not null], [])
EOF

# Over the sd state JSON: why sd-parent stays on a merged parent, else nothing.
# Until the PR targets the default branch, sd-parent is what keeps retarget
# owed: deleting the merged parent's branch would close a PR still on it.
read -r -d '' KEEP_PARENT <<'EOF' || true
where on(parent.merged)
| values {s: this, gh: f"gh ({branch}):"}
| values nul(s.pr)
    ? (len(coalesce([unnest {gh, e: coalesce(s.errors, [])} | where e[0:len(gh)] == gh], [])) > 0
       ? f"sd-parent of {s.branch} stays {s.parent.name}: can't read its PR" : null)
  : on(s.pr.state == "OPEN") and on(s.pr.base != s.sync.default)
    ? f"PR #{s.pr.number} still targets {s.pr.base}: sd act retarget" : null
| where this is not null
EOF

restack() {
  local b=$branch wt remote state gate line target new_base old_base old_head new_head before replay
  wt=$(worktree_for "$b")
  [[ -n $wt ]] || die "$b isn't checked out in any worktree"
  [[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
  remote=$(prc_get settings.remote "$b" false) || die "sd config failed"
  git -C "$wt" fetch --quiet --prune "$remote" || die "fetch from $remote failed"
  state=$(cd "$wt" && sd-state --json "$b") || die "sd state failed"
  old_base=$(prc_val "$state" 'coalesce(sync.old_base, "")')
  replay='[]'
  if [[ -n $old_base && $(prc_val "$state" 'on(parent.merged) and on(sync.up_to_date == false)') == true ]]; then
    replay=$(git rev-list --topo-order "$old_base..refs/heads/$b" | prc_strings) || die "can't list $old_base..$b"
  fi

  gate=$(prc_json "$RESTACK_GATE" "{\"remote\": $(prc_json_string "$remote"), \"resolve\": $resolve, \"replay\": $replay, \"s\": $state}") \
    || die "can't parse sd state's answer"
  line=$(gate_get "$gate" hard | head -1)
  [[ -z $line ]] || die "$line"
  line=$(gate_get "$gate" done)
  if [[ -n $line ]]; then echo "$line"; return; fi
  soft_gate "$gate" "restacking $b"

  target=$(prc_val "$state" sync.target)
  new_base=$(git rev-parse "refs/remotes/$remote/$target^{commit}")
  old_head=$(git rev-parse "refs/heads/$b")
  before=$(patch_id "$old_base" "$old_head")
  local resolved=false by_tree via=""
  by_tree=$(prc_val "$state" sync.by_tree)
  if [[ $by_tree == true ]]; then
    restack_by_tree "$wt" "$b" "$old_base" "$old_head" "$new_base" "$remote/$target"
    via=" by tree"
  elif ! git -C "$wt" rebase --quiet --onto "$new_base" "$old_base" "$b" >/dev/null 2>&1; then
    if ! $resolve; then
      restack_rollback "$wt" "$b" "$old_head"
      die "the rebase onto $remote/$target stopped on a conflict partway through; rolled back to ${old_head:0:7}." \
          "Resolve it by hand: git rebase --onto ${new_base:0:12} ${old_base:0:12} $b, then git update-ref refs/sheepdog/$b/base ${new_base:0:12}; or let the agent: sd act restack --resolve"
    fi
    resolve_conflicts "$b" "$wt" "$old_base" "$old_head" "$remote/$target" || exit 1
    resolved=true
    # Before anything below can die: the resolution is on the branch now.
    hold_after "$b" "$old_base" "$RESOLVE_TOUCHED"
  fi
  new_head=$(git rev-parse "refs/heads/$b")
  # A resolution changes the branch's diff by definition, so the check only
  # applies to a clean rebase; a resolved one goes through verify and review.
  if ! $resolved && [[ $(patch_id "$new_base" "$new_head") != "$before" ]]; then
    git -C "$wt" reset --quiet --hard "$old_head"
    die "$b's change came out different on $remote/$target (part of it may be there already); rolled back to ${old_head:0:7}." \
        "Compare: git range-diff ${old_base:0:12}..${old_head:0:12} ${new_base:0:12}..${new_head:0:12}"
  fi
  git update-ref -m "sd act restack" "refs/sheepdog/$b/base" "$new_base"
  local how="sd act push"
  # A plain push is rejected once the remote head is no longer an ancestor.
  if git show-ref -q --verify "refs/remotes/$remote/$b" && ! git merge-base --is-ancestor "refs/remotes/$remote/$b" "$new_head"; then
    how="a plain git push is rejected now, and git's pull advice would undo the restack; use sd act push"
  fi
  echo "restacked $b onto $remote/$target$via ($(plural "$(git rev-list --count "$new_base..$new_head")" commit)); not pushed: $how"
  [[ -z $via ]] || echo "$b's commits are now one, committed by you; the old ones are at ${old_head:0:7}"
  line=$(prc_line "$KEEP_PARENT" "$state") \
    || die "restacked $b, but couldn't tell whether its PR still targets the parent; sd-parent left as is$($resolved && echo ". The agent resolved conflicts, so verify and review: sd act verify, sd act review")"
  if [[ -n $line ]]; then echo "$line"; else parent_to_default "$b" "$state"; fi
  if $resolved; then
    echo "conflicts resolved by the agent, so $b's change is unreviewed: sd act review next"
    verify_run "$wt" "$b" || die "verify failed ($VERIFY_CMD) on the resolved branch; it is kept at ${new_head:0:7}, unpushed. Fix, then sd act verify"
  fi
}

# restack_by_tree <worktree> <branch> <old-base> <old-head> <new-base> <onto>:
# <old-base>..<old-head>'s change as one commit on <new-base>, by a tree merge,
# for an old base that isn't an ancestor (sd state's sync.by_tree). The message
# leaves out exact copies of the parent's commits: their change is on the target.
restack_by_tree() {
  local tree new
  tree=$(git merge-tree --write-tree --merge-base="$3" "$5" "$4") \
    || die "restacking $2 onto $6 by tree hit a conflict; nothing moved"
  new=$(printf '%s (restacked by tree onto %s)\n\nReplaces:\n%s\n' "$2" "$6" "$(git log --reverse --format=%s --right-only --cherry-pick "$3...$4")" \
          | git commit-tree "$tree" -p "$5") || die "git commit-tree failed; nothing moved"
  # Not "reset: moving to" in the reflog: stacked_on counts this commit as the branch's own.
  GIT_REFLOG_ACTION="sd act restack by tree" git -C "$1" reset --quiet --hard "$new"
}

restack_rollback() { # <worktree> <branch> <old-head>
  git -C "$1" rebase --abort 2>/dev/null || true
  [[ $(git rev-parse "refs/heads/$2") == "$3" ]] || git -C "$1" reset --quiet --hard "$3"
}

# ── --resolve: J1 ────────────────────────────────────────────────────────────

RESOLVE_CAP=3

# The resolve step's prompt: guidance (settings.resolvePrompt, else
# .sheepdog/resolve.md in the base commit, else lib/prompts/resolve.md), then
# this contract, which the restack's rollback and refusals rely on.
read -r -d '' RESOLVE_CONTRACT <<'EOF' || true
Do not run git add, git rebase --continue, or commit: the pipeline does that
after you, and it will stop again if another commit conflicts. If no sensible
resolution exists, answer with outcome "gave-up" and say why; nothing you
changed will be kept.

Before resolving, judge whether the commit being replayed (named below, among
all the commits this rebase replays) is this branch's work, from its subject,
the files it changes and the task. If it isn't, and its change is already on the target
(e.g. a merged parent's commit, which the target holds as a squash), the replay
itself is wrong: don't resolve it, answer with outcome "already-on-target" and
say why. The pipeline rolls back and refuses; it never drops a commit on your
word.
EOF

read -r -d '' RESOLVE_SCHEMA <<'EOF' || true
{"type": "object", "required": ["outcome", "summary"],
 "properties": {"outcome": {"enum": ["done", "gave-up", "already-on-target"]}, "summary": {"type": "string"}}}
EOF

# worktree_tree <worktree>: the tree of everything in it, tracked or not
# (ignored files aside), staged or not, through a scratch index; the real
# index, mid-rebase, is left alone.
worktree_tree() {
  local dir tree rc=0
  dir=$(mktemp -d) || return 1
  tree=$(export GIT_INDEX_FILE=$dir/index
         git -C "$1" read-tree HEAD && git -C "$1" add -A && git -C "$1" write-tree) || rc=1
  rm -rf "$dir"
  (( rc == 0 )) && echo "$tree"
}

# resolve_conflicts <branch> <worktree> <old-base> <old-head> <onto>: a rebase
# has stopped; the agent resolves each stop in the branch's session, the
# pipeline adds and continues. Any failure rolls the branch back and returns 1.
# RESOLVE_TOUCHED is the files the agent changed, one per line: the worktree
# before and after each stop compared whole, so staging or committing them
# itself hides nothing.
resolve_conflicts() {
  local b=$1 wt=$2 old_base=$3 old_head=$4 onto=$5 stops=0 files hunks task result outcome replayed replaying replaying_stat guidance snap after
  RESOLVE_TOUCHED=""
  task=$(git config --get "branch.$b.sd-task" || true)
  replayed=$(git log --reverse --no-merges --topo-order --format='%h %s' "$old_base..$old_head")
  step_session "$b" implement
  if ! guidance=$(cd "$wt" && step_guidance resolvePrompt "$b" "$old_base" "$SD_LIB/prompts/resolve.md"); then
    restack_rollback "$wt" "$b" "$old_head"
    die "can't read the resolve guidance; rolled back to ${old_head:0:7}"
  fi
  while :; do
    if (( ++stops > RESOLVE_CAP )); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the rebase onto $onto stopped $stops times (cap $RESOLVE_CAP); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    files=$(git -C "$wt" diff --name-only --diff-filter=U)
    if [[ -z $files ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the rebase stopped without conflicting files; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    hunks=$(git -C "$wt" diff)
    replaying=$(git -C "$wt" log -1 --format='%h %s' REBASE_HEAD)
    replaying_stat=$(git -C "$wt" show --stat --format= REBASE_HEAD)
    if ! snap=$(worktree_tree "$wt"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: can't snapshot $wt before the agent runs; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    echo "sd act: $STEP_H ($STEP_MODE session $STEP_SID) is resolving conflicts in: ${files//$'\n'/, } (stop $stops)…" >&2
    if ! result=$(cd "$wt" && harness_run "$STEP_H" "$STEP_SID" "$STEP_MODE" "$STEP_TIMEOUT" \
                    "$guidance"$'\n\n'"$RESOLVE_CONTRACT"$'\n\nBranch: '"$b"$', rebasing onto '"$onto"$'\nTask: '"${task:-(none recorded)}"$'\nReplaying: '"$replaying"$'\n'"$replaying_stat"$'\n\n'"Commits being replayed, oldest first:"$'\n'"$replayed"$'\n\nConflicting files:\n'"$files"$'\n\nConflict hunks:\n'"$hunks" \
                    "$RESOLVE_SCHEMA" "$STEP_CFG"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the $STEP_H step failed or returned no usable result (session $STEP_SID); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    step_store "$b"
    STEP_MODE=resume
    outcome=$(prc_val "$result" 'coalesce(outcome, "")')
    if [[ $outcome == already-on-target ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: wrong base: the agent says $replaying is already on $onto ($(prc_val "$result" 'coalesce(summary, "")')); rolled back to ${old_head:0:7}." \
           "If it's a merged parent's and the stack is linear, rebase past it by hand: git rebase --onto $onto ${replaying%% *} $b," \
           "then git update-ref refs/sheepdog/$b/base \$(git merge-base $onto $b)" >&2
      return 1
    fi
    if [[ $outcome != done ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: the agent gave up: $(prc_val "$result" 'coalesce(summary, "")'); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    if ! after=$(worktree_tree "$wt"); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: can't read what the agent changed in $wt; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    RESOLVE_TOUCHED+=$(git diff-tree -z -r --name-only --no-renames "$snap" "$after" | tr '\0' '\n')$'\n'
    if (cd "$wt" && grep -lE '^(<<<<<<< |>>>>>>> )' $files 2>/dev/null | grep -q .); then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: conflict markers left in: $(cd "$wt" && grep -lE '^(<<<<<<< |>>>>>>> )' $files | tr '\n' ' '); rolled back to ${old_head:0:7}" >&2
      return 1
    fi
    git -C "$wt" add -A
    if GIT_EDITOR=true git -C "$wt" rebase --continue >/dev/null 2>&1; then return 0; fi
    if [[ ! -e $(git -C "$wt" rev-parse --git-path rebase-merge) && ! -e $(git -C "$wt" rev-parse --git-path rebase-apply) ]]; then
      restack_rollback "$wt" "$b" "$old_head"
      echo "sd act: git rebase --continue failed; rolled back to ${old_head:0:7}" >&2
      return 1
    fi
  done
}

# parent_to_default <branch> <state>: once the branch is on the default branch,
# a sd-parent naming the merged parent only makes every later pass look up a
# dead PR. Rewrite it when the target is the default branch.
parent_to_default() {
  local b=$1 default target
  { read -r default; read -r target; } < <(prc_line 'values sync.default, sync.target' "$2")
  [[ $target == "$default" ]] || return 0
  [[ -n $(git config --get "branch.$b.sd-parent" || true) ]] || return 0
  git config "branch.$b.sd-parent" "$default"
  echo "sd-parent of $b is now $default"
}

# ── retarget ─────────────────────────────────────────────────────────────────

read -r -d '' RETARGET_GATE <<'EOF' || true
values {s: this, why: sj(coalesce(errors, []), "; ")}
| values case
    when nul(s.pr) then {hard: f"no PR for {s.branch}{why != "" ? f": {why}" : ""}"}
    when on(s.pr.state != "OPEN") then {hard: f"PR #{s.pr.number} is {lower(s.pr.state)}"}
    when on(s.parent.name == s.sync.default) and on(s.pr.base == s.sync.default)
      then {done: f"PR #{s.pr.number} already targets {s.sync.default}"}
    when on(s.parent.pr.state == "CLOSED")
      then {hard: f"{s.parent.name}'s PR #{s.parent.pr.number} was closed without merging; decide what {s.branch} targets"}
    when nul(s.parent.merged) then {hard: f"can't tell whether {s.parent.name} merged: {why}"}
    when on(s.parent.merged == false) then {hard: f"{s.parent.name} hasn't merged; PR #{s.pr.number} stays on it"}
    when on(s.pr.base == s.sync.default) then {done: f"PR #{s.pr.number} already targets {s.sync.default} (GitHub retargeted it)"}
    else {edit: f"{s.pr.number}"} end
EOF

retarget() {
  local b=$branch state gate line default number
  state=$(sd-state --json "$b") || die "sd state failed"
  gate=$(prc_json "$RETARGET_GATE" "$state") || die "can't parse sd state's answer"
  line=$(gate_get "$gate" hard)
  [[ -z $line ]] || die "$line"
  default=$(prc_val "$state" sync.default)
  line=$(gate_get "$gate" done)
  if [[ -n $line ]]; then
    echo "$line"
  else
    number=$(gate_get "$gate" edit)
    gh pr edit "$number" --base "$default" >/dev/null || die "gh pr edit --base $default failed for PR #$number"
    echo "PR #$number now targets $default (was $(prc_val "$state" pr.base))"
  fi
  parent_to_default "$b" "$state"
}

# ── ack ──────────────────────────────────────────────────────────────────────

# One line per picked item: id|why it can't be acked (empty if it can)|what it is.
read -r -d '' ACK_Q <<'EOF' || true
unnest {ids, it: s.threads.items}
| where (len(ids) == 0 and it.mark == "i") or it.id in ids
| values f"{it.id}|{it.type == "thread" ? "is a thread; resolve it on GitHub"
                    : it.kind != "bot" ? f"is a human {it.type}; reply to it" : ""}|{it.type}  {coalesce(it.author, it.last, "")}  {coalesce(it.excerpt, "")}  {coalesce(it.url, "")}"
EOF

ack() {
  local b=$branch state check out id why what ids_json="" sep=""
  local -a picked=() shown=() bad=()
  local -A found=()
  state=$(sd-state --json "$b") || die "sd state failed"
  check=$(prc_line 'values nul(threads.owed_bot) ? f"can'"'"'t read the PR from GitHub: {sj(coalesce(errors, []), "; ")}" : "ok"' "$state") \
    || die "can't parse sd state's answer"
  [[ $check == ok ]] || die "$check"
  for id in "${ids[@]}"; do ids_json+=$sep$(prc_json_string "$id") || exit 1; sep=,; done
  out=$(prc_line "$ACK_Q" "{\"ids\": [$ids_json], \"s\": $state}") \
    || die "can't parse sd state's answer"
  while IFS='|' read -r id why what; do
    [[ -n $id ]] || continue
    found[$id]=1
    if [[ -n $why ]]; then bad+=("$id $why"); else picked+=("$id"); shown+=("$what"); fi
  done <<<"$out"
  for id in "${ids[@]}"; do [[ -n ${found[$id]:-} ]] || bad+=("$id isn't owed on $b"); done
  if (( ${#bad[@]} )); then printf 'sd act: %s\n' "${bad[@]}" >&2; exit 1; fi
  if (( ! ${#picked[@]} )); then echo "nothing to ack on $b"; return; fi
  for id in "${picked[@]}"; do git config --add "branch.$b.sd-handled" "$id"; done
  echo "acked ${#picked[@]} on $b:"
  printf '  %s\n' "${shown[@]}"
}

# record_lineage <branch> [<state>]: while the PR's base still names a stacked parent, store
# it and the base pin; GitHub retargets the PR to the default branch on merge.
# With no PR (gh answering) and no recorded parent, the branch it was made from
# by a plain git branch, found by stacked_on. Exit 1 when git finds candidates
# but can't pick one (a tie, or a parent that moved on), having said so.
# <state> is the caller's sd state --json, so a second gh lookup can't disagree.
record_lineage() {
  local b=$1 state=${2:-} parent old_base def remote out rc=0
  [[ -n $state ]] || state=$(sd-state --json "$b" 2>/dev/null) || return 0
  read -r parent old_base < <(prc_line '
    where coalesce(parent.source == "pr" and parent.name != sync.default, false)
    | values f"{parent.name} {coalesce(sync.old_base, "")}"' "$state") || true
  if [[ -z ${parent:-} ]]; then
    # No PR and no recorded parent: maybe a plain git branch from another's tip (#94).
    # threads.owed_bot is null when gh failed: then a PR may name the parent.
    def=$(prc_line 'where pr is null and parent.source == "default" and threads.owed_bot is not null
      | values sync.default' "$state") || def=
    [[ -n $def ]] || return 0
    remote=$(prc_get settings.remote "$b" false) || return 0
    out=$(stacked_on "$b" "$remote" "$def") || rc=$?
    case $rc in
      0) read -r parent old_base <<<"$out" ;;
      2) echo "sd act: $b looks stacked on ${out// / or }: record one with git config branch.$b.sd-parent <name>" >&2
         return 1 ;;
      3) echo "sd act: $b $(stacked_unclear "$b" "$out" "$def")" >&2
         return 1 ;;
      *) return 0 ;;
    esac
  fi
  git config "branch.$b.sd-parent" "$parent"
  echo "parent: $parent"
  if [[ -n $old_base ]]; then
    git update-ref "refs/sheepdog/$b/base" "$old_base"
    echo "base pinned at ${old_base:0:7}"
  else
    local why; why=$(no_base_why "$b" "$state")
    echo "sd act: warning: no usable base for $b${why:+: $why}" >&2
  fi
}

# enroll_mark <branch>: mark it for sd watch and register this repo.
enroll_mark() {
  local b=$1 main
  git rev-parse -q --verify "refs/heads/$b" >/dev/null || die "no such branch: $b"
  git config "branch.$b.sheepdog" true
  main=$(main_worktree)
  if ! grep -qxF "$main" <<<"$(git config --global --get-all sheepdog.repo || true)"; then
    git config --global --add sheepdog.repo "$main"
  fi
  echo "enrolled $b"
}

enroll_branch() {
  enroll_mark "$1"
  record_lineage "$1" || true
}

lock_sweep "$branch"
case $verb in
  enroll) enroll_branch "$branch" ;;
  unenroll)
    git config --unset "branch.$branch.sheepdog" || (( $? == 5 ))  # 5: wasn't set
    ;;
  forget)
    git config --unset "branch.$branch.sheepdog" || (( $? == 5 ))
    git for-each-ref --format='delete %(refname)' "refs/sheepdog/$branch/" | git update-ref --stdin
    echo "forgot $branch"
    ;;
  unregister)
    path=${positional:-$(main_worktree)}
    if ! $force && [[ -d $path ]]; then
      mapfile -t enrolled < <(git -C "$path" config --get-regexp '^branch\..*\.sheepdog$' 2>/dev/null \
        | awk '$2 == "true" { sub(/^branch\./, "", $1); sub(/\.sheepdog$/, "", $1); print $1 }')
      (( ${#enrolled[@]} == 0 )) \
        || die "not unregistering $path: still enrolled: ${enrolled[*]} (sd act unenroll them, or --force)"
    fi
    git config --global --unset-all sheepdog.repo "^$(sed 's/[][\\.*^$]/\\&/g' <<<"$path")\$" || (( $? == 5 ))
    echo "unregistered $path"
    ;;
  start) start ;;
  implement) implement ;;
  address) address ;;
  ack) ack ;;
  restack) restack ;;
  retarget) retarget ;;
  push) push ;;
  verify) verify ;;
  autofix) autofix ;;
  ci-fix) ci_fix ;;
  review) review ;;
  describe) describe ;;
  ship) ship ;;
  trigger) trigger ;;
  attach) attach ;;
  *) die "unknown verb: $verb" ;;
esac
